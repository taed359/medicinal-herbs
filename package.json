{
  "name": "medicinal-herbs",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "db:generate": "drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "tsx src/server/db/migrate.ts",
    "db:seed": "tsx src/server/seed/seed-natural-oils.ts",
    "db:seed:wholesale-category": "tsx src/server/seed/seed-wholesale-category.ts",
    "db:seed:coconut-oil-content": "tsx src/server/seed/seed-coconut-oil-content.ts",
    "db:seed:natural-oils-content": "tsx src/server/seed/seed-natural-oils-content.ts",
    "db:seed:wholesale-products": "tsx src/server/seed/seed-wholesale-products.ts",
    "db:seed:wholesale-products-specialty": "tsx src/server/seed/seed-wholesale-products-specialty.ts",
    "db:fix:milk-oil-zh-names": "tsx src/server/seed/fix-milk-oil-zh-names.ts",
    "seed:admin": "tsx scripts/seed-admin.ts",
    "postbuild": "pagefind --site .vercel/output/static"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^11.0.10",
    "@node-rs/argon2": "2.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.3.2",
    "better-auth": "1.7.2",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.16.3",
    "sharp": "^0.35.3",
    "swiper": "^14.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.5",
    "pagefind": "^1.3.0",
    "tsx": "^4.19.2"
  }
}
