---
import HomePage from '../../components/HomePage.astro';
import { productRepository } from '../../server/repositories';

// All database access happens here, at build time, in page frontmatter —
// HomePage.astro and NaturalOils.astro only ever receive plain props.
const naturalOils = await productRepository.listFeatured(4, 'vi');
---
<HomePage lang="vi" naturalOils={naturalOils} />
