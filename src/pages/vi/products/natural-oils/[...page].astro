---
import type { GetStaticPaths } from 'astro';
import Layout from '../../../../layouts/Layout.astro';
import HerbProductCard from '../../../../components/HerbProductCard.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import Pager from '../../../../components/Pager.astro';
import ProductToolbar from '../../../../components/ProductToolbar.astro';
import CategoryFilterList from '../../../../components/CategoryFilterList.astro';
import ExtractionMethodFilter from '../../../../components/ExtractionMethodFilter.astro';
import PriceRangeFilter from '../../../../components/PriceRangeFilter.astro';
import ProductFilterScript from '../../../../components/ProductFilterScript.astro';
import { productRepository, categoryRepository } from '../../../../server/repositories';
import { sortProductSummaries, sortRouteSlug, type SortDir, type SortKey } from '../../../../lib/product-sort';
import { getTranslations, localePath, type Locale } from '../../../../i18n/utils';
import { naturalOilsPlaceholderImage } from '../../../../lib/product-image-fallback';

const lang = 'vi' as const;

export const getStaticPaths = (async ({ paginate }) => {
  // Every sort key/direction this category offers -- natural-oils has a real price on every product;
  // see product-sort.ts's own doc comment for why omitting it here
  // (rather than showing a Price sort that would silently do nothing)
  // is correct. Declared INSIDE getStaticPaths, not as an outer
  // module-level const, after a real dev-server `ReferenceError:
  // SORT_KEYS is not defined` (reported by the user, from
  // astro/dist/core/routing/dev.js -- astro's dev-mode
  // `getStaticPaths` invocation apparently doesn't reliably close over
  // module top-level consts declared above it) -- keeping it self-
  // contained inside the function sidesteps that entirely, whatever
  // its exact cause.
  const SORT_KEYS: SortKey[] = ['position', 'name', 'price'];
  const SORT_DIRS: SortDir[] = ['asc', 'desc'];

  const items = await productRepository.listByCategory('natural-oils', 'vi');

  return SORT_KEYS.flatMap((sortKey) =>
    SORT_DIRS.flatMap((sortDir) => {
      const sorted = sortProductSummaries(items, sortKey, sortDir, 'vi');
      // `null` for the default (position, ascending) combo -- see
      // sortRouteSlug()'s own doc comment for why that one keeps the
      // existing bare URL instead of gaining a `/sort/...` segment.
      const slug = sortKey === 'position' && sortDir === 'asc' ? null : `sort/${sortKey}-${sortDir}`;

      // pageSize 24: comfortably covers this category's full catalog
      // (19 natural-oils / 15 wholesale products today) so it always
      // renders as a single static page. Required for the extraction-
      // method filter below to work correctly -- it's pure client-side
      // show/hide over the cards already in the DOM (same static-site
      // constraint as the Sort control above), so if the category ever
      // spanned multiple pages the filter would silently miss items on
      // other pages. Bump this again if the catalog grows past ~24.
      return paginate(sorted, { pageSize: 24 }).map((entry) => {
        // Astro's own page-number segment for this entry: undefined on
        // page 1, '2' / '3' / ... afterwards -- a rest param (`[...page]`)
        // accepts a multi-segment string, so prefixing it with the sort
        // slug produces routes like `sort/name-asc` (page 1) and
        // `sort/name-asc/2` (page 2) without any other routing change.
        const pageParam = entry.params.page;
        const page = slug ? (pageParam ? `${slug}/${pageParam}` : slug) : pageParam;
        return {
          ...entry,
          params: { page },
          props: { ...entry.props, sortKey, sortDir },
        };
      });
    })
  );
}) satisfies GetStaticPaths;

const { page, sortKey, sortDir } = Astro.props;
const t = getTranslations(lang);

// Mirrors NaturalOils.astro's own formatPrice + products mapping exactly
// -- ProductSummaryView already carries primaryImage/priceMinor/
// compareAtMinor/currency/variantId (see that type's own doc comment:
// "for a listing card that wants to add straight to cart... see
// NaturalOils.astro"), but this paginated listing never used any of it
// until now -- it rendered a bare link-only ProductCard with no price
// and no cart button at all.
function formatPrice(minorUnits: number, currency: string, locale: Locale): string {
  return new Intl.NumberFormat(locale === 'zh' ? 'zh-CN' : 'vi-VN', {
    style: 'currency',
    currency,
    maximumFractionDigits: 0,
  }).format(minorUnits);
}

const categoryLabel = t.naturalOils.eyebrow;
const basePath = localePath(lang, t.naturalOils.collectionPath);

// Category switcher sidebar (see CategoryFilterList.astro) -- every
// published category with its own product count, same real data this
// page's own product grid is built from (listPublishedWithCounts uses
// the identical `products.isPublished = true` predicate as
// productRepository.listByCategory above).
const categoriesWithCounts = await categoryRepository.listPublishedWithCounts(lang);

// The Pager below must link between pages of the SAME active sort,
// not reset back to the default (position, ascending) listing --
// see Pager.astro's own doc comment for why it can't rely on
// Astro's own `page.url.prev`/`page.url.next` for this (they're
// computed by `paginate()` before the sort slug gets folded onto
// the route's `page` param above, in `getStaticPaths`, so they'd
// silently point at the unsorted page instead). `basePath` itself
// stays the plain, sort-less category path -- `ProductToolbar`
// still needs that one, to link to the OTHER sort options, each
// starting fresh at page 1.
//
// `basePath` comes from `localePath()` (Astro's `getRelativeLocaleUrl`),
// which under this project's `trailingSlash: 'ignore'` config already
// returns a path WITH a trailing slash (e.g. "/vi/products/natural-oils/"
// -- see Pager.astro's own doc comment, which notes the same thing for
// its `basePath` prop). Stripping that trailing slash FIRST is required
// here -- appending `/${activeSortSlug}` straight onto `basePath` without
// stripping it first produces a doubled slash
// ("natural-oils//sort/position-desc") that then survives all the way
// through to Pager's own numbered/prev/next links, since Pager's own
// `cleanBasePath` only strips a TRAILING slash, never an internal one.
const activeSortSlug = sortRouteSlug(sortKey, sortDir);
const pagerBasePath = activeSortSlug
  ? `${basePath.replace(/\/+$/, '')}/${activeSortSlug}`
  : basePath;
const products = page.data.map((p) => ({
  ...p,
  formattedPrice: p.priceMinor != null ? formatPrice(p.priceMinor, p.currency ?? 'VND', lang) : undefined,
  href: localePath(lang, `${t.naturalOils.collectionPath}/${p.slug}`),
  canAddToCart: p.priceMinor != null && p.variantId != null,
}));
---
<Layout lang={lang} title={`${t.naturalOils.eyebrow} — ${t.common.siteName}`}>
  <section class="py-8 sm:py-10" aria-labelledby="collection-heading">
    <div class="container-page">
      <Breadcrumbs
        lang={lang}
        class="mb-5 sm:mb-6"
        items={[
          { label: t.productDetail.breadcrumbHome, href: localePath(lang, '') },
          { label: t.naturalOils.eyebrow, current: true },
        ]}
      />
      <div class="text-center mb-7 sm:mb-9">
        <p class="no-eyebrow m-0 mb-1">{t.naturalOils.eyebrow}</p>
        <h2 id="collection-heading" class="no-heading m-0">{t.naturalOils.heading}</h2>
      </div>

      <div class="pl-layout lg:grid lg:grid-cols-[240px_1fr] lg:items-start lg:gap-x-8">
        {/* Two grid items, sidebar then content, placed by plain DOM
            order (first child -> column 1, second -> column 2) -- no
            explicit row/column needed since there's nothing else in this
            grid to mis-place. Deliberately NOT the same flat "every item
            gets its own explicit row/column" layout used earlier: with
            Toolbar/grid/empty-state/Pager each as their own direct grid
            item sharing row 2/3 with the sidebar, CSS Grid sizes each ROW
            to its TALLEST item across both columns -- so filtering the
            product grid down to a handful of cards left row 2 as tall as
            the (unfiltered-height) sidebar, and Pager sat below that
            leftover blank space instead of right under the last visible
            card (reported directly by the user, screenshot showed the
            gap). Grouping Toolbar+grid+empty-state+Pager into their own
            `.pl-content` column below fixes this: that column's own
            height now depends only on ITS OWN (possibly filtered)
            content, completely independent of the sidebar's height. */}
        <div class="pl-sidebar mb-6 lg:mb-0">
          <CategoryFilterList lang={lang} categories={categoriesWithCounts} activeCategoryId="natural-oils" />
          <ExtractionMethodFilter lang={lang} extractionMethods={products.map((p) => p.extractionMethod)} />
          <PriceRangeFilter lang={lang} prices={products.map((p) => p.priceMinor)} currency={products[0]?.currency ?? 'VND'} />
        </div>

        <div class="pl-content">
        <ProductToolbar
          sortKey={sortKey}
          sortDir={sortDir}
          basePath={basePath}
          categoryId="natural-oils"
          currentPage={page.currentPage}
          showPriceSort={true}
          viewGridLabel={t.toolbar.viewGridLabel}
          viewListLabel={t.toolbar.viewListLabel}
          sortByLabel={t.toolbar.sortByLabel}
          sortPositionLabel={t.toolbar.sortPositionLabel}
          sortNameLabel={t.toolbar.sortNameLabel}
          sortPriceLabel={t.toolbar.sortPriceLabel}
          sortDirectionAscLabel={t.toolbar.sortDirectionAscLabel}
          sortDirectionDescLabel={t.toolbar.sortDirectionDescLabel}
        />

        <ul
          class="no-track m-0 flex list-none gap-4 overflow-x-auto p-0 sm:grid sm:grid-cols-2 sm:overflow-visible lg:grid-cols-3"
          role="list"
          tabindex="0"
          data-product-view="grid"
        >
          {products.map((p) => {
            const isPlaceholder = !p.primaryImage;
            const image = p.primaryImage?.url ?? naturalOilsPlaceholderImage.src;
            const alt = p.primaryImage?.alt || p.name;
            return (
              <li class="no-slide h-full" data-extraction-method={p.extractionMethod ?? ''} data-price-minor={p.priceMinor ?? ''}>
                <HerbProductCard
                  lang={lang}
                  name={p.name}
                  categoryLabel={categoryLabel}
                  href={p.href}
                  image={image}
                  alt={alt}
                  isPlaceholder={isPlaceholder}
                  formattedPrice={p.formattedPrice}
                  variantId={p.variantId}
                  canAddToCart={p.canAddToCart}
                />
              </li>
            );
          })}
        </ul>

        <p class="pl-empty-state" data-pl-empty-state role="status" aria-live="polite" hidden>
          {t.extractionFilter.emptyState}
        </p>

        <Pager
          page={page}
          basePath={pagerBasePath}
          prevLabel={t.pager.prevLabel}
          nextLabel={t.pager.nextLabel}
          pageLabel={t.pager.pageLabel}
          itemsRangeLabel={t.pager.itemsRangeLabel}
        />
        </div>
      </div>
    </div>
  </section>
</Layout>

<ProductFilterScript />

<style>
  /* Grid item default `min-width: auto` can let a track sized `1fr`
     blow out to fit an intrinsically-wide descendant -- `.no-track`'s
     `overflow-x-auto` horizontal scroller is exactly that kind of
     content. Explicit `min-width: 0` keeps `.pl-content` shrinkable to
     its grid track instead. */
  .pl-content { min-width: 0; }

  /* Sticky filter sidebar, desktop only: `.pl-sidebar` and `.pl-content`
     are the only two items in `.pl-layout`'s single grid row, so the
     row's own height already equals the taller of the two (almost
     always `.pl-content`, once there are more than a couple of product
     cards) -- CSS Grid gives `.pl-sidebar` that same taller row height
     as its own grid-area to move within, so `position: sticky` here
     scrolls it right along with the page and pins it once its top edge
     reaches `top: 7rem`, then releases it again as `.pl-content`'s
     bottom approaches -- no JS, and it can never escape past the
     bottom of the product list/pager since it's bounded by its own
     grid area. Deliberately NOT `position: fixed`, which would ignore
     `.pl-content`'s height entirely and stay pinned even past the end
     of the page (e.g. over the footer). `top: 7rem` matches the same
     sticky-under-Header offset already used by TrustCertifications.astro's
     `.tc-intro` and ProductDetail.astro's `.pd-gallery`, clearing the
     84px/5.25rem sticky Header (Header.astro) plus breathing room. */
  @media (min-width: 1024px) {
    .pl-sidebar {
      position: sticky;
      top: 7rem;
    }
  }

  /* Products only: mobile horizontal scroll, grid from sm+ (2 cols),
     3 cols on lg -- same .no-track/.no-slide pattern as NaturalOils.astro's
     homepage rail, so this paginated listing feels like the same product
     row rather than a visually different grid. Capped at 3 (not 4) on lg
     now that the CategoryFilterList sidebar takes a 240px column out of
     the row -- 4 columns in the remaining `1fr` would squeeze each card
     narrower than HerbProductCard's own comfortable minimum. */
  .no-track { scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch; scrollbar-width: none; }
  .no-track::-webkit-scrollbar { display: none; }
  .no-slide { flex: 0 0 82%; scroll-snap-align: start; }
  @media (min-width: 480px) { .no-slide { flex-basis: 68%; } }
  @media (min-width: 640px) {
    .no-track { gap: 1.375rem; }
    .no-slide { flex: unset; scroll-snap-align: unset; }
  }

  /* Shown by ExtractionMethodFilter.astro's script in place of the
     grid when the selected filter matches zero of this category's
     products; occupies the same grid cell as the (now-empty) `<ul>`
     so it reads as "grid contents" rather than pushing the Pager up. */
  .pl-empty-state { padding-block: 2.5rem 1rem; text-align: center; color: var(--color-body); font-size: 0.9375rem; }

  .no-eyebrow { color: var(--color-brand); font-size: 1.25rem; font-weight: 600; letter-spacing: 0.02em; }
  @media (min-width: 640px) { .no-eyebrow { font-size: 1.375rem; } }
  .no-heading { color: var(--color-heading); font-size: 1.75rem; font-weight: 700; line-height: 1.15; }
  @media (min-width: 640px) { .no-heading { font-size: 2.25rem; } }

  /* "List" view mode (toggled client-side by ProductToolbar, see its own
     doc comment) -- single vertical column at every breakpoint, no
     horizontal scroll. HerbProductCard.astro carries the matching
     per-card layout override (image-left/details-right row) scoped to
     this same [data-product-view='list'] ancestor attribute. */
  .no-track[data-product-view='list'] {
    display: flex !important;
    flex-direction: column !important;
    overflow-x: visible !important;
    scroll-snap-type: none !important;
  }
  .no-track[data-product-view='list'] .no-slide {
    flex: unset !important;
    scroll-snap-align: unset !important;
  }
</style>
