---
import Layout from '../../../../layouts/Layout.astro';
import ProductCard from '../../../../components/ProductCard.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import { productRepository } from '../../../../server/repositories';
import { getTranslations, localePath } from '../../../../i18n/utils';
import { naturalOilsPlaceholderImage } from '../../../../lib/product-image-fallback';

const lang = 'vi' as const;
const t = getTranslations(lang);
const items = await productRepository.listByCategory('natural-oils', lang);
---
<Layout lang={lang} title={`${t.naturalOils.eyebrow} — ${t.common.siteName}`}>
  <section class="py-8 sm:py-10" aria-labelledby="collection-heading">
    <div class="container-page">
      <Breadcrumbs
        lang={lang}
        class="mb-5 sm:mb-6"
        items={[
          { label: t.productDetail.breadcrumbHome, href: localePath(lang, '') },
          { label: t.naturalOils.eyebrow, current: true },
        ]}
      />
      <div class="text-center mb-7 sm:mb-9">
        <p class="no-eyebrow m-0 mb-1">{t.naturalOils.eyebrow}</p>
        <h2 id="collection-heading" class="no-heading m-0">{t.naturalOils.heading}</h2>
      </div>

      <ul class="m-0 grid list-none grid-cols-2 gap-4 p-0 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 sm:gap-5 lg:gap-6">
        {items.map((p) => {
          const href = localePath(lang, `${t.naturalOils.collectionPath}/${p.slug}`);
          const image = p.primaryImage?.url ?? naturalOilsPlaceholderImage.src;
          const alt = p.primaryImage?.alt || p.name;
          return (
            <li>
              <ProductCard name={p.name} href={href} cta={t.product.ctaViewDetails} image={image} alt={alt} />
            </li>
          );
        })}
      </ul>
    </div>
  </section>
</Layout>

<style>
  .no-eyebrow { color: var(--color-brand); font-size: 1.25rem; font-weight: 600; letter-spacing: 0.02em; }
  @media (min-width: 640px) { .no-eyebrow { font-size: 1.375rem; } }
  .no-heading { color: var(--color-heading); font-size: 1.75rem; font-weight: 700; line-height: 1.15; }
  @media (min-width: 640px) { .no-heading { font-size: 2.25rem; } }
</style>
