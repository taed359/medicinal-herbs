---
// Minimal server-rendered login form. Left un-namespaced (not under
// /vi or /zh) — the admin area is not part of the localized storefront.
export const prerender = false;

import { auth } from '../../server/auth/auth';

// If there's already a valid session, there's nothing to do here —
// send the operator straight to the shell instead of showing the form.
const existingSession = await auth.api.getSession({ headers: Astro.request.headers });
if (existingSession) {
  return Astro.redirect('/admin');
}
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Admin sign in — Medicinal Herbs</title>
    <meta name="robots" content="noindex, nofollow" />
    <link rel="stylesheet" href="/admin.css" />
  </head>
  <body>
    <main class="login-shell">
      <div class="login-card">
        <div class="login-brand">
          <span class="login-brand-mark" aria-hidden="true">MH</span>
          <span class="login-brand-text">Medicinal Herbs</span>
        </div>
        <form id="login-form" class="login-form" novalidate>
          <h1>Admin sign in</h1>
          <p class="login-subtitle">Sign in to manage products and orders.</p>
          <p id="login-error" class="login-error" role="alert" hidden></p>

          <label for="email">Email</label>
          <input id="email" name="email" type="email" autocomplete="username" required />

          <label for="password">Password</label>
          <input id="password" name="password" type="password" autocomplete="current-password" required />

          <button type="submit" class="admin-btn admin-btn-primary login-submit">Sign in</button>
        </form>
      </div>
    </main>

    <style>
      /* Astro does not scope `body`/`html` selectors in a component's
         <style> block (they sit outside the component's own render root),
         so anything set directly on `body` here is genuinely GLOBAL CSS —
         not isolated to this page. Keep only a harmless, idempotent reset
         on `body` (margin/font — matches what the storefront's own
         global.css already sets) and put every layout-affecting rule
         (display:grid, place-items, min-height, background) on the
         page's own `.login-shell` wrapper instead, which Astro DOES scope
         via a `[data-astro-cid-*]` attribute. This isn't just cleanliness:
         Astro's dev server has a known quirk on hybrid (static + on-demand)
         projects where a page's <style> block can end up injected into an
         unrelated page's dev-mode HTML (harmless in the real `astro build`
         output — confirmed empty via grep — but ugly locally). An unscoped
         `body { display: grid }` from this page previously broke the
         storefront header's layout in dev when that happened; a scoped
         `.login-shell` rule simply won't match anything on another page. */
      body {
        margin: 0;
        font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      }
      .login-shell {
        display: grid;
        place-items: center;
        min-height: 100vh;
        padding: 1.5rem;
        background: var(--admin-bg, #faf8f4);
        background-image: radial-gradient(circle at 15% 15%, rgba(139, 30, 46, 0.06), transparent 45%),
          radial-gradient(circle at 85% 85%, rgba(201, 161, 90, 0.08), transparent 45%);
      }
      .login-card {
        width: min(24rem, 100%);
        padding: 2.25rem 2rem 2rem;
        background: var(--admin-surface, #fff);
        border: 1px solid var(--admin-border, #e8e3d9);
        border-radius: var(--admin-radius-lg, 14px);
        box-shadow: var(--admin-shadow-lg, 0 20px 45px -12px rgba(34, 20, 17, 0.28));
      }
      .login-brand {
        display: flex;
        align-items: center;
        gap: 0.65rem;
        margin-bottom: 1.5rem;
      }
      .login-brand-mark {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 2.4rem;
        height: 2.4rem;
        border-radius: 9px;
        background: var(--admin-brand, #8b1e2e);
        color: #fff;
        font-weight: 700;
        font-size: 0.85rem;
        letter-spacing: 0.02em;
      }
      .login-brand-text {
        font-weight: 700;
        font-size: 0.95rem;
        color: var(--admin-text, #221c1a);
      }
      .login-form {
        display: grid;
        gap: 0.75rem;
      }
      .login-form h1 {
        margin: 0;
        font-size: 1.3rem;
        font-weight: 700;
        letter-spacing: -0.01em;
        color: var(--admin-text, #221c1a);
      }
      .login-subtitle {
        margin: 0 0 0.25rem;
        font-size: 0.85rem;
        color: var(--admin-text-muted, #6d6459);
      }
      .login-form label {
        font-size: 0.82rem;
        font-weight: 600;
        color: #34302c;
      }
      .login-form input {
        padding: 0.6rem 0.7rem;
        border: 1px solid var(--admin-border-strong, #d7d0c2);
        border-radius: var(--admin-radius-sm, 7px);
        font-size: 1rem;
        font: inherit;
        transition: border-color 0.14s ease, box-shadow 0.14s ease;
      }
      .login-form input:focus {
        border-color: var(--admin-brand, #8b1e2e);
        box-shadow: 0 0 0 3px var(--admin-brand-soft, #f7e8ea);
        outline: none;
      }
      .login-submit {
        margin-top: 0.5rem;
        width: 100%;
      }
      .login-error {
        margin: 0;
        padding: 0.6rem 0.75rem;
        border-radius: var(--admin-radius-sm, 7px);
        background: var(--admin-danger-soft, #fbeae8);
        color: var(--admin-danger, #b3261e);
        font-size: 0.85rem;
      }
    </style>

    <script>
      // Calls Better Auth's own REST endpoint directly (no framework
      // client SDK needed — Better Auth is plain HTTP under the hood).
      // The session cookie Better Auth sets on success is same-origin,
      // so a plain same-origin fetch already carries/receives it.
      const form = document.querySelector('#login-form');
      const errorEl = document.querySelector('#login-error');
      const emailInput = document.querySelector('#email');
      const passwordInput = document.querySelector('#password');
      const submitButton = document.querySelector('#login-form button[type="submit"]');

      if (
        form instanceof HTMLFormElement &&
        errorEl instanceof HTMLElement &&
        emailInput instanceof HTMLInputElement &&
        passwordInput instanceof HTMLInputElement &&
        submitButton instanceof HTMLButtonElement
      ) {
        form.addEventListener('submit', async (event) => {
          event.preventDefault();
          errorEl.hidden = true;
          submitButton.disabled = true;

          const email = emailInput.value;
          const password = passwordInput.value;

          try {
            const res = await fetch('/api/auth/sign-in/email', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ email, password }),
            });

            if (res.ok) {
              window.location.href = '/admin';
              return;
            }

            const body = await res.json().catch(() => null);
            errorEl.textContent = body?.message || 'Invalid email or password.';
            errorEl.hidden = false;
          } catch {
            errorEl.textContent = 'Something went wrong. Please try again.';
            errorEl.hidden = false;
          } finally {
            submitButton.disabled = false;
          }
        });
      }
    </script>
  </body>
</html>
