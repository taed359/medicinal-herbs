---
import Layout from '../../../../layouts/Layout.astro';
import ProductDetail from '../../../../components/ProductDetail.astro';
import { productRepository, categoryRepository } from '../../../../server/repositories';
import { getTranslations } from '../../../../i18n/utils';

const lang = 'zh' as const;

// Scoped to this category's own products -- NOT productRepository's
// site-wide listAllSlugs(), which would generate every product's detail
// page under every category's URL prefix. Each category's own
// [slug].astro folder owns exactly its own products' slugs.
export async function getStaticPaths() {
  const items = await productRepository.listByCategory('wholesale', 'zh');
  return items.map((item) => ({ params: { slug: item.slug } }));
}

const { slug } = Astro.params;
const product = await productRepository.getBySlug(slug!, lang);
if (!product) throw new Error('Not found');

// category id and slug are the same value by convention (see
// seed-natural-oils.ts / seed-wholesale-category.ts) -- getBySlug is the
// repository method that exists today, so it doubles as the by-id lookup.
const category = await categoryRepository.getBySlug(product.categoryId, lang);
if (!category) throw new Error('Not found');

const t = getTranslations(lang);
const title = `${product.name} — ${t.common.siteName}`;
// Product-specific meta description once real short_description content
// exists; Layout.astro falls back to the generic site-wide description
// when a product has none yet.
const description = product.shortDescription ?? undefined;

// Related products: other published items in the same category, real
// data only -- excludes the current product and caps at 4.
const relatedProducts = (await productRepository.listByCategory(product.categoryId, lang))
  .filter((p) => p.id !== product.id)
  .slice(0, 4);
---
<Layout lang={lang} title={title} description={description}>
  <ProductDetail lang={lang} product={product} category={category} relatedProducts={relatedProducts} />
</Layout>
