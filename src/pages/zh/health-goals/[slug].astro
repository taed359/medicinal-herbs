---
import type { GetStaticPaths } from 'astro';
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import Layout from '../../../layouts/Layout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import { getTranslations, localePath } from '../../../i18n/utils';
import { HEALTH_GOALS, type HealthGoalKey } from '../../../lib/health-goals';

const lang = 'zh' as const;

// Exactly 9 known goals (src/lib/health-goals.ts) -- a plain map, not a
// repository call, since these are editorial landing pages with no DB
// row of their own (see the file-level note on `HealthGoals.astro`'s old
// "no health-goal-based product filtering exists" comment -- still true
// today, hence the CTA section below pointing at the two real product
// categories rather than a goal-filtered grid that doesn't exist yet).
export const getStaticPaths = (() => {
  return HEALTH_GOALS.map((goal) => ({
    params: { slug: goal.slug },
    props: { goalKey: goal.key, image: goal.image },
  }));
}) satisfies GetStaticPaths;

interface Props {
  goalKey: HealthGoalKey;
  image: ImageMetadata;
}
const { goalKey, image } = Astro.props;

const t = getTranslations(lang);
const label = t.healthGoals.items[goalKey];
const description = t.healthGoals.descriptions[goalKey];
// format: 'svg' passes the file through unchanged rather than trying to
// raster-process it -- same reasoning/pattern as HealthGoals.astro.
const imageSrc = (await getImage({ src: image, format: 'svg' })).src;

const indexHref = localePath(lang, 'health-goals');
const naturalOilsHref = localePath(lang, t.naturalOils.collectionPath);
const wholesaleHref = localePath(lang, t.wholesale.collectionPath);
---
<Layout lang={lang} title={`${label} — ${t.common.siteName}`} description={description}>
  <section class="py-8 sm:py-10" aria-labelledby="hg-heading">
    <div class="container-page">
      <Breadcrumbs
        lang={lang}
        class="mb-6 sm:mb-8"
        items={[
          { label: t.productDetail.breadcrumbHome, href: localePath(lang, '') },
          { label: t.healthGoals.heading, href: indexHref },
          { label, current: true },
        ]}
      />

      <div class="hgp-hero grid grid-cols-1 items-center gap-8 lg:grid-cols-2 lg:gap-14">
        <div class="hgp-image-frame">
          <img src={imageSrc} alt="" loading="eager" decoding="async" class="h-full w-full object-cover" />
        </div>
        <div>
          <p class="eyebrow m-0 mb-2">{t.healthGoals.eyebrow}</p>
          <h1 id="hg-heading" class="hgp-title font-serif m-0">{label}</h1>
          <p class="hgp-description m-0 mt-4">{description}</p>
        </div>
      </div>

      <div class="hgp-cta mt-14 sm:mt-16">
        <h2 class="hgp-cta-heading font-serif m-0">{t.healthGoals.page.ctaHeading}</h2>
        <p class="hgp-cta-body m-0 mt-2">{t.healthGoals.page.ctaBody}</p>
        <div class="hgp-cta-buttons mt-6 flex flex-wrap gap-3">
          <a href={naturalOilsHref} data-astro-reload class="btn btn-primary">{t.healthGoals.page.ctaNaturalOils}</a>
          <a href={wholesaleHref} data-astro-reload class="btn btn-secondary">{t.healthGoals.page.ctaWholesale}</a>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hgp-image-frame {
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-cream);
  }

  .hgp-title {
    color: var(--color-heading);
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.2;
  }
  @media (min-width: 640px) {
    .hgp-title { font-size: 2.5rem; }
  }

  .hgp-description {
    max-width: 42ch;
    color: var(--color-body);
    font-size: 1rem;
    line-height: 1.75;
  }

  .hgp-cta {
    padding-top: 2.5rem;
    border-top: 1px solid var(--color-border);
  }

  .hgp-cta-heading {
    color: var(--color-heading);
    font-size: 1.375rem;
    font-weight: 700;
  }

  .hgp-cta-body {
    max-width: 48ch;
    color: var(--color-body);
    font-size: 0.9375rem;
    line-height: 1.65;
  }

  html[lang='zh'] .hgp-description,
  html[lang='zh'] .hgp-cta-body {
    line-height: 1.85;
  }
</style>
