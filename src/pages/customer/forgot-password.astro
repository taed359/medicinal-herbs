---
export const prerender = false;

import { localePath, getTranslations } from '../../i18n/utils';
import {
  resolveAuthLocale,
  getAuthTranslations,
  buildAuthLangHref,
  authPageHref,
  privacyPolicyHref,
  type AuthLocale,
} from '../../i18n/auth';
import AuthLanguageSwitcher from '../../components/auth/AuthLanguageSwitcher.astro';

const lang = resolveAuthLocale(Astro.url.searchParams);
const t = getAuthTranslations(lang);

const loginHref = authPageHref('login', lang);
const homeHref = localePath(lang, '');
const siteName = getTranslations(lang).common.siteName;
const langHrefs: Record<AuthLocale, string> = {
  vi: buildAuthLangHref(Astro.url, 'vi'),
  zh: buildAuthLangHref(Astro.url, 'zh'),
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={t.forgotPassword.metaDescription} />
    <title>{t.forgotPassword.title}</title>
    <link rel="stylesheet" href="/customer.css" />
  </head>
  <body>
    <div class="auth-shell">
      <section class="auth-form-panel">
        <AuthLanguageSwitcher lang={lang} label={t.common.languageSwitcherLabel} hrefs={langHrefs} />

        <div class="auth-logo-area">
          <a href={homeHref} class="auth-logo" aria-label={t.common.logoAriaLabel}>{siteName}</a>
        </div>

        <main class="auth-form-content">
        <div class="auth-content">
          <h1 class="auth-heading">{t.forgotPassword.heading}</h1>
          <p class="auth-subtitle">{t.forgotPassword.subtitle}</p>

          <p id="forgot-error" class="auth-error" role="alert" hidden></p>
          <p id="forgot-success" class="auth-success" role="status" hidden></p>

          <form id="forgot-form" class="auth-form" novalidate>
            <div class="auth-field">
              <label for="email">{t.forgotPassword.emailLabel}</label>
              <input id="email" name="email" type="email" autocomplete="username" required />
            </div>

            <button type="submit" class="auth-submit">{t.forgotPassword.submit}</button>
          </form>

          <p class="auth-bottom-line"><a href={loginHref}>{t.forgotPassword.backToSignIn}</a></p>
        </div>

        <p class="auth-legal"><a href={privacyPolicyHref(lang)}>{t.common.privacyPolicy}</a></p>
        </main>
      </section>

      <aside class="auth-image-panel">
        <img src="/images/customer-auth/Energy.webp" alt="" loading="lazy" />
      </aside>
    </div>

    <script is:inline define:vars={{ common: t.common, forgotPassword: t.forgotPassword }}>
      const form = document.querySelector('#forgot-form');
      const errorEl = document.querySelector('#forgot-error');
      const successEl = document.querySelector('#forgot-success');
      const emailInput = document.querySelector('#email');
      const submitButton = document.querySelector('#forgot-form button[type="submit"]');

      function isValidEmail(value) {
        return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value);
      }

      if (
        form instanceof HTMLFormElement &&
        errorEl instanceof HTMLElement &&
        successEl instanceof HTMLElement &&
        emailInput instanceof HTMLInputElement &&
        submitButton instanceof HTMLButtonElement
      ) {
        const originalLabel = submitButton.textContent;

        function clearMessages() {
          errorEl.hidden = true;
          errorEl.textContent = '';
          successEl.hidden = true;
          successEl.textContent = '';
          emailInput.removeAttribute('aria-invalid');
          emailInput.removeAttribute('aria-describedby');
        }

        function showError(message) {
          successEl.hidden = true;
          errorEl.textContent = message;
          errorEl.hidden = false;
          emailInput.setAttribute('aria-invalid', 'true');
          emailInput.setAttribute('aria-describedby', 'forgot-error');
          emailInput.focus();
        }

        emailInput.addEventListener('input', () => { if (!errorEl.hidden) clearMessages(); });

        form.addEventListener('submit', async (event) => {
          event.preventDefault();
          if (submitButton.disabled) return;
          clearMessages();

          const email = emailInput.value.trim();
          if (!email) {
            showError(common.emailRequired);
            return;
          }
          if (!isValidEmail(email)) {
            showError(common.emailInvalid);
            return;
          }

          submitButton.disabled = true;
          submitButton.textContent = forgotPassword.submitLoading;

          try {
            const res = await fetch('/api/customer-auth/request-password-reset', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ email: emailInput.value }),
            });

            if (res.status === 429) {
              showError(common.rateLimitError);
            } else if (res.status >= 500) {
              // A real outage is safe to surface distinctly -- it says
              // nothing about whether the email exists, unlike every other
              // status below.
              showError(common.serverError);
            } else {
              // Deliberately the SAME message for every other outcome
              // (success, unknown email, validation failure, ...) --
              // request-password-reset must never let a client
              // distinguish "sent" from "no such account".
              successEl.textContent = forgotPassword.successMessage;
              successEl.hidden = false;
            }
          } catch {
            showError(common.genericError);
          } finally {
            submitButton.disabled = false;
            submitButton.textContent = originalLabel;
          }
        });
      }
    </script>
  </body>
</html>
