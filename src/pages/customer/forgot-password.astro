---
export const prerender = false;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content="Reset your Medicinal Herbs account password by email to regain secure access to your account and continue shopping." />
    <title>Forgot password — Medicinal Herbs</title>
    <link rel="stylesheet" href="/customer.css" />
  </head>
  <body>
    <div class="auth-shell">
      <section class="auth-form-panel">
        <div class="auth-logo-area">
          <a href="/" class="auth-logo" aria-label="Medicinal Herbs — back to storefront">Medicinal Herbs</a>
        </div>

        <main class="auth-form-content">
        <div class="auth-content">
          <h1 class="auth-heading">Forgot password?</h1>
          <p class="auth-subtitle">Enter your email and we'll send you a link to reset your password.</p>

          <p id="forgot-error" class="auth-error" role="alert" hidden></p>
          <p id="forgot-success" class="auth-success" role="status" hidden></p>

          <form id="forgot-form" class="auth-form" novalidate>
            <div class="auth-field">
              <label for="email">Email</label>
              <input id="email" name="email" type="email" autocomplete="username" required />
            </div>

            <button type="submit" class="auth-submit">Send reset link</button>
          </form>

          <p class="auth-bottom-line"><a href="/customer/login">Back to sign in</a></p>
        </div>

        <p class="auth-legal"><a href="/privacy-policy/">Privacy policy</a></p>
        </main>
      </section>

      <aside class="auth-image-panel">
        <img src="/images/customer-auth/Energy.webp" alt="" loading="lazy" />
      </aside>
    </div>

    <script>
      const form = document.querySelector('#forgot-form');
      const errorEl = document.querySelector('#forgot-error');
      const successEl = document.querySelector('#forgot-success');
      const emailInput = document.querySelector('#email');
      const submitButton = document.querySelector('#forgot-form button[type="submit"]');

      // Deliberately the SAME message regardless of whether the email
      // exists -- request-password-reset must never let a client
      // distinguish "sent" from "no such account".
      const GENERIC_MESSAGE = "If an account exists for this email, we've sent a password reset link.";

      if (
        form instanceof HTMLFormElement &&
        errorEl instanceof HTMLElement &&
        successEl instanceof HTMLElement &&
        emailInput instanceof HTMLInputElement &&
        submitButton instanceof HTMLButtonElement
      ) {
        const originalLabel = submitButton.textContent;

        form.addEventListener('submit', async (event) => {
          event.preventDefault();
          errorEl.hidden = true;
          successEl.hidden = true;
          submitButton.disabled = true;
          submitButton.textContent = 'Sending…';

          try {
            const res = await fetch('/api/customer-auth/request-password-reset', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ email: emailInput.value }),
            });

            if (res.status === 429) {
              errorEl.textContent = 'Too many attempts. Please try again later.';
              errorEl.hidden = false;
            } else {
              // Any other outcome (including a real failure) shows the
              // same generic message -- see GENERIC_MESSAGE above.
              successEl.textContent = GENERIC_MESSAGE;
              successEl.hidden = false;
            }
          } catch {
            errorEl.textContent = 'Something went wrong. Please try again.';
            errorEl.hidden = false;
          } finally {
            submitButton.disabled = false;
            submitButton.textContent = originalLabel;
          }
        });
      }
    </script>
  </body>
</html>
