---
export const prerender = false;

import { localePath, getTranslations } from '../../i18n/utils';
import {
  resolveAuthLocale,
  getAuthTranslations,
  buildAuthLangHref,
  authPageHref,
  privacyPolicyHref,
  type AuthLocale,
} from '../../i18n/auth';
import AuthLanguageSwitcher from '../../components/auth/AuthLanguageSwitcher.astro';

const token = Astro.url.searchParams.get('token') ?? '';

// This URL carries the reset token in its query string -- suppress the
// Referer header entirely on outbound navigation from this page (the
// "Back to sign in" link, the logo link) so the token can never leak via
// Referer to any destination, present or future, same-origin or not.
Astro.response.headers.set('Referrer-Policy', 'no-referrer');

const lang = resolveAuthLocale(Astro.url.searchParams);
const t = getAuthTranslations(lang);

const loginHref = authPageHref('login', lang);
const homeHref = localePath(lang, '');
const siteName = getTranslations(lang).common.siteName;
const langHrefs: Record<AuthLocale, string> = {
  vi: buildAuthLangHref(Astro.url, 'vi'),
  zh: buildAuthLangHref(Astro.url, 'zh'),
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="description" content={t.resetPassword.metaDescription} />
    <title>{t.resetPassword.title}</title>
    <link rel="stylesheet" href="/customer.css" />
  </head>
  <body>
    <div class="auth-shell">
      <section class="auth-form-panel">
        <AuthLanguageSwitcher lang={lang} label={t.common.languageSwitcherLabel} hrefs={langHrefs} />

        <div class="auth-logo-area">
          <a href={homeHref} class="auth-logo" aria-label={t.common.logoAriaLabel}>{siteName}</a>
        </div>

        <main class="auth-form-content">
        <div class="auth-content">
          <h1 class="auth-heading">{t.resetPassword.heading}</h1>
            <p class="auth-subtitle">{t.resetPassword.subtitle}</p>

            <p id="reset-error" class="auth-error" role="alert" hidden></p>
            <p id="reset-success" class="auth-success" role="status" hidden></p>

            <form id="reset-form" class="auth-form" novalidate>
              <div class="auth-field">
                <label for="newPassword">{t.resetPassword.newPasswordLabel}</label>
                <div class="auth-password-row">
                  <input id="newPassword" name="newPassword" type="password" autocomplete="new-password" minlength="12" required />
                  <button type="button" data-toggle-for="newPassword" class="auth-password-toggle" aria-pressed="false" aria-label={t.common.showPassword}>
                    <svg data-icon-show width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.5" /></svg>
                    <svg data-icon-hide width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 3l18 18M10.6 10.6a3 3 0 0 0 4.2 4.2M6.6 6.7C4.3 8.2 2.7 10.4 2 12c0 0 3.6 7 10 7 1.8 0 3.4-.4 4.7-1.1M9.9 5.2A10.6 10.6 0 0 1 12 5c6.4 0 10 7 10 7-.5.9-1.3 2.1-2.4 3.3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  </button>
                </div>
                <p class="auth-hint">{t.common.passwordHint}</p>
              </div>

              <div class="auth-field">
                <label for="confirmPassword">{t.resetPassword.confirmPasswordLabel}</label>
                <div class="auth-password-row">
                  <input id="confirmPassword" name="confirmPassword" type="password" autocomplete="new-password" minlength="12" required />
                  <button type="button" data-toggle-for="confirmPassword" class="auth-password-toggle" aria-pressed="false" aria-label={t.common.showPassword}>
                    <svg data-icon-show width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7-10-7-10-7Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" /><circle cx="12" cy="12" r="3" stroke="currentColor" stroke-width="1.5" /></svg>
                    <svg data-icon-hide width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M3 3l18 18M10.6 10.6a3 3 0 0 0 4.2 4.2M6.6 6.7C4.3 8.2 2.7 10.4 2 12c0 0 3.6 7 10 7 1.8 0 3.4-.4 4.7-1.1M9.9 5.2A10.6 10.6 0 0 1 12 5c6.4 0 10 7 10 7-.5.9-1.3 2.1-2.4 3.3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                  </button>
                </div>
              </div>

              <button type="submit" class="auth-submit">{t.resetPassword.submit}</button>
            </form>

          <p class="auth-bottom-line"><a href={loginHref}>{t.resetPassword.backToSignIn}</a></p>
        </div>

        <p class="auth-legal"><a href={privacyPolicyHref(lang)}>{t.common.privacyPolicy}</a></p>
        </main>
      </section>

      <aside class="auth-image-panel">
        <img src="/images/customer-auth/Energy.webp" alt="" loading="lazy" />
      </aside>
    </div>

    <script is:inline define:vars={{ token, common: t.common, resetPassword: t.resetPassword }}>
      const form = document.querySelector('#reset-form');
      const errorEl = document.querySelector('#reset-error');
      const successEl = document.querySelector('#reset-success');
      const passwordInput = document.querySelector('#newPassword');
      const confirmPasswordInput = document.querySelector('#confirmPassword');
      const submitButton = document.querySelector('#reset-form button[type="submit"]');

      document.querySelectorAll('[data-toggle-for]').forEach((toggleButton) => {
        const targetId = toggleButton.getAttribute('data-toggle-for');
        const targetInput = targetId ? document.getElementById(targetId) : null;
        if (!(toggleButton instanceof HTMLButtonElement) || !(targetInput instanceof HTMLInputElement)) return;
        toggleButton.addEventListener('click', () => {
          const showing = targetInput.type === 'text';
          targetInput.type = showing ? 'password' : 'text';
          toggleButton.setAttribute('aria-pressed', showing ? 'false' : 'true');
          toggleButton.setAttribute('aria-label', showing ? common.showPassword : common.hidePassword);
        });
      });

      if (
        form instanceof HTMLFormElement &&
        errorEl instanceof HTMLElement &&
        successEl instanceof HTMLElement &&
        passwordInput instanceof HTMLInputElement &&
        confirmPasswordInput instanceof HTMLInputElement &&
        submitButton instanceof HTMLButtonElement
      ) {
        const originalLabel = submitButton.textContent;
        const fields = [passwordInput, confirmPasswordInput];

        function clearMessages() {
          errorEl.hidden = true;
          errorEl.textContent = '';
          successEl.hidden = true;
          successEl.textContent = '';
          fields.forEach((input) => {
            input.removeAttribute('aria-invalid');
            input.removeAttribute('aria-describedby');
          });
        }

        function showError(message, invalidInput) {
          successEl.hidden = true;
          errorEl.textContent = message;
          errorEl.hidden = false;
          fields.forEach((input) => {
            if (input === invalidInput) {
              input.setAttribute('aria-invalid', 'true');
              input.setAttribute('aria-describedby', 'reset-error');
            } else {
              input.removeAttribute('aria-invalid');
              input.removeAttribute('aria-describedby');
            }
          });
          if (invalidInput) invalidInput.focus();
        }

        fields.forEach((input) => {
          input.addEventListener('input', () => { if (!errorEl.hidden) clearMessages(); });
        });

        if (!token) {
          showError(resetPassword.missingToken, null);
          submitButton.disabled = true;
        }

        form.addEventListener('submit', async (event) => {
          event.preventDefault();
          if (submitButton.disabled) return;
          clearMessages();

          if (!passwordInput.value) {
            showError(common.passwordRequired, passwordInput);
            return;
          }
          // Matches the backend's own minPasswordLength (12) -- see
          // src/server/auth/customer-auth.ts -- not an invented extra rule.
          if (passwordInput.value.length < 12) {
            showError(resetPassword.passwordTooShort, passwordInput);
            return;
          }
          if (passwordInput.value !== confirmPasswordInput.value) {
            showError(resetPassword.passwordMismatch, confirmPasswordInput);
            confirmPasswordInput.focus();
            return;
          }

          submitButton.disabled = true;
          submitButton.textContent = resetPassword.submitLoading;

          let succeeded = false;
          try {
            const res = await fetch('/api/customer-auth/reset-password', {
              method: 'POST',
              headers: { 'content-type': 'application/json' },
              body: JSON.stringify({ token, newPassword: passwordInput.value }),
            });

            if (res.ok) {
              succeeded = true;
              successEl.textContent = resetPassword.successMessage;
              successEl.hidden = false;
              form.reset();
            } else {
              const message = res.status === 429
                ? common.rateLimitError
                : res.status >= 500
                  ? common.serverError
                  : resetPassword.invalidOrExpired;
              showError(message, null);
            }
          } catch {
            showError(common.genericError, null);
          } finally {
            submitButton.textContent = originalLabel;
            // Keep it disabled after success -- the token is single-use,
            // there is nothing left for this form to do.
            submitButton.disabled = succeeded;
          }
        });
      }
    </script>
  </body>
</html>
