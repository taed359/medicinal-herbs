---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { defaultLocale, getTranslations, isLocale, type Locale, type RouteLocale } from '../i18n/utils';

interface Props {
  lang?: RouteLocale;
  uiLang?: Locale;
  htmlLang?: string;
  title?: string;
  description?: string;
}
const { lang = 'vi', uiLang: requestedUiLang, htmlLang = lang, title = 'Medicinal Herbs', description } = Astro.props;
const uiLang = requestedUiLang ?? (isLocale(lang) ? lang : defaultLocale);

// Localized fallback: any page can still pass its own `description` prop
// later (mirroring the existing `title` prop pattern) without a fake or
// English-only default ever being rendered in the meantime.
const t = getTranslations(uiLang);
const metaDescription = description ?? t.seo.description;
---
<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={metaDescription} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body>
    <Header lang={uiLang} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} uiLang={uiLang} />
  </body>
</html>
