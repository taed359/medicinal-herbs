---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { defaultLocale, getTranslations, isLocale, type Locale, type RouteLocale } from '../i18n/utils';

interface Props {
  lang?: RouteLocale;
  uiLang?: Locale;
  htmlLang?: string;
  title?: string;
  description?: string;
  mainClass?: string;
}
const { lang = 'vi', uiLang: requestedUiLang, htmlLang = lang, title = 'Medicinal Herbs', description, mainClass } = Astro.props;
const uiLang = requestedUiLang ?? (isLocale(lang) ? lang : defaultLocale);

// Localized fallback: any page can still pass its own `description` prop
// later (mirroring the existing `title` prop pattern) without a fake or
// English-only default ever being rendered in the meantime.
const t = getTranslations(uiLang);
const metaDescription = description ?? t.seo.description;
---
<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={metaDescription} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <!-- Enables Astro's client-side (soft) navigation: clicking an
         in-site link -- including the Pager prev/next/number links --
         fetches and swaps the new page's content instead of doing a
         full hard reload, so there's no white-flash/scroll-jump-to-top
         "giật" between pages. Every component's own script already
         listens for `astro:page-load` (see AnnouncementBar, Header,
         Footer, HealthGoals) specifically to re-run after this kind of
         swap -- this tag is what actually turns that on. -->
    <ClientRouter />
  </head>
  <body>
    <Header lang={uiLang} />
    <main class={mainClass}>
      <slot />
    </main>
    <Footer lang={lang} uiLang={uiLang} />
  </body>
</html>

<style>
  main.homepage-main {
    background: var(--color-cream);
  }
</style>
