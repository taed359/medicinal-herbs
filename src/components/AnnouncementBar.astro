---
import {
  locales,
  localeMeta,
  localeHomePath,
  swapLocaleInPath,
  isLocale,
  getTranslations,
  type Locale,
} from '../i18n/utils';

interface Props {
  lang: Locale;
  /** Short phrases that rotate every 3s in the announcement bar (auto-
   *  advance + manual prev/next arrows) — see the markup/script below.
   *  A single-item (or empty) array renders as plain static text instead,
   *  with no arrows and no rotation wired up for nothing. */
  messages?: string[];
}

const {
  lang,
  messages = ['Traditional Wisdom', 'Natural Ingredients', 'Quality Assured'],
} = Astro.props;

const hasMultipleMessages = messages.length > 1;

const current = localeMeta[lang];
const t = getTranslations(lang);

// Preserve the current pathname when switching locale: swap only the locale
// segment via the centralized swapLocaleInPath() helper. If the current
// pathname doesn't carry a recognizable locale segment (shouldn't happen
// under our routing, but kept defensive), fall back to that locale's
// homepage via localeHomePath() instead of guessing at a path.
const pathname = Astro.url.pathname;
const firstSegment = pathname.split('/').filter(Boolean)[0] ?? '';
const hasLocaleSegment = isLocale(firstSegment);

const options = locales.map((locale) => ({
  locale,
  meta: localeMeta[locale],
  href: hasLocaleSegment ? swapLocaleInPath(pathname, locale) : localeHomePath(locale),
  active: locale === lang,
}));
---
<!-- Stage 2J: recomposed to match the visual-reference mockup's slim
     topbar -- pine-dark background (not the sitewide brand green),
     paper-2 text, reduced height (36px, close to the mockup's 38px, down
     from the previous 44px). Mechanics (rotation, prev/next, locale
     switching) are entirely unchanged; only color/height/container. -->
<div class="w-full bg-pine-dark text-paper-2">
  <div class="container-editorial h-9 flex items-center justify-between gap-4">
    <!-- Arrows + rotating text live together as one left-aligned group (not
         centered) so the text gets as much width as possible on narrow
         screens (e.g. iPhone SE) instead of splitting space three ways
         with a symmetry spacer. -->
    {hasMultipleMessages ? (
      <div class="announcement-group flex items-center gap-2 min-w-0 flex-1" data-announcement-rotator>
        <div class="announcement-arrows flex items-center gap-1 shrink-0">
          <button
            type="button"
            class="announcement-arrow shrink-0 inline-flex items-center justify-center w-6 h-6 text-paper-2/80 hover:text-amber focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber/70 rounded-sm cursor-pointer transition-colors"
            aria-label="Previous message"
            aria-controls="announcement-track"
            data-announcement-prev
          >
            <svg width="6" height="11" viewBox="0 0 6 11" fill="none" aria-hidden="true">
              <path d="M5 1 1 5.5 5 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <button
            type="button"
            class="announcement-arrow shrink-0 inline-flex items-center justify-center w-6 h-6 text-paper-2/80 hover:text-amber focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber/70 rounded-sm cursor-pointer transition-colors"
            aria-label="Next message"
            aria-controls="announcement-track"
            data-announcement-next
          >
            <svg width="6" height="11" viewBox="0 0 6 11" fill="none" aria-hidden="true">
              <path d="M1 1 5 5.5 1 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
        </div>

        <div id="announcement-track" class="relative flex-1 min-w-0 h-5 overflow-hidden" aria-live="polite">
          {messages.map((msg, i) => (
            <p
              class="announcement-slide m-0 absolute inset-0 flex items-center"
              data-announcement-slide
              data-active={i === 0 ? 'true' : undefined}
            >
              <span class="block w-full min-w-0 truncate text-left text-sm">{msg}</span>
            </p>
          ))}
        </div>
      </div>
    ) : (
      <p class="m-0 min-w-0 flex-1 text-left text-smtruncate">{messages[0] ?? ''}</p>
    )}
    <div class="flex items-center justify-end gap-1 shrink-0">
      <!-- Store locator: UI only for now, deliberately no href/handler --
           there is no store-locator page or physical-store data in this
           codebase yet (see project notes), so this must not pretend to
           navigate anywhere until a real destination exists. A plain,
           unwired <button> (never `<a href="#">`, which would silently
           jump to the top of the page) keeps that honest while still
           matching the announcement bar's other controls visually. -->
      <button
        type="button"
        class="find-store-button flex items-center gap-1.5 min-h-11 px-2 py-1.5 text-sm font-medium text-paper-2 hover:text-amber focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber/70 transition-colors rounded-sm cursor-pointer"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="shrink-0">
          <path d="M12 21s7-7.58 7-12a7 7 0 1 0-14 0c0 4.42 7 12 7 12Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
          <circle cx="12" cy="9" r="2.3" stroke="currentColor" stroke-width="1.6" />
        </svg>
        <span>{t.header.findStoreLabel}</span>
      </button>

      <div class="locale-switcher relative" data-locale-switcher>
        <button
          type="button"
          class="locale-switcher-trigger flex items-center gap-1.5 min-h-11 px-2 py-1.5 text-sm font-medium text-paper-2 hover:text-amber focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-amber/70 transition-colors rounded-sm cursor-pointer"
          aria-haspopup="menu"
          aria-expanded="false"
          aria-controls="locale-switcher-menu"
          data-locale-switcher-trigger
        >
          <span aria-hidden="true" class="text-lg leading-none">{current.flag}</span>
          <span>{current.label}</span>
          <svg class="locale-switcher-caret" width="10" height="10" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>

        <ul
          id="locale-switcher-menu"
          role="menu"
          aria-label="Select shop language"
          class="locale-switcher-menu"
          data-locale-switcher-menu
          hidden
        >
          {options.map((option) => (
            <li role="none">
              <a
                role="menuitemradio"
                aria-checked={option.active}
                href={option.href}
                data-astro-reload
                class:list={['locale-switcher-option', { 'is-active': option.active }]}
                data-locale-switcher-option
              >
                <span class="locale-switcher-check" aria-hidden="true">{option.active ? '✓' : ''}</span>
                <span aria-hidden="true" class="text-lg leading-none">{option.meta.flag}</span>
                <span>{option.meta.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>
</div>

<style>
  .locale-switcher-caret {
    transition: transform 0.15s ease-out;
  }
  .locale-switcher-trigger[aria-expanded='true'] .locale-switcher-caret {
    transform: rotate(180deg);
  }

  .locale-switcher-menu {
    position: absolute;
    top: calc(100% + 6px);
    right: 0;
    z-index: 60;
    min-width: 9rem;
    margin: 0;
    padding: 0.375rem;
    list-style: none;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 0.625rem;
    box-shadow: 0 10px 30px rgba(42, 22, 22, 0.18);
  }

  .locale-switcher-option {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.5rem 0.625rem;
    border-radius: 0.4rem;
    font-family: inherit;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-heading);
    text-decoration: none;
    white-space: nowrap;
    transition: background-color 0.15s ease-out, color 0.15s ease-out;
  }
  .locale-switcher-option:hover,
  .locale-switcher-option:focus-visible {
    background: color-mix(in oklab, var(--color-brand) 12%, transparent);
    outline: none;
  }
  .locale-switcher-option.is-active {
    color: var(--color-brand);
    font-weight: 600;
  }

  .locale-switcher-check {
    display: inline-flex;
    width: 0.9rem;
    justify-content: center;
    color: var(--color-brand);
  }

  .announcement-slide {
    opacity: 0;
    transform: translateY(0);
    transition: transform 0.4s ease, opacity 0.4s ease;
    pointer-events: none;
  }
  .announcement-slide[data-active] {
    opacity: 1;
    pointer-events: auto;
  }

  @media (prefers-reduced-motion: reduce) {
    .locale-switcher-caret {
      transition: none;
    }
    .locale-switcher-option {
      transition: none;
    }
    .announcement-slide {
      transition: none;
    }
  }
</style>

<script>
  function initLocaleSwitchers() {
    const roots = document.querySelectorAll<HTMLElement>('[data-locale-switcher]');

    roots.forEach((root) => {
      if ((root as HTMLElement & { __localeSwitcherInit?: boolean }).__localeSwitcherInit) return;
      (root as HTMLElement & { __localeSwitcherInit?: boolean }).__localeSwitcherInit = true;

      const trigger = root.querySelector<HTMLButtonElement>('[data-locale-switcher-trigger]');
      const menu = root.querySelector<HTMLElement>('[data-locale-switcher-menu]');
      if (!trigger || !menu) return;

      const isOpen = () => !menu.hidden;

      const open = () => {
        menu.hidden = false;
        trigger.setAttribute('aria-expanded', 'true');
      };

      const close = (opts: { focusTrigger?: boolean } = {}) => {
        if (!isOpen()) return;
        menu.hidden = true;
        trigger.setAttribute('aria-expanded', 'false');
        if (opts.focusTrigger) trigger.focus();
      };

      trigger.addEventListener('click', (event) => {
        event.stopPropagation();
        if (isOpen()) {
          close();
        } else {
          open();
        }
      });

      trigger.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowDown' && !isOpen()) {
          event.preventDefault();
          open();
          const first = menu.querySelector<HTMLElement>('[data-locale-switcher-option]');
          first?.focus();
        }
      });

      menu.addEventListener('keydown', (event) => {
        const options = Array.from(menu.querySelectorAll<HTMLElement>('[data-locale-switcher-option]'));
        const currentIndex = options.indexOf(document.activeElement as HTMLElement);

        if (event.key === 'ArrowDown') {
          event.preventDefault();
          const next = options[(currentIndex + 1 + options.length) % options.length];
          next?.focus();
        } else if (event.key === 'ArrowUp') {
          event.preventDefault();
          const prev = options[(currentIndex - 1 + options.length) % options.length];
          prev?.focus();
        }
      });

      document.addEventListener('click', (event) => {
        if (!isOpen()) return;
        if (!root.contains(event.target as Node)) close();
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && isOpen()) {
          event.preventDefault();
          close({ focusTrigger: true });
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initLocaleSwitchers);
  } else {
    initLocaleSwitchers();
  }
  document.addEventListener('astro:page-load', initLocaleSwitchers);
</script>

<script>
  // Rotates the announcement bar's messages every 3s (pausing on hover/
  // focus and when `prefers-reduced-motion: reduce` is set), with manual
  // prev/next arrows. No-ops entirely when there's only one message (see
  // `hasMultipleMessages` above — the rotator markup isn't even rendered
  // in that case, so `roots` below is simply empty).
  function initAnnouncementRotators() {
    const roots = document.querySelectorAll<HTMLElement>('[data-announcement-rotator]');

    roots.forEach((root) => {
      if ((root as HTMLElement & { __announcementInit?: boolean }).__announcementInit) return;
      (root as HTMLElement & { __announcementInit?: boolean }).__announcementInit = true;

      const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-announcement-slide]'));
      const prevButton = root.querySelector<HTMLButtonElement>('[data-announcement-prev]');
      const nextButton = root.querySelector<HTMLButtonElement>('[data-announcement-next]');
      if (slides.length < 2 || !prevButton || !nextButton) return;

      let index = slides.findIndex((slide) => slide.hasAttribute('data-active'));
      if (index < 0) index = 0;

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // "next" enters from above and slides down into place; "prev" enters
      // from below and slides up into place. The outgoing slide keeps
      // moving the SAME way past its exit edge (rather than just fading),
      // so the two read as one continuous vertical motion instead of an
      // unrelated cross-fade.
      const show = (rawNextIndex: number, direction: 'next' | 'prev') => {
        const nextIndex = (rawNextIndex + slides.length) % slides.length;
        if (nextIndex === index) return;

        const oldSlide = slides[index];
        const newSlide = slides[nextIndex];
        index = nextIndex;
        if (!oldSlide || !newSlide) return;

        oldSlide.removeAttribute('data-active');
        newSlide.setAttribute('data-active', 'true');

        // Reduced motion: let the [data-active] CSS rule swap opacity only
        // (its transition is disabled entirely under the media query below)
        // -- no transform/slide at all.
        if (prefersReducedMotion) return;

        const enterFrom = direction === 'next' ? '-100%' : '100%';
        const exitTo = direction === 'next' ? '100%' : '-100%';

        // Snap the incoming slide to its off-screen starting position
        // instantly (no transition), so it doesn't visibly fly in from
        // wherever it was last left sitting.
        newSlide.style.transition = 'none';
        newSlide.style.transform = `translateY(${enterFrom})`;
        newSlide.getBoundingClientRect(); // force layout: commit the instant position before re-enabling transitions
        newSlide.style.transition = '';

        oldSlide.style.transform = `translateY(${exitTo})`;
        newSlide.style.transform = 'translateY(0)';
      };

      let timer: ReturnType<typeof setInterval> | null = null;
      const stop = () => {
        if (timer !== null) {
          clearInterval(timer);
          timer = null;
        }
      };
      const start = () => {
        if (prefersReducedMotion || timer !== null) return;
        timer = setInterval(() => show(index + 1, 'next'), 3000);
      };

      prevButton.addEventListener('click', () => {
        stop();
        show(index - 1, 'prev');
        start();
      });
      nextButton.addEventListener('click', () => {
        stop();
        show(index + 1, 'next');
        start();
      });

      root.addEventListener('mouseenter', stop);
      root.addEventListener('mouseleave', start);
      root.addEventListener('focusin', stop);
      root.addEventListener('focusout', start);

      start();
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAnnouncementRotators);
  } else {
    initAnnouncementRotators();
  }
  document.addEventListener('astro:page-load', initAnnouncementRotators);
</script>
