<script is:inline define:vars={{ submitUrl, submitMethod, mode, editBasePath }}>
  const form = document.querySelector('#product-form');
  const errorEl = document.querySelector('#product-form-error');
  const successEl = document.querySelector('#product-form-success');
  const saveButton = document.querySelector('#product-form-submit');
  const saveContinueButton = document.querySelector('#product-form-save-continue');
  const deleteButton = document.querySelector('#delete-product-button');
  const statusBadge = document.querySelector('[data-status-badge]');
  const statusCheckbox = document.querySelector('[data-status-checkbox]');
  const titleEl = document.querySelector('#product-form-title');
  const nameViInput = document.querySelector('#nameVi');

  function showError(message) {
    if (!(errorEl instanceof HTMLElement)) return;
    if (successEl instanceof HTMLElement) successEl.hidden = true;
    errorEl.textContent = message;
    errorEl.hidden = false;
  }

  function showSuccess(message) {
    if (!(successEl instanceof HTMLElement)) return;
    if (errorEl instanceof HTMLElement) errorEl.hidden = true;
    successEl.textContent = message;
    successEl.hidden = false;
  }

  // "Save & continue editing" (edit mode) reloads with a one-time
  // `?saved=1` marker so this page load can show success feedback -- the
  // marker is stripped immediately via replaceState so a manual refresh
  // afterwards doesn't re-show the message.
  if (mode === 'edit' && new URLSearchParams(window.location.search).get('saved') === '1') {
    showSuccess('Product saved.');
    const url = new URL(window.location.href);
    url.searchParams.delete('saved');
    window.history.replaceState(null, '', url.pathname + url.search + url.hash);
  }

  // Live status badge / title -- pure UX polish, has no bearing on what
  // actually gets saved (that always comes from reading the form fields).
  if (statusCheckbox instanceof HTMLInputElement && statusBadge instanceof HTMLElement) {
    statusCheckbox.addEventListener('change', () => {
      statusBadge.textContent = statusCheckbox.checked ? 'Published' : 'Draft';
      statusBadge.classList.toggle('admin-badge-published', statusCheckbox.checked);
    });
  }
  if (nameViInput instanceof HTMLInputElement && titleEl instanceof HTMLElement && mode === 'edit') {
    nameViInput.addEventListener('input', () => {
      titleEl.textContent = nameViInput.value || 'Untitled product';
    });
  }

  // --- Repeatable child records (benefits/warnings/certifications/
  // gallery images) ----------------------------------------------------
  // Each row's fields use [data-field], not `name` -- they're read
  // directly here rather than through FormData(form), and sortOrder is
  // never sent: the server recomputes it from array position (see
  // parseAdminProductInput), so a row's position in the DOM is the only
  // thing that has to be right, and "move up"/"move down" just reorder
  // DOM nodes.
  function fieldValue(row, field) {
    const el = row.querySelector(`[data-field="${field}"]`);
    if (el instanceof HTMLInputElement && el.type === 'checkbox') {
      return el.checked ? 'true' : 'false';
    }
    if (el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement || el instanceof HTMLSelectElement) {
      return el.value;
    }
    return '';
  }

  function collectRows(listKey, fieldNames, extra) {
    const list = document.querySelector(`[data-repeat-list="${listKey}"]`);
    if (!(list instanceof HTMLElement)) return [];
    return Array.from(list.querySelectorAll(':scope > [data-row]')).map((row) => {
      const obj = { id: fieldValue(row, 'id') || null };
      for (const f of fieldNames) obj[f] = fieldValue(row, f);
      return extra ? Object.assign(obj, extra) : obj;
    });
  }

  function refreshEmptyNote(listEl) {
    const note = listEl.parentElement?.querySelector(':scope > [data-empty-note]');
    if (note instanceof HTMLElement) {
      note.hidden = listEl.querySelector('[data-row]') !== null;
    }
  }

  function wireRepeatRow(row) {
    row.querySelector('[data-remove-row]')?.addEventListener('click', () => {
      const list = row.closest('[data-repeat-list]');
      row.remove();
      if (list instanceof HTMLElement) refreshEmptyNote(list);
    });
    row.querySelector('[data-move-up]')?.addEventListener('click', () => {
      const prev = row.previousElementSibling;
      if (prev) row.parentElement?.insertBefore(row, prev);
    });
    row.querySelector('[data-move-down]')?.addEventListener('click', () => {
      const next = row.nextElementSibling;
      if (next) row.parentElement?.insertBefore(next, row);
    });
    // Gallery-image rows only: keep the thumbnail preview in sync with
    // the URL field as the operator types/pastes.
    const urlField = row.querySelector('[data-field="url"]');
    const preview = row.querySelector('[data-preview]');
    if (urlField instanceof HTMLInputElement && preview instanceof HTMLImageElement) {
      urlField.addEventListener('input', () => {
        preview.src = urlField.value;
      });
    }
    // Variant rows only: the DB allows at most one default variant per
    // product (a partial unique index -- see idx_variants_one_default in
    // src/db/schema.ts), so checking one row's "Default variant" box here
    // unchecks every other row's -- the same "at most one" invariant, just
    // enforced client-side before it can ever reach the server as a
    // rejected 409.
    const defaultField = row.querySelector('[data-field="isDefault"]');
    if (defaultField instanceof HTMLInputElement && defaultField.type === 'checkbox') {
      defaultField.addEventListener('change', () => {
        if (!defaultField.checked) return;
        const list = row.closest('[data-repeat-list]');
        if (!(list instanceof HTMLElement)) return;
        list.querySelectorAll('[data-field="isDefault"]').forEach((other) => {
          if (other !== defaultField && other instanceof HTMLInputElement) other.checked = false;
        });
      });
    }

    // Variant rows only: "Remove price" is a distinct, reversible-until-
    // save action -- separate from simply blanking the price inputs,
    // which the server treats as "untouched" (see
    // AdminProductVariantPriceInput's doc comment). No confirm() dialog
    // here, deliberately: like every other repeatable-row removal in this
    // form (benefit/warning/certification/image/variant rows), nothing
    // actually happens to the database until Save is clicked, and
    // "Cancel removal" undoes this instantly -- a confirm prompt on just
    // this one action would be inconsistent with that "nothing persists
    // until Save" model the rest of the form follows. Toggling sets/
    // clears the hidden `clearPrice` flag the server actually keys off
    // of, and disables the price inputs while a clear is pending so the
    // operator can't type a new price without first cancelling.
    const clearToggle = row.querySelector('[data-clear-price-toggle]');
    const clearField = row.querySelector('[data-field="clearPrice"]');
    const clearStatus = row.querySelector('[data-clear-price-status]');
    const priceField = row.querySelector('[data-field="priceMinor"]');
    const compareAtField = row.querySelector('[data-field="compareAtMinor"]');
    if (
      clearToggle instanceof HTMLButtonElement &&
      clearField instanceof HTMLInputElement &&
      priceField instanceof HTMLInputElement &&
      compareAtField instanceof HTMLInputElement
    ) {
      clearToggle.addEventListener('click', () => {
        const isClearing = clearField.value !== 'true';
        if (isClearing) {
          clearToggle.dataset.restorePrice = priceField.value;
          clearToggle.dataset.restoreCompareAt = compareAtField.value;
          priceField.value = '';
          compareAtField.value = '';
          priceField.disabled = true;
          compareAtField.disabled = true;
          clearField.value = 'true';
          clearToggle.textContent = 'Cancel removal';
        } else {
          priceField.value = clearToggle.dataset.restorePrice ?? '';
          compareAtField.value = clearToggle.dataset.restoreCompareAt ?? '';
          priceField.disabled = false;
          compareAtField.disabled = false;
          clearField.value = 'false';
          clearToggle.textContent = 'Remove price';
        }
        if (clearStatus instanceof HTMLElement) clearStatus.hidden = !isClearing;
      });
    }
  }

  document.querySelectorAll('[data-repeat-list] [data-row]').forEach((row) => {
    if (row instanceof HTMLElement) wireRepeatRow(row);
  });
  document.querySelectorAll('[data-repeat-list]').forEach((list) => {
    if (list instanceof HTMLElement) refreshEmptyNote(list);
  });

  document.querySelectorAll('[data-add-row]').forEach((button) => {
    button.addEventListener('click', () => {
      const listKey = button.getAttribute('data-add-row');
      const templateName = button.getAttribute('data-template');
      if (!listKey || !templateName) return;
      const list = document.querySelector(`[data-repeat-list="${listKey}"]`);
      const template = document.querySelector(`template[data-row-template="${templateName}"]`);
      if (!(list instanceof HTMLElement) || !(template instanceof HTMLTemplateElement)) return;
      const fragment = template.content.cloneNode(true);
      const row = fragment.firstElementChild;
      if (!(row instanceof HTMLElement)) return;
      wireRepeatRow(row);
      list.appendChild(row);
      refreshEmptyNote(list);
      const firstField = row.querySelector('textarea, input:not([type="hidden"])');
      if (firstField instanceof HTMLElement) firstField.focus();
    });
  });

  function readForm() {
    if (!(form instanceof HTMLFormElement)) return null;
    const data = new FormData(form);
    return {
      slug: String(data.get('slug') ?? ''),
      categoryId: String(data.get('categoryId') ?? ''),
      sortOrder: Number(data.get('sortOrder') ?? 0),
      isFeatured: data.get('isFeatured') === 'on',
      isPublished: data.get('isPublished') === 'on',
      nameVi: String(data.get('nameVi') ?? ''),
      nameZh: String(data.get('nameZh') ?? ''),
      shortDescriptionVi: String(data.get('shortDescriptionVi') ?? ''),
      shortDescriptionZh: String(data.get('shortDescriptionZh') ?? ''),
      descriptionVi: String(data.get('descriptionVi') ?? ''),
      descriptionZh: String(data.get('descriptionZh') ?? ''),
      ingredientsVi: String(data.get('ingredientsVi') ?? ''),
      ingredientsZh: String(data.get('ingredientsZh') ?? ''),
      usageVi: String(data.get('usageVi') ?? ''),
      usageZh: String(data.get('usageZh') ?? ''),
      botanicalName: String(data.get('botanicalName') ?? ''),
      countryOfOriginCode: String(data.get('countryOfOriginCode') ?? ''),
      extractionMethod: String(data.get('extractionMethod') ?? ''),
      manufacturerName: String(data.get('manufacturerName') ?? ''),
      imageUrl: String(data.get('imageUrl') ?? ''),
      imageAltVi: String(data.get('imageAltVi') ?? ''),
      imageAltZh: String(data.get('imageAltZh') ?? ''),
      benefits: [
        ...collectRows('benefits-vi', ['text', 'claimType'], { locale: 'vi' }),
        ...collectRows('benefits-zh', ['text', 'claimType'], { locale: 'zh' }),
      ],
      warnings: [
        ...collectRows('warnings-vi', ['text'], { locale: 'vi' }),
        ...collectRows('warnings-zh', ['text'], { locale: 'zh' }),
      ],
      certifications: collectRows('certifications', ['certType', 'issuingBody', 'certificateNumber', 'validFrom', 'validTo']),
      galleryImages: collectRows('galleryImages', ['url', 'altVi', 'altZh']),
      variants: collectRows('variants', [
        'sku', 'isDefault', 'labelVi', 'labelZh',
        'netQuantityValue', 'netQuantityUnit', 'containerType', 'gtin',
        'priceMinor', 'compareAtMinor', 'clearPrice', 'inventoryQuantity', 'lowStockThreshold',
      ]),
    };
  }

  let submitting = false;
  // Set right before any `window.location.href = ...` this script issues
  // (successful save, successful delete) so the beforeunload guard below
  // never misfires a "you have unsaved changes" warning for a navigation
  // this script itself intentionally triggered.
  let leavingIntentionally = false;

  if (form instanceof HTMLFormElement && errorEl instanceof HTMLElement && saveButton instanceof HTMLButtonElement) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (submitting) return; // guards against a duplicate submission (e.g. double Enter/click)
      submitting = true;

      errorEl.hidden = true;
      if (successEl instanceof HTMLElement) successEl.hidden = true;

      const submitter = event.submitter;
      const intent = submitter instanceof HTMLElement ? submitter.dataset.submitIntent : 'list';

      const saveButtonOriginalText = saveButton.textContent;
      const saveContinueButtonOriginalText =
        saveContinueButton instanceof HTMLButtonElement ? saveContinueButton.textContent : null;

      saveButton.disabled = true;
      saveButton.textContent = 'Saving…';
      if (saveContinueButton instanceof HTMLButtonElement) {
        saveContinueButton.disabled = true;
        saveContinueButton.textContent = 'Saving…';
      }

      const payload = readForm();

      try {
        const res = await fetch(submitUrl, {
          method: submitMethod,
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(payload),
        });

        if (res.ok) {
          leavingIntentionally = true;
          if (intent === 'continue') {
            if (mode === 'create') {
              const body = await res.json().catch(() => null);
              if (body && body.id) {
                window.location.href = `/admin/products/${body.id}/edit`;
                return;
              }
              window.location.href = '/admin/products';
              return;
            }
            // Reload so read-only sections (metadata, status badge source
            // of truth) reflect what the server actually persisted. The
            // `saved=1` marker is read once below to show a success
            // message, then stripped from the URL so refreshing the page
            // doesn't re-show it.
            window.location.href = `${editBasePath || window.location.pathname}?saved=1`;
            return;
          }
          window.location.href = '/admin/products';
          return;
        }

        const body = await res.json().catch(() => null);
        showError(body?.error || `Request failed (${res.status}).`);
      } catch {
        showError('Something went wrong. Please try again.');
      } finally {
        submitting = false;
        saveButton.disabled = false;
        saveButton.textContent = saveButtonOriginalText;
        if (saveContinueButton instanceof HTMLButtonElement) {
          saveContinueButton.disabled = false;
          saveContinueButton.textContent = saveContinueButtonOriginalText;
        }
      }
    });
  }

  if (deleteButton instanceof HTMLButtonElement) {
    const deleteButtonOriginalText = deleteButton.textContent;
    deleteButton.addEventListener('click', async () => {
      const url = deleteButton.dataset.deleteUrl;
      if (!url) return;
      if (!window.confirm('Delete this product? This also removes its images, variants, pricing, inventory, benefits, warnings, and certifications. This cannot be undone.')) return;

      deleteButton.disabled = true;
      deleteButton.textContent = 'Deleting…';
      try {
        const res = await fetch(url, { method: 'DELETE' });
        if (res.ok) {
          leavingIntentionally = true;
          window.location.href = '/admin/products';
          return;
        }
        const body = await res.json().catch(() => null);
        showError(body?.error || `Delete failed (${res.status}).`);
      } catch {
        showError('Something went wrong. Please try again.');
      } finally {
        deleteButton.disabled = false;
        deleteButton.textContent = deleteButtonOriginalText;
      }
    });
  }

  // Warn on navigating away with unsaved changes -- lightweight, no
  // framework/state-tracking library. Compares the form's current
  // FormData against a snapshot taken on load; suppressed for any
  // navigation this script itself triggered (successful save/delete),
  // via `leavingIntentionally`. The repeatable-record sections
  // (benefits/warnings/certifications/gallery images) use [data-field]
  // instead of `name` (see readForm()), so FormData(form) alone can't
  // see edits/adds/removes/reorders there -- repeatRowsSnapshot() covers
  // that half separately; row ORDER is included on purpose since
  // reordering changes what gets saved (sortOrder is derived from it).
  function repeatRowsSnapshot() {
    return Array.from(document.querySelectorAll('[data-repeat-list]'))
      .map((list) => {
        const key = list.getAttribute('data-repeat-list') || '';
        const rows = Array.from(list.querySelectorAll(':scope > [data-row]')).map((row) =>
          Array.from(row.querySelectorAll('[data-field]'))
            .map((el) => {
              if (el instanceof HTMLInputElement && el.type === 'checkbox') return el.checked ? 'true' : 'false';
              return el instanceof HTMLInputElement || el instanceof HTMLTextAreaElement || el instanceof HTMLSelectElement
                ? el.value
                : '';
            })
            .join('~')
        );
        return `${key}:[${rows.join(';')}]`;
      })
      .join('|');
  }

  if (form instanceof HTMLFormElement) {
    const initialFormSnapshot = new FormData(form);
    const initialRepeatSnapshot = repeatRowsSnapshot();
    function snapshotsDiffer() {
      const current = new FormData(form);
      const a = Array.from(initialFormSnapshot.entries()).map((e) => e.join('=')).sort();
      const b = Array.from(current.entries()).map((e) => e.join('=')).sort();
      if (a.join('|') !== b.join('|')) return true;
      return initialRepeatSnapshot !== repeatRowsSnapshot();
    }
    window.addEventListener('beforeunload', (event) => {
      if (leavingIntentionally) return;
      if (!snapshotsDiffer()) return;
      event.preventDefault();
      event.returnValue = '';
    });
  }
</script>
