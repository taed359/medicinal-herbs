---
/**
 * Shared Create/Edit form for Product CRUD -- redesigned (Product Editor
 * audit). Renders the same markup for both src/pages/admin/products/
 * new.astro and src/pages/admin/products/[id]/edit.astro; the two pages
 * only differ in `mode`, whether `product` is pre-filled, and which HTTP
 * verb + URL the client script below submits to.
 *
 * Field coverage: every input here maps to a real, persisted column (see
 * AdminProductWriteInput / the Postgres repository's create()/update()).
 * Every repeatable child-record section (benefits, warnings,
 * certifications, gallery images, variants+pricing+inventory) is a full
 * replace-set editor, not a read-only display -- see each section's own
 * repository method (replaceBenefits/replaceWarnings/
 * replaceCertifications/replaceGalleryImages/replaceVariants) for how the
 * on-screen row order and field values become the row's complete set of
 * children after save. Pricing specifically edits the variant's current
 * effective price in place rather than adding price-history versioning UI
 * -- see AdminProductVariantInput's doc comment.
 *
 * Follows the same plain-fetch, no-framework submit pattern established
 * in Phase 1 (see login.astro) -- no form library, no framework island.
 */
import type { AdminCategoryOption, AdminProductEditView } from '../../domain/admin-types';

interface Props {
  mode: 'create' | 'edit';
  categories: AdminCategoryOption[];
  product?: AdminProductEditView;
}

const { mode, categories, product } = Astro.props;

const submitUrl = mode === 'create' ? '/api/admin/products' : `/api/admin/products/${product!.id}`;
const submitMethod = mode === 'create' ? 'POST' : 'PATCH';
const deleteUrl = mode === 'edit' ? `/api/admin/products/${product!.id}` : '';
const editBasePath = mode === 'edit' ? `/admin/products/${product!.id}/edit` : '';

function formatDate(iso: string): string {
  return new Date(iso).toLocaleString('vi-VN');
}

const galleryImages = (product?.images ?? []).filter((img) => img.role !== 'primary' || img.id !== product?.imageId);
---

<form id="product-form" class="product-form" novalidate>
  <noscript>
    <p class="product-form-error">JavaScript is required to use the product editor.</p>
  </noscript>
  <p id="product-form-error" class="product-form-error" role="alert" hidden></p>
  <p id="product-form-success" class="product-form-success" role="status" hidden></p>

  <div class="product-form-header">
    <div class="product-form-header-main">
      <a href="/admin/products" class="product-form-back">&larr; Back to products</a>
      <div class="product-form-heading">
        <h2 id="product-form-title">{mode === 'create' ? 'New product' : (product?.nameVi || 'Untitled product')}</h2>
        {mode === 'edit' && (
          <span class:list={['admin-badge', { 'admin-badge-published': product?.isPublished }]} data-status-badge>
            {product?.isPublished ? 'Published' : 'Draft'}
          </span>
        )}
        {mode === 'edit' && product?.isFeatured && <span class="admin-badge admin-badge-featured">Featured</span>}
      </div>
    </div>
    <div class="product-form-header-actions">
      <button type="submit" class="admin-btn admin-btn-secondary" data-submit-intent="continue" id="product-form-save-continue">
        Save &amp; continue editing
      </button>
      <button type="submit" class="admin-btn admin-btn-primary" data-submit-intent="list" id="product-form-submit">
        {mode === 'create' ? 'Create product' : 'Save changes'}
      </button>
    </div>
  </div>

  <div class="product-form-layout">
    <div class="product-form-main">
      <section class="admin-card">
        <h3 class="admin-card-title">Basic information</h3>
        <p class="admin-card-subtitle">The product's name and storefront URL.</p>

        <div class="admin-columns-2">
          <div class="admin-field">
            <label for="nameVi">Name (VI) <span class="admin-required-mark" aria-hidden="true">*</span></label>
            <input id="nameVi" name="nameVi" type="text" required value={product?.nameVi ?? ''} aria-describedby="nameVi-hint" />
          </div>
          <div class="admin-field">
            <label for="nameZh">Name (ZH) <span class="admin-required-mark" aria-hidden="true">*</span></label>
            <input id="nameZh" name="nameZh" type="text" required value={product?.nameZh ?? ''} />
          </div>
        </div>

        <div class="admin-field">
          <label for="slug">Slug <span class="admin-required-mark" aria-hidden="true">*</span></label>
          <input
            id="slug"
            name="slug"
            type="text"
            required
            pattern="[a-z0-9]+(-[a-z0-9]+)*"
            placeholder="coconut-oil"
            value={product?.slug ?? ''}
            aria-describedby="slug-hint"
          />
          <p id="slug-hint" class="admin-hint">Lowercase letters, numbers, and hyphens only. Used in the product's storefront URL.</p>
        </div>
      </section>

      <section class="admin-card">
        <h3 class="admin-card-title">Descriptions</h3>
        <p class="admin-card-subtitle">Shown on the storefront product page. VI and ZH are edited side by side.</p>

        <div class="admin-columns-2">
          <div class="admin-field">
            <label for="shortDescriptionVi">Short description (VI) <span class="admin-optional">optional</span></label>
            <textarea id="shortDescriptionVi" name="shortDescriptionVi" rows="2">{product?.shortDescriptionVi ?? ''}</textarea>
          </div>
          <div class="admin-field">
            <label for="shortDescriptionZh">Short description (ZH) <span class="admin-optional">optional</span></label>
            <textarea id="shortDescriptionZh" name="shortDescriptionZh" rows="2">{product?.shortDescriptionZh ?? ''}</textarea>
          </div>
        </div>

        <div class="admin-columns-2">
          <div class="admin-field">
            <label for="descriptionVi">Description (VI) <span class="admin-optional">optional</span></label>
            <textarea id="descriptionVi" name="descriptionVi" rows="5">{product?.descriptionVi ?? ''}</textarea>
          </div>
          <div class="admin-field">
            <label for="descriptionZh">Description (ZH) <span class="admin-optional">optional</span></label>
            <textarea id="descriptionZh" name="descriptionZh" rows="5">{product?.descriptionZh ?? ''}</textarea>
          </div>
        </div>

        <div class="admin-columns-2">
          <div class="admin-field">
            <label for="ingredientsVi">Ingredients (VI) <span class="admin-optional">optional</span></label>
            <textarea id="ingredientsVi" name="ingredientsVi" rows="3">{product?.ingredientsVi ?? ''}</textarea>
          </div>
          <div class="admin-field">
            <label for="ingredientsZh">Ingredients (ZH) <span class="admin-optional">optional</span></label>
            <textarea id="ingredientsZh" name="ingredientsZh" rows="3">{product?.ingredientsZh ?? ''}</textarea>
          </div>
        </div>

        <div class="admin-columns-2">
          <div class="admin-field">
            <label for="usageVi">Usage instructions (VI) <span class="admin-optional">optional</span></label>
            <textarea id="usageVi" name="usageVi" rows="3">{product?.usageVi ?? ''}</textarea>
          </div>
          <div class="admin-field">
            <label for="usageZh">Usage instructions (ZH) <span class="admin-optional">optional</span></label>
            <textarea id="usageZh" name="usageZh" rows="3">{product?.usageZh ?? ''}</textarea>
          </div>
        </div>
      </section>

      <section class="admin-card">
        <h3 class="admin-card-title">Product information</h3>
        <p class="admin-card-subtitle">Real attribute columns on the product. All optional -- leave blank if unknown rather than guessing.</p>

        <div class="admin-columns-2">
          <div class="admin-field">
            <label for="botanicalName">Botanical name <span class="admin-optional">optional</span></label>
            <input id="botanicalName" name="botanicalName" type="text" value={product?.botanicalName ?? ''} placeholder="e.g. Cocos nucifera" />
          </div>
          <div class="admin-field">
            <label for="countryOfOriginCode">Country of origin <span class="admin-optional">optional</span></label>
            <input id="countryOfOriginCode" name="countryOfOriginCode" type="text" value={product?.countryOfOriginCode ?? ''} placeholder="e.g. VN" maxlength="2" />
            <p class="admin-hint">ISO 3166-1 alpha-2 code (e.g. VN, CN).</p>
          </div>
        </div>
        <div class="admin-columns-2">
          <div class="admin-field">
            <label for="extractionMethod">Extraction method <span class="admin-optional">optional</span></label>
            <input id="extractionMethod" name="extractionMethod" type="text" value={product?.extractionMethod ?? ''} placeholder="e.g. cold-pressed" />
          </div>
          <div class="admin-field">
            <label for="manufacturerName">Manufacturer <span class="admin-optional">optional</span></label>
            <input id="manufacturerName" name="manufacturerName" type="text" value={product?.manufacturerName ?? ''} />
          </div>
        </div>
      </section>

      <section class="admin-card">
        <h3 class="admin-card-title">Benefits</h3>
        <p class="admin-card-subtitle">Marketing/factual claim bullets shown on the storefront. Add as many as needed, per locale.</p>
        <div class="admin-columns-2">
          <div>
            <p class="admin-readonly-group-label">VI</p>
            <div class="admin-repeat-list" data-repeat-list="benefits-vi">
              {(product?.benefits.filter((b) => b.locale === 'vi') ?? []).map((b) => (
                <div class="admin-repeat-row" data-row>
                  <input type="hidden" data-field="id" value={b.id} />
                  <div class="admin-field">
                    <label class="sr-only">Benefit text (VI)</label>
                    <textarea data-field="text" rows="2">{b.text}</textarea>
                  </div>
                  <div class="admin-field">
                    <label class="sr-only">Claim type</label>
                    <select data-field="claimType">
                      <option value="marketing" selected={b.claimType === 'marketing'}>Marketing</option>
                      <option value="factual" selected={b.claimType === 'factual'}>Factual</option>
                      <option value="structure_function" selected={b.claimType === 'structure_function'}>Structure/function</option>
                    </select>
                  </div>
                  <div class="admin-repeat-row-actions">
                    <button type="button" class="admin-btn admin-btn-text admin-btn-sm" data-move-up aria-label="Move up">&uarr;</button>
                    <button type="button" class="admin-btn admin-btn-text admin-btn-sm" data-move-down aria-label="Move down">&darr;</button>
                    <button type="button" class="admin-btn admin-btn-text admin-btn-sm" data-remove-row>Remove</button>
                  </div>
                </div>
              ))}
            </div>
            <p class="admin-empty-note" data-empty-note hidden>No VI benefits yet.</p>
            <button type="button" class="admin-btn admin-btn-secondary admin-btn-sm" data-add-row="benefits-vi" data-template="benefit-row" data-locale="vi">+ Add benefit (VI)</button>
          </div>
          <div>
            <p class="admin-readonly-group-label">ZH</p>
            <div class="admin-repeat-list" data-repeat-list="benefits-zh">
              {(product?.benefits.filter((b) => b.locale === 'zh') ?? []).map((b) => (
                <div class="admin-repeat-row" data-row>
                  <input type="hidden" data-field="id" value={b.id} />
                  <div class="admin-field">
                    <label class="sr-only">Benefit text (ZH)</label>
                    <textarea data-field="text" rows="2">{b.text}</textarea>
                  </div>
                  <div class="admin-field">
                    <label class="sr-only">Claim type</label>
                    <select data-field="claimType">
                      <option value="marketing" selected={b.claimType === 'marketing'}>Marketing</option>
                      <option value="factual" selected={b.claimType === 'factual'}>Factual</option>
                      <option value="structure_function" selected={b.claimType === 'structure_function'}>Structure/function</option>
                    </select>
                  </div>
                  <div class="admin-repeat-row-actions">
                    <button type="button" class="admin-btn admin-btn-text admin-btn-sm" data-move-up aria-label="Move up">&uarr;</button>
                    <button type="button" class="admin-btn admin-btn-text admin-btn-sm" data-move-down aria-label="Move down">&darr;</button>
                    <button type="button" class="admin-btn admin-btn-text admin-btn-sm" data-remove-row>Remove</button>
                  </div>
                </div>
              ))}
            </div>
            <p class="admin-empty-note" data-empty-note hidden>No ZH benefits yet.</p>
            <button type="button" class="admin-btn admin-btn-secondary admin-btn-sm" data-add-row="benefits-zh" data-template="benefit-row" data-locale="zh">+ Add benefit (ZH)</button>
          </div>
        </div>
      </section>

      <section class="admin-card">
        <h3 class="admin-card-title">Warnings</h3>
        <p class="admin-card-subtitle">Safety notices shown on the storefront. Add as many as needed, per locale.</p>
        <div class="admin-columns-2">
          <div>
            <p class="admin-readonly-group-label">VI</p>
            <div class="admin-repeat-list" data-repeat-list="warnings-vi">
              {(product?.warnings.filter((w) => w.locale === 'vi') ?? []).map((w) => (
                <div class="admin-repeat-row" data-row>
                  <input type="hidden" data-field="id" value={w.id} />
                  <div class="admin-field">
                    <label class="sr-only">Warning text (VI)</label>
                    <textarea data-field="text" rows="2">{w.text}</textarea>
                  </div>
                  <div class="admin-repeat-row-actions">
                    <button type="button" class="admin-btn admin-btn-text admin-btn-sm" data-move-up aria-label="Move up">&uarr;</button>
                    <button type="button" class="admin-btn admin-btn-text admin-btn-sm" data-move-down aria-label="Move down">&darr;</button>
                    <button type="button" class="admin-btn admin-btn-text admin-btn-sm" data-remove-row>Remove</button>
                  </div>
                </div>
              ))}
            </div>
            <p class="admin-empty-note" data-empty-note hidden>No VI warnings yet.</p>
            <button type="button" class="admin-btn admin-btn-secondary admin-btn-sm" data-add-row="warnings-vi" data-template="warning-row" data-locale="vi">+ Add warning (VI)</button>
          </div>
          <div>
            <p class="admin-readonly-group-label">ZH</p>
            <div class="admin-repeat-list" data-repeat-list="warnings-zh">
              {(product?.warnings.filter((w) => w.locale === 'zh') ?? []).map((w) => (
                <div class="admin-repeat-row" data-row>
                  <input type="hidden" data-field="id" value={w.id} />
                  <div class="admin-field">
                    <label class="sr-only">Warning text (ZH)</label>
                    <textarea data-field="text" rows="2">{w.text}</textarea>
                  </div>
                  <div class="admin-repeat-row-actions">
                    <button type="button" class="admin-btn admin-btn-text admin-btn-sm" data-move-up aria-label="Move up">&uarr;</button>
                    <button type="button" class="admin-btn admin-btn-text admin-btn-sm" data-move-down aria-label="Move down">&darr;</button>
                    <button type="button" class="admin-btn admin-btn-text admin-btn-sm" data-remove-row>Remove</button>
                  </div>
                </div>
              ))}
            </div>
            <p class="admin-empty-note" data-empty-note hidden>No ZH warnings yet.</p>
            <button type="button" class="admin-btn admin-btn-secondary admin-btn-sm" data-add-row="warnings-zh" data-template="warning-row" data-locale="zh">+ Add warning (ZH)</button>
          </div>
        </div>
      </section>

      <section class="admin-card">
        <h3 class="admin-card-title">Certifications</h3>
        <p class="admin-card-subtitle">Organic/ISO/etc. certifications shown on the storefront. certType is free text (no fixed list exists).</p>
        <div class="admin-repeat-list admin-repeat-list-stack" data-repeat-list="certifications">
          {(product?.certifications ?? []).map((c) => (
            <div class="admin-repeat-row admin-repeat-row-block" data-row>
              <input type="hidden" data-field="id" value={c.id} />
              <div class="admin-columns-2">
                <div class="admin-field">
                  <label class="sr-only">Certification type</label>
                  <input data-field="certType" type="text" placeholder="Certification type (e.g. organic)" value={c.certType} />
                </div>
                <div class="admin-field">
                  <label class="sr-only">Issuing body</label>
                  <input data-field="issuingBody" type="text" placeholder="Issuing body (optional)" value={c.issuingBody ?? ''} />
                </div>
              </div>
              <div class="admin-columns-2">
                <div class="admin-field">
                  <label class="sr-only">Certificate number</label>
                  <input data-field="certificateNumber" type="text" placeholder="Certificate number (optional)" value={c.certificateNumber ?? ''} />
                </div>
                <div class="admin-field admin-field-date-pair">
                  <label class="sr-only">Valid from / to</label>
                  <div class="admin-date-pair">
                    <input data-field="validFrom" type="date" value={c.validFrom ?? ''} aria-label="Valid from" />
                    <span aria-hidden="true">&ndash;</span>
                    <input data-field="validTo" type="date" value={c.validTo ?? ''} aria-label="Valid to (blank = ongoing)" />
                  </div>
                </div>
              </div>
              <div class="admin-repeat-row-actions">
                <button type="button" class="admin-btn admin-btn-text admin-btn-sm" data-remove-row>Remove</button>
              </div>
            </div>
          ))}
        </div>
        <p class="admin-empty-note" data-empty-note hidden>No certifications yet.</p>
        <button type="button" class="admin-btn admin-btn-secondary admin-btn-sm" data-add-row="certifications" data-template="certification-row">+ Add certification</button>
      </section>

      <section class="admin-card">
        <h3 class="admin-card-title">Variants, pricing &amp; inventory</h3>
        <p class="admin-card-subtitle">
          One row per purchasable SKU. Exactly one variant may be marked default (shown in the Products grid).
          Price edits update today's price directly -- there is no scheduling for future price changes here.
        </p>
        <div class="admin-repeat-list admin-repeat-list-stack" data-repeat-list="variants">
          {(product?.variants ?? []).map((v) => (
            <div class="admin-repeat-row admin-repeat-row-block" data-row>
              <input type="hidden" data-field="id" value={v.id} />
              <div class="admin-columns-2">
                <div class="admin-field">
                  <label class="sr-only">SKU</label>
                  <input data-field="sku" type="text" placeholder="SKU" required value={v.sku} />
                </div>
                <label class="admin-checkbox-row admin-variant-default-row">
                  <input data-field="isDefault" type="checkbox" checked={v.isDefault} />
                  Default variant
                </label>
              </div>
              <div class="admin-columns-2">
                <div class="admin-field">
                  <label class="sr-only">Label (VI)</label>
                  <input data-field="labelVi" type="text" placeholder="Label (VI, optional)" value={v.labelVi ?? ''} />
                </div>
                <div class="admin-field">
                  <label class="sr-only">Label (ZH)</label>
                  <input data-field="labelZh" type="text" placeholder="Label (ZH, optional)" value={v.labelZh ?? ''} />
                </div>
              </div>
              <div class="admin-columns-2">
                <div class="admin-field">
                  <label class="sr-only">Net quantity</label>
                  <div class="admin-inline-pair">
                    <input data-field="netQuantityValue" type="number" min="0" step="any" placeholder="Net qty" aria-label="Net quantity value" value={v.netQuantityValue ?? ''} />
                    <select data-field="netQuantityUnit" aria-label="Net quantity unit">
                      <option value="" selected={!v.netQuantityUnit}>Unit</option>
                      <option value="ml" selected={v.netQuantityUnit === 'ml'}>ml</option>
                      <option value="l" selected={v.netQuantityUnit === 'l'}>l</option>
                      <option value="g" selected={v.netQuantityUnit === 'g'}>g</option>
                      <option value="fl_oz" selected={v.netQuantityUnit === 'fl_oz'}>fl oz</option>
                    </select>
                  </div>
                </div>
                <div class="admin-field">
                  <label class="sr-only">Container type</label>
                  <input data-field="containerType" type="text" placeholder="Container type (optional)" value={v.containerType ?? ''} />
                </div>
              </div>
              <div class="admin-field">
                <label class="sr-only">GTIN</label>
                <input data-field="gtin" type="text" placeholder="GTIN (optional)" value={v.gtin ?? ''} />
              </div>
              <p class="admin-readonly-group-label admin-variant-subsection">Pricing &amp; inventory</p>
              <div class="admin-columns-2">
                <div class="admin-field">
                  <label class="sr-only">Price (VND)</label>
                  <input data-field="priceMinor" type="number" min="0" step="1" placeholder="Price (VND)" value={v.priceMinor ?? ''} />
                </div>
                <div class="admin-field">
                  <label class="sr-only">Compare-at price (VND)</label>
                  <input data-field="compareAtMinor" type="number" min="0" step="1" placeholder="Compare-at price (VND, optional)" value={v.compareAtMinor ?? ''} />
                </div>
              </div>
              <input type="hidden" data-field="clearPrice" value="false" />
              <div class="admin-variant-price-actions" data-price-clear-control hidden={v.priceMinor == null}>
                <button type="button" class="admin-btn admin-btn-text admin-btn-sm admin-btn-text-danger" data-clear-price-toggle>Remove price</button>
                <span class="admin-inline-status" data-clear-price-status hidden>Price will be removed when you save.</span>
              </div>
              <div class="admin-columns-2">
                <div class="admin-field">
                  <label class="sr-only">Inventory quantity</label>
                  <input data-field="inventoryQuantity" type="number" min="0" step="1" placeholder="Inventory quantity" value={v.inventoryQuantity ?? ''} />
                </div>
                <div class="admin-field">
                  <label class="sr-only">Low stock threshold</label>
                  <input data-field="lowStockThreshold" type="number" min="0" step="1" placeholder="Low stock threshold (optional)" value={v.lowStockThreshold ?? ''} />
                </div>
              </div>
              <div class="admin-repeat-row-actions">
                <button type="button" class="admin-btn admin-btn-text admin-btn-sm" data-move-up aria-label="Move up">&uarr;</button>
                <button type="button" class="admin-btn admin-btn-text admin-btn-sm" data-move-down aria-label="Move down">&darr;</button>
                <button type="button" class="admin-btn admin-btn-text admin-btn-sm" data-remove-row>Remove</button>
              </div>
            </div>
          ))}
        </div>
        <p class="admin-empty-note" data-empty-note hidden>No variants yet.</p>
        <button type="button" class="admin-btn admin-btn-secondary admin-btn-sm" data-add-row="variants" data-template="variant-row">+ Add variant</button>
        <p class="admin-hint" style="margin-top: 0.75rem;">Leaving price or inventory fields blank leaves any existing pricing/inventory for that variant untouched.</p>
      </section>

      <section class="admin-card">
        <h3 class="admin-card-title">Images</h3>
        <p class="admin-card-subtitle">The primary image is editable below. Width/height are measured automatically from the URL when you save.</p>

        {product?.image?.url && (
          <img src={product.image.url} alt={product.image.altVi} class="product-form-image-preview" loading="lazy" />
        )}

        <div class="admin-field">
          <label for="imageUrl">Primary image URL <span class="admin-optional">optional</span></label>
          <input id="imageUrl" name="imageUrl" type="url" placeholder="https://..." value={product?.image?.url ?? ''} />
          <p class="admin-hint">Leave blank for no image.</p>
        </div>
        <div class="admin-columns-2">
          <div class="admin-field">
            <label for="imageAltVi">Alt text (VI)</label>
            <input id="imageAltVi" name="imageAltVi" type="text" value={product?.image?.altVi ?? ''} />
          </div>
          <div class="admin-field">
            <label for="imageAltZh">Alt text (ZH)</label>
            <input id="imageAltZh" name="imageAltZh" type="text" value={product?.image?.altZh ?? ''} />
          </div>
        </div>

        <p class="admin-readonly-group-label" style="margin-top: 1rem;">Gallery images</p>
        <div class="admin-repeat-list admin-repeat-list-stack" data-repeat-list="galleryImages">
          {galleryImages.map((img) => (
            <div class="admin-repeat-row admin-repeat-row-block" data-row>
              <input type="hidden" data-field="id" value={img.id} />
              <img data-preview src={img.url} alt="" loading="lazy" class="admin-repeat-row-image-preview" />
              <div class="admin-field">
                <label class="sr-only">Image URL</label>
                <input data-field="url" type="url" placeholder="https://..." value={img.url} />
              </div>
              <div class="admin-columns-2">
                <div class="admin-field">
                  <label class="sr-only">Alt text (VI)</label>
                  <input data-field="altVi" type="text" placeholder="Alt text (VI)" value={img.altVi ?? ''} />
                </div>
                <div class="admin-field">
                  <label class="sr-only">Alt text (ZH)</label>
                  <input data-field="altZh" type="text" placeholder="Alt text (ZH)" value={img.altZh ?? ''} />
                </div>
              </div>
              <div class="admin-repeat-row-actions">
                <button type="button" class="admin-btn admin-btn-text admin-btn-sm" data-move-up aria-label="Move up">&uarr;</button>
                <button type="button" class="admin-btn admin-btn-text admin-btn-sm" data-move-down aria-label="Move down">&darr;</button>
