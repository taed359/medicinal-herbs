              </div>
            </div>
          ))}
        </div>
        <p class="admin-empty-note" data-empty-note hidden>No gallery images yet.</p>
        <button type="button" class="admin-btn admin-btn-secondary admin-btn-sm" data-add-row="galleryImages" data-template="gallery-image-row">+ Add image</button>
        <p class="admin-hint" style="margin-top: 0.75rem;">Width/height are measured automatically from each URL when you save. No file upload -- this project has no S3-compatible storage wired in yet, so images are managed by URL only.</p>
      </section>
    </div>

    <div class="product-form-sidebar">
      <section class="admin-card">
        <h3 class="admin-card-title">Status</h3>
        <label class="admin-checkbox-row">
          <input id="isPublished" name="isPublished" type="checkbox" checked={product?.isPublished ?? false} data-status-checkbox />
          Published
        </label>
        <p class="admin-hint">Unpublished (draft) products are hidden from the storefront.</p>
        <label class="admin-checkbox-row" style="margin-top: 0.85rem;">
          <input id="isFeatured" name="isFeatured" type="checkbox" checked={product?.isFeatured ?? false} />
          Featured
        </label>
      </section>

      <section class="admin-card">
        <h3 class="admin-card-title">Organization</h3>
        <div class="admin-field">
          <label for="categoryId">Category <span class="admin-required-mark" aria-hidden="true">*</span></label>
          <select id="categoryId" name="categoryId" required>
            {categories.map((c) => (
              <option value={c.id} selected={product?.categoryId === c.id}>{c.name}</option>
            ))}
          </select>
        </div>
        <div class="admin-field">
          <label for="sortOrder">Sort order</label>
          <input id="sortOrder" name="sortOrder" type="number" min="0" step="1" value={product?.sortOrder ?? 0} />
          <p class="admin-hint">Lower numbers appear first within the category.</p>
        </div>
      </section>

      {mode === 'edit' && product && (
        <section class="admin-card">
          <h3 class="admin-card-title">Metadata</h3>
          <dl class="admin-meta-list">
            <div><dt>Created</dt><dd>{formatDate(product.createdAt)}</dd></div>
            <div><dt>Last updated</dt><dd>{formatDate(product.updatedAt)}</dd></div>
            <div><dt>Product ID</dt><dd class="admin-meta-mono">{product.id}</dd></div>
          </dl>
        </section>
      )}

      {mode === 'edit' && (
        <section class="admin-card admin-danger-zone">
          <h3 class="admin-card-title">Danger zone</h3>
          <p class="admin-card-subtitle">Deleting a product also removes its images, variants, pricing, inventory, benefits, warnings, and certifications.</p>
          <button type="button" id="delete-product-button" class="admin-btn admin-btn-danger" data-delete-url={deleteUrl}>
            Delete product
          </button>
        </section>
      )}
    </div>
  </div>
</form>

