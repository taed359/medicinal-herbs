---
import { getTranslations, type Locale } from '../i18n/utils';

interface Props {
  lang: Locale;
}

const { lang } = Astro.props;
const t = getTranslations(lang);

// Order fixed here (not derived from Object.keys) so markup order matches
// the ICON_ORDER below deterministically, independent of key insertion
// order in the i18n dictionaries.
const ITEM_ORDER = ['tga', 'nsf', 'gmp', 'fda', 'fingerprinting'] as const;

const items = ITEM_ORDER.map((key) => ({
  key,
  ...t.trustCertifications.items[key],
}));
---

<section class="tc-section py-8 sm:py-10" aria-labelledby="trust-certifications-heading">
  <div class="container-page">
    <!-- Header -->
    <div class="text-center mb-7 sm:mb-9">
      <p class="tc-eyebrow m-0 mb-1">{t.trustCertifications.eyebrow}</p>
      <h2 id="trust-certifications-heading" class="tc-heading font-serif m-0">{t.trustCertifications.heading}</h2>
    </div>

    <!-- Cards: horizontal scroll-snap on mobile, responsive grid from sm upward -->
    <div
      class="tc-scroll flex gap-4 overflow-x-auto sm:grid sm:gap-5 sm:overflow-visible sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-5"
      tabindex="0"
      role="group"
      aria-label={t.trustCertifications.ariaLabel}
    >
      {items.map((item) => (
        <article class="tc-card">
          <span class="tc-icon" aria-hidden="true">
            {item.key === 'tga' && (
              <svg width="34" height="34" viewBox="0 0 24 24" fill="none">
                <path d="M12 3l7 3v5c0 4.5-3 7.5-7 9-4-1.5-7-4.5-7-9V6l7-3Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
                <path d="M9 12.2l2 2 4-4.2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            )}
            {item.key === 'nsf' && (
              <svg width="34" height="34" viewBox="0 0 24 24" fill="none">
                <circle cx="12" cy="10.5" r="6.5" stroke="currentColor" stroke-width="1.5" />
                <path d="M9.3 10.6l1.8 1.8 3.6-3.8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                <path d="M9 16.3L7.5 21l4.5-2 4.5 2-1.5-4.7" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
              </svg>
            )}
            {item.key === 'gmp' && (
              <svg width="34" height="34" viewBox="0 0 24 24" fill="none">
                <path d="M4 20V11l4 2.5V11l4 2.5V11l4 2.5V7l4-2.5V20H4Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
                <path d="M4 20h16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
              </svg>
            )}
            {item.key === 'fda' && (
              <svg width="34" height="34" viewBox="0 0 24 24" fill="none">
                <path d="M5 21V10l7-5 7 5v11" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
                <path d="M9 21v-6h6v6" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
                <path d="M9.5 10.6l1.8 1.8 3.2-3.4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            )}
            {item.key === 'fingerprinting' && (
              <svg width="34" height="34" viewBox="0 0 24 24" fill="none">
                <path d="M20 4s-7 1-10 4-4 6-4 8 2 4 4 4 4-1 6-4 4-12 4-12Z" stroke="currentColor" stroke-width="1.5" />
                <circle cx="16" cy="7" r="1" fill="currentColor" />
                <circle cx="12" cy="12" r="1" fill="currentColor" />
                <circle cx="9" cy="17" r="1" fill="currentColor" />
                <path d="M16 7l-4 5-3 5" stroke="currentColor" stroke-width="1" stroke-linecap="round" />
              </svg>
            )}
          </span>
          <h3 class="tc-title font-serif m-0 mt-4">{item.title}</h3>
          <p class="tc-subtitle m-0 mt-1">{item.subtitle}</p>
          <p class="tc-description m-0 mt-2">{item.description}</p>
        </article>
      ))}
    </div>

    <!-- Disclaimer -->
    <p class="tc-disclaimer mx-auto mt-8 sm:mt-10">{t.trustCertifications.disclaimer}</p>
  </div>
</section>

<style>
  .tc-eyebrow { color: var(--color-brand); font-size: 1.25rem; font-weight: 600; letter-spacing: 0.02em; }
  @media (min-width: 640px) { .tc-eyebrow { font-size: 1.375rem; } }

  /* line-height 1.25, not the usual 1.15 -- this heading's VI copy
     measures ~366px at this font-size (Playfair Display Bold) against a
     ~343px mobile column, so it reliably wraps to 2 lines; see
     BrandStory.astro's .bs-heading comment for the full reasoning. */
  .tc-heading { color: var(--color-heading); font-size: 1.75rem; font-weight: 700; line-height: 1.25; }
  @media (min-width: 640px) { .tc-heading { font-size: 2.25rem; } }

  /* Mobile: horizontal scroll-snap track, ~1.2-1.4 cards visible.
     From `sm` up, the container switches to `display:grid` (via Tailwind
     classes on the element) and these flex/scroll rules become inert. */
  .tc-scroll {
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-bottom: 0.25rem;
  }
  .tc-scroll::-webkit-scrollbar {
    display: none;
  }
  .tc-scroll:focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: 2px;
  }

  .tc-card {
    color: var(--color-body);
    background: var(--color-cream);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card, 12px);
    box-shadow: var(--shadow-card);
    padding: 1.75rem 1.25rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    min-height: 260px;
    transition: box-shadow 0.25s ease, transform 0.25s ease;

    /* Mobile flex-item sizing: ~1.2-1.4 cards visible, snap-aligned. */
    flex: 0 0 78%;
    scroll-snap-align: start;
  }
  @media (min-width: 480px) {
    .tc-card {
      flex-basis: 62%;
    }
  }
  @media (min-width: 640px) {
    .tc-card {
      flex: unset;
      scroll-snap-align: unset;
    }
  }
  .tc-card:hover,
  .tc-card:focus-within {
    box-shadow: var(--shadow-card-hover);
    transform: translateY(-2px);
  }

  .tc-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 9999px;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    color: var(--color-brand);
    flex-shrink: 0;
  }

  .tc-title {
    color: var(--color-brand);
    font-size: 1.125rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .tc-subtitle {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-heading);
  }

  .tc-description {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-body);
    max-width: 26ch;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }

  .tc-disclaimer {
    max-width: 42rem;
    text-align: center;
    font-size: 0.8125rem;
    font-style: italic;
    color: var(--color-body);
    line-height: 1.6;
  }

  @media (prefers-reduced-motion: reduce) {
    .tc-card {
      transition: none;
    }
    .tc-scroll {
      scroll-behavior: auto;
    }
  }
</style>
