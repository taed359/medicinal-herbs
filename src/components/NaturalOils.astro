---
import type { Locale } from '../i18n/utils';
import { getTranslations, localePath } from '../i18n/utils';
import type { ProductSummaryView } from '../domain/types';
import { naturalOilsPlaceholderImage } from '../lib/product-image-fallback';
import HerbProductCard from './HerbProductCard.astro';

interface Props {
  lang: Locale;
  items: ProductSummaryView[];
}
const { lang, items } = Astro.props;
const t = getTranslations(lang);

// Mirrors ProductDetail.astro's own formatPrice exactly (duplicated
// rather than extracted into a shared lib, to avoid touching that file
// in this pass) -- priceMinor is a whole VND amount, not divided by 100.
function formatPrice(minorUnits: number, currency: string, locale: Locale): string {
  return new Intl.NumberFormat(locale === 'zh' ? 'zh-CN' : 'vi-VN', {
    style: 'currency',
    currency,
    maximumFractionDigits: 0,
  }).format(minorUnits);
}

// Of the 4 real featured products this section queries (coconut/
// sunflower/sesame/olive oil), only coconut oil currently has a seeded
// price (see seed-coconut-oil-content.ts) -- the other 3 have
// priceMinor === null. A card with a real price + a real default variant
// gets a working "Add to cart" button (wired client-side below); a card
// without a price gets a "Contact us" link instead, the same rule
// ProductDetail.astro's own `hasPrice` check already uses -- never a
// fake price or a button that would just 404 against a nonexistent
// pricing row.
const products = items.map((p) => ({
  ...p,
  formattedPrice: p.priceMinor != null ? formatPrice(p.priceMinor, p.currency ?? 'VND', lang) : undefined,
  href: localePath(lang, `${t.naturalOils.collectionPath}/${p.slug}`),
  canAddToCart: p.priceMinor != null && p.variantId != null,
}));

const categoryLabel = t.naturalOils.eyebrow;
---
<section id="products" class="natural-oils-section" aria-labelledby="natural-oils-heading">
  <div class="container-editorial">
    <div class="no-header">
      <div>
        <p class="no-eyebrow eyebrow m-0">{t.naturalOils.eyebrow}</p>
        <h2 id="natural-oils-heading" class="no-heading text-heading-section font-serif m-0">{t.naturalOils.heading}</h2>
      </div>

      <!-- Real destination: /{lang}/products/natural-oils/ (the paginated
           collection listing already exists at src/pages/{lang}/products/
           natural-oils/[...page].astro). -->
      <a href={localePath(lang, t.naturalOils.collectionPath)} data-astro-reload class="no-view-all btn-tertiary no-underline hover:no-underline">
        {t.naturalOils.ctaViewAll}
        <span class="btn-tertiary-arrow" aria-hidden="true">→</span>
      </a>
    </div>

    <!-- Products only: mobile horizontal scroll, grid from sm+ (2 cols), 4 cols on lg. -->
    <ul
      class="no-track m-0 flex list-none gap-4 overflow-x-auto p-0 sm:grid sm:grid-cols-2 sm:overflow-visible lg:grid-cols-4"
      role="list"
      tabindex="0"
    >
      {products.map((p) => {
        const isPlaceholder = !p.primaryImage;
        const image = p.primaryImage?.url ?? naturalOilsPlaceholderImage.src;
        const alt = p.primaryImage?.alt || p.name;
        return (
          <li class="no-slide h-full">
            <HerbProductCard
              lang={lang}
              name={p.name}
              categoryLabel={categoryLabel}
              href={p.href}
              image={image}
              alt={alt}
              isPlaceholder={isPlaceholder}
              formattedPrice={p.formattedPrice}
              variantId={p.variantId}
              canAddToCart={p.canAddToCart}
            />
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .natural-oils-section {
    /* Stage 2N: compact "denser" tier -- 1.25/1.5/1.75rem across
       breakpoints, down from 4/5/5.5rem. Two adjacent sections in this
       tier now combine to a 56px total gap (was ~176-184px), and against
       the "relaxed" tier (BrandStory/TrustCertifications, 1.5/1.75/2rem)
       combine to 60px -- both within the requested 48-64px range. */
    padding-block: 1.25rem;
    background: var(--color-cream);
  }

  .no-header {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 2.75rem;
  }

  .no-eyebrow {
    margin-bottom: 0.625rem;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  .no-heading.text-heading-section {
    font-size: 2.125rem;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .no-view-all {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0 0 0.125rem;
    border-bottom: 1px solid var(--color-pine-dark);
    color: var(--color-pine-dark);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.5;
    white-space: nowrap;
  }

  /* Mobile horizontal carousel for products -- unchanged from before this
     pass. */
  .no-track { scroll-snap-type: x mandatory; -webkit-overflow-scrolling: touch; scrollbar-width: none; }
  .no-track::-webkit-scrollbar { display: none; }
  .no-slide { flex: 0 0 82%; scroll-snap-align: start; }
  @media (min-width: 480px) { .no-slide { flex-basis: 68%; } }
  @media (min-width: 640px) {
    .natural-oils-section { padding-block: 1.5rem; }
    .no-track { gap: 1.375rem; }
    .no-slide { flex: unset; scroll-snap-align: unset; }
  }

  @media (min-width: 1024px) {
    .natural-oils-section { padding-block: 1.75rem; }
  }

  html[lang="zh"] .no-heading.text-heading-section { letter-spacing: 0; }
</style>
