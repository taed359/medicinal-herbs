---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import type { Locale } from '../i18n/utils';
import { getTranslations, localePath } from '../i18n/utils';
import type { HRKey } from '../lib/health-reads-slugs';

export type { HRKey };

interface Props {
  lang: Locale;
  articleKey: HRKey;
  // All four images, keyed the same way HealthReads.astro keys them --
  // the route file already has all four (it needs them for its own
  // getStaticPaths slug map), so this page reuses them for both its own
  // hero image and the "other articles" thumbnails instead of every
  // caller re-importing a subset.
  images: Record<HRKey, ImageMetadata>;
}
const { lang, articleKey, images } = Astro.props;
const t = getTranslations(lang);
const article = t.healthReads.items[articleKey];
const title = `${article.title} — ${t.common.siteName}`;

// Fixed display order, independent of object key iteration order --
// matches the order HealthReads.astro itself lists the four articles in.
const ORDER: HRKey[] = ['childrensHealth', 'chronicIllness', 'womensHealth', 'tcmBasics'];
const otherKeys = ORDER.filter((k) => k !== articleKey);

// No health-reads index route exists yet (see HealthReads.astro's own
// route-status comment) -- the section lives on the homepage instead, at
// the #health-reads-heading anchor HealthReads.astro renders. "Back to
// list" and the breadcrumb's middle (unlinked) item both point at real,
// working destinations rather than a page that doesn't exist.
const homeHref = localePath(lang, '');
const sectionHref = `${homeHref}#health-reads-heading`;
---
<Layout lang={lang} uiLang={lang} htmlLang={lang} title={title} description={article.description}>
  <section class="hrd-page py-8 sm:py-10" aria-labelledby="hrd-title">
    <div class="container-page">
      <Breadcrumbs
        lang={lang}
        class="mb-6 sm:mb-8"
        items={[
          { label: t.productDetail.breadcrumbHome, href: homeHref },
          { label: t.healthReads.heading, href: sectionHref },
          { label: article.title, current: true },
        ]}
      />

      <header class="hrd-header text-center">
        <p class="eyebrow m-0 mb-2">{t.healthReads.eyebrow}</p>
        <h1 id="hrd-title" class="hrd-title font-serif m-0">{article.title}</h1>
        <p class="hrd-description m-0 mt-3">{article.description}</p>
      </header>

      <div class="hrd-media mt-7 sm:mt-9">
        <Image src={images[articleKey]} alt="" width={960} height={540} loading="eager" decoding="async" class="h-full w-full object-cover" />
      </div>

      <article class="hrd-body mt-8 sm:mt-10" set:html={article.bodyHtml} />

      <div class="hrd-back mt-9 sm:mt-11">
        <a href={sectionHref} data-astro-reload class="hrd-back-link">
          <span aria-hidden="true">←</span> {t.healthReads.backToList}
        </a>
      </div>

      <div class="hrd-other mt-10 sm:mt-14">
        <h2 class="hrd-other-heading font-serif m-0 mb-5 sm:mb-6">{t.healthReads.otherArticlesHeading}</h2>
        <ul class="hrd-other-list m-0 p-0 list-none" role="list">
          {otherKeys.map((key) => {
            const other = t.healthReads.items[key];
            const href = localePath(lang, `health-reads/${other.slug}`);
            return (
              <li class="hrd-other-item">
                <a href={href} data-astro-reload aria-label={other.title} class="hrd-other-link group">
                  <span class="hrd-other-thumb">
                    <Image src={images[key]} alt="" width={220} height={220} loading="lazy" decoding="async" class="h-full w-full object-cover" />
                  </span>
                  <span class="hrd-other-text">
                    <h3 class="text-heading-card font-serif m-0">
                      {other.title}
                      <span class="hrd-other-arrow" aria-hidden="true"> →</span>
                    </h3>
                    <p class="hrd-other-description m-0 mt-1">{other.description}</p>
                  </span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    </div>
  </section>
</Layout>

<style>
  /* Same restrained editorial palette HealthReads.astro itself uses
     (pine/amber/cream tokens), not PrivacyPolicyPage.astro's older
     heading/brand tokens -- this page is reached only from HealthReads,
     so it should look like a continuation of that section, not a
     different, older page family. */
  .hrd-header .eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    color: var(--color-amber);
  }
  html[lang="zh"] .hrd-header .eyebrow { letter-spacing: 0; }

  .hrd-title {
    max-width: 42rem;
    margin-inline: auto;
    color: var(--color-pine-dark);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  html[lang="zh"] .hrd-title { letter-spacing: 0; line-height: 1.4; }

  .hrd-description {
    max-width: 38rem;
    margin-inline: auto;
    color: var(--color-body);
    font-size: 1rem;
    line-height: 1.65;
  }

  .hrd-media {
    aspect-ratio: 16 / 9;
    max-width: 48rem;
    margin-inline: auto;
    overflow: hidden;
    border-radius: var(--radius-editorial);
    border: 1px solid color-mix(in srgb, var(--color-pine-dark) 11%, var(--color-paper-2));
    background: var(--color-paper-2);
  }

  .hrd-body {
    max-width: 42rem;
    margin-inline: auto;
    color: var(--color-body);
    font-size: 1rem;
    line-height: 1.75;
    overflow-wrap: anywhere;
  }
  .hrd-body :global(h2) {
    margin: 2.25rem 0 1.125rem;
    color: var(--color-pine-dark);
    font-family: var(--font-serif);
    font-size: clamp(1.25rem, 2.5vw, 1.5rem);
    font-weight: 500;
    line-height: 1.3;
  }
  .hrd-body :global(p) {
    margin: 0 0 1.125rem;
  }
  .hrd-body :global(strong) {
    color: var(--color-pine-dark);
    font-weight: 700;
  }
  .hrd-body :global(ul),
  .hrd-body :global(ol) {
    margin: 0 0 1.125rem;
    padding-inline-start: 1.375rem;
  }
  .hrd-body :global(li + li) {
    margin-top: 0.5rem;
  }

  .hrd-back {
    max-width: 42rem;
    margin-inline: auto;
    text-align: center;
  }
  .hrd-back-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4375rem;
    color: var(--color-pine-dark);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration: none;
    padding-bottom: 0.1875rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-pine-dark) 35%, transparent);
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .hrd-back-link:hover,
  .hrd-back-link:focus-visible {
    color: var(--color-amber);
    border-color: var(--color-amber-decorative);
  }
  .hrd-back-link:focus-visible {
    outline: 2px solid var(--color-pine);
    outline-offset: 3px;
    border-radius: 2px;
  }

  /* ---------- Other articles: same divided-row treatment as
     HealthReads.astro's own .hr-list/.hr-row, reused here at a slightly
     narrower measure since this page's content column is already capped
     at 42rem above. ---------- */
  .hrd-other {
    max-width: 48rem;
    margin-inline: auto;
    border-top: 1px solid color-mix(in srgb, var(--color-pine-dark) 11%, var(--color-surface));
    padding-top: 2rem;
  }
  .hrd-other-heading {
    text-align: center;
    color: var(--color-pine-dark);
    font-size: 1.375rem;
    font-weight: 500;
    line-height: 1.3;
  }
  html[lang="zh"] .hrd-other-heading { letter-spacing: 0; }

  .hrd-other-item {
    border-bottom: 1px solid color-mix(in srgb, var(--color-pine-dark) 11%, var(--color-surface));
  }
  .hrd-other-link {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding-block: 1.125rem;
    padding-inline: 0.75rem;
    margin-inline: -0.75rem;
    border-radius: var(--radius-editorial);
    text-decoration: none;
    color: inherit;
    transition: background-color 0.2s ease;
  }
  .hrd-other-link:hover,
  .hrd-other-link:focus-visible {
    background-color: color-mix(in oklab, var(--color-amber-decorative) 7%, transparent);
  }
  .hrd-other-link:focus-visible {
    outline: 2px solid var(--color-pine);
    outline-offset: 3px;
  }
  .hrd-other-thumb {
    display: block;
    flex-shrink: 0;
    width: 4.5rem;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-pine-dark) 10%, var(--color-surface));
    border-radius: var(--radius-editorial);
  }
  .hrd-other-text { min-width: 0; }
  .hrd-other-text .text-heading-card {
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.4;
  }
  .hrd-other-description {
    max-width: 34rem;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-body);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }
  .hrd-other-arrow {
    display: inline-block;
    color: var(--color-amber);
    opacity: 0.7;
    transition: opacity 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }
  .group:hover .hrd-other-arrow,
  .group:focus-visible .hrd-other-arrow {
    color: var(--color-pine);
    opacity: 1;
    transform: translateX(2px);
  }
</style>
