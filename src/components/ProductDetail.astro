---
import type { Locale } from '../i18n/utils';
import { getTranslations, localePath } from '../i18n/utils';
import Breadcrumbs from './Breadcrumbs.astro';
import ProductCard from './ProductCard.astro';
import type { ProductDetailView, ProductSummaryView } from '../domain/types';
import { naturalOilsPlaceholderImage } from '../lib/product-image-fallback';
import { Image } from 'astro:assets';
import { formatExtractionMethod, formatCountryOfOrigin, formatCertType } from '../lib/product-metadata-labels';

interface Props {
  lang: Locale;
  product: ProductDetailView;
  // Same category, published, excluding this product -- fetched by the
  // page (see [slug].astro) via productRepository.listByCategory, same
  // real repository method NaturalOils.astro's own featured-products grid
  // already relies on. Optional/defaults to empty so this component still
  // renders correctly for any caller that doesn't pass it.
  relatedProducts?: ProductSummaryView[];
}
const { lang, product, relatedProducts = [] } = Astro.props;
const t = getTranslations(lang);

const name = product.name;
const catLabel = t.naturalOils.eyebrow;
const backHref = localePath(lang, t.naturalOils.collectionPath);

const primaryImage = product.images.find((img) => img.role === 'primary') ?? product.images[0] ?? null;

// No variant/pricing/inventory data exists yet for any product (nothing
// was invented during the DB migration — see seed-natural-oils.ts). The
// purchase/SKU/price block below stays hidden until a real variant with
// real pricing is entered; this is intentional, not a bug. The repository
// (product-repository.ts) already tolerates a product with zero variant
// rows — `variants` is simply an empty array, never a hard requirement —
// so this page renders a complete, valid product page either way.
const defaultVariant = product.variants.find((v) => v.isDefault) ?? product.variants[0] ?? null;
const hasPrice = defaultVariant?.priceMinor != null;

function formatPrice(minorUnits: number, currency: string, locale: Locale): string {
  // priceMinor is stored as a whole VND amount (VND has no minor/fractional
  // unit in practice), so it's formatted directly, not divided by 100.
  return new Intl.NumberFormat(locale === 'zh' ? 'zh-CN' : 'vi-VN', {
    style: 'currency',
    currency,
    maximumFractionDigits: 0,
  }).format(minorUnits);
}

// Mirrors NaturalOils.astro's own `products = items.map(...)` exactly --
// same reason: most real products today have no seeded price yet, and
// ProductCard already omits its price block when `price` is undefined.
const relatedProductsList = relatedProducts.map((p) => ({
  ...p,
  formattedPrice: p.priceMinor != null ? formatPrice(p.priceMinor, p.currency ?? 'VND', lang) : undefined,
  formattedOriginalPrice:
    p.compareAtMinor != null ? formatPrice(p.compareAtMinor, p.currency ?? 'VND', lang) : undefined,
}));

// Which of the two content tabs ("Mo ta & Cach dung" / "Thanh phan") this
// product actually has data for -- only real fields (product.description,
// product.usage, product.ingredients), nothing invented. When just one
// side has content, the tab *list* is skipped entirely (see the template
// below) rather than rendering a single-item tab bar, since a tab strip
// with one already-active tab has nothing to switch between.
const hasDescriptionUsageTab = Boolean(product.description || product.usage);
const hasIngredientsTab = Boolean(product.ingredients);
const tabCount = [hasDescriptionUsageTab, hasIngredientsTab].filter(Boolean).length;

---
<section
  class:list={['py-8 sm:py-10', { 'pd-zh': lang === 'zh' }]}
  aria-labelledby="product-name"
>
  <div class="container-page">
    <Breadcrumbs
      lang={lang}
      class="mb-6 sm:mb-8"
      items={[
        { label: t.productDetail.breadcrumbHome, href: localePath(lang, '') },
        { label: catLabel, href: backHref },
        { label: name, current: true },
      ]}
    />

    <div class="grid grid-cols-1 items-start gap-8 lg:grid-cols-2 lg:gap-12 xl:gap-16">
      <div class="pd-gallery lg:sticky lg:top-28">
        <div class:list={['pd-gallery-stage', { 'pd-gallery-placeholder': !primaryImage }]}>
          <div class="pd-gallery-media">
            {
              primaryImage ? (
                <img
                  src={primaryImage.url}
                  alt={primaryImage.alt || name}
                  width={primaryImage.width}
                  height={primaryImage.height}
                  class="h-full w-full object-contain"
                  loading="eager"
                  decoding="async"
                  fetchpriority="high"
                />
              ) : (
                <Image
                  src={naturalOilsPlaceholderImage}
                  alt={name}
                  width={960}
                  height={960}
                  class="h-full w-full object-contain"
                  loading="eager"
                  decoding="async"
                  fetchpriority="high"
                />
              )
            }
          </div>
        </div>
      </div>

      <div class="pd-info">
        <p class="pd-eyebrow text-smm-0">{catLabel}</p>
        <h1 id="product-name" class="pd-title font-serif m-0 mt-3">{name}</h1>

        {hasPrice && defaultVariant && (
          <div class="pd-price-row mt-7">
            <span class="pd-price">{formatPrice(defaultVariant.priceMinor!, defaultVariant.currency ?? 'VND', lang)}</span>
            {defaultVariant.compareAtMinor != null && (
              <del class="pd-original-price">{formatPrice(defaultVariant.compareAtMinor, defaultVariant.currency ?? 'VND', lang)}</del>
            )}
          </div>
        )}

        {product.shortDescription && (
          <p class="pd-summary m-0 mt-7">{product.shortDescription}</p>
        )}

        {product.benefits.length > 0 && (
          <section class="mt-8" aria-labelledby="product-benefits">
            <h2 id="product-benefits" class="pd-section-title m-0">{t.productDetail.benefitsHeading}</h2>
            <ul class="pd-benefits m-0 mt-3 p-0 list-none">
              {product.benefits.map((benefit) => (
                <li>
                  <span class="pd-check" aria-hidden="true">✓</span>
                  <span>{benefit.text}</span>
                </li>
              ))}
            </ul>
          </section>
        )}

        {(product.botanicalName || product.countryOfOriginCode || product.extractionMethod || product.manufacturerName) && (
          <dl class="pd-origin mt-7">
            {product.botanicalName && (
              <div>
                <dt>{t.productDetail.botanicalNameLabel}</dt>
                <dd class="pd-botanical-name">{product.botanicalName}</dd>
              </div>
            )}
            {product.countryOfOriginCode && (
              <div>
                <dt>{t.productDetail.originLabel}</dt>
                <dd>{formatCountryOfOrigin(product.countryOfOriginCode, lang)}</dd>
              </div>
            )}
            {product.extractionMethod && (
              <div>
                <dt>{t.productDetail.extractionMethodLabel}</dt>
                <dd>{formatExtractionMethod(product.extractionMethod, lang)}</dd>
              </div>
            )}
            {product.manufacturerName && (
              <div>
                <dt>{t.productDetail.manufacturerLabel}</dt>
                <dd>{product.manufacturerName}</dd>
              </div>
            )}
          </dl>
        )}

        {product.certifications.length > 0 && (
          <section class="mt-8" aria-labelledby="product-certifications">
            <h2 id="product-certifications" class="pd-section-title m-0">{t.productDetail.certificationsHeading}</h2>
            <ul class="pd-certifications m-0 mt-3 p-0 list-none">
              {product.certifications.map((cert) => (
                <li>
                  <span class="pd-cert-type">{formatCertType(cert.certType)}</span>
                  {cert.issuingBody && <span class="pd-cert-issuer"> · {cert.issuingBody}</span>}
                </li>
              ))}
            </ul>
          </section>
        )}

        {defaultVariant && (
          <>
            <dl class="pd-meta mt-6">
              {defaultVariant.label && (
                <div>
                  <dt>{t.productDetail.packSizeLabel}</dt>
                  <dd>{defaultVariant.label}</dd>
                </div>
              )}
              <div>
                <dt>{t.productDetail.skuLabel}</dt>
                <dd>{defaultVariant.sku}</dd>
              </div>
            </dl>

            <form class="pd-purchase mt-8" onsubmit="return false">
              <label for="pdp-quantity" class="pd-quantity-label text-sm">
                {t.productDetail.quantityLabel}
              </label>
              <div class="pd-purchase-row">
                <div class="pd-quantity-control" data-quantity-control>
                  <button
                    type="button"
                    class="pd-quantity-button"
                    data-quantity-action="decrease"
                    aria-label={`${t.productDetail.quantityLabel} −`}
                  >−</button>
                  <input
                    id="pdp-quantity"
                    name="quantity"
                    type="number"
                    value="1"
                    min="1"
                    inputmode="numeric"
                    class="pd-quantity"
                  />
                  <button
                    type="button"
                    class="pd-quantity-button"
                    data-quantity-action="increase"
                    aria-label={`${t.productDetail.quantityLabel} +`}
                  >+</button>
                </div>
                <button type="submit" class="btn btn-primary pd-add-to-cart cursor-pointer">
                  {t.productDetail.addToCartLabel}
                </button>
              </div>
            </form>
          </>
        )}

        {(hasDescriptionUsageTab || hasIngredientsTab) && (
          <div class="pd-tabs mt-7" data-pd-tabs>
            {tabCount > 1 && (
              <div class="pd-tab-list" role="tablist" aria-label={t.productDetail.descriptionUsageTabLabel}>
                <button
                  type="button"
                  class="pd-tab"
                  role="tab"
                  id="pd-tab-desc"
                  aria-controls="pd-panel-desc"
                  aria-selected="true"
                  data-pd-tab-target="pd-panel-desc"
                >
                  {t.productDetail.descriptionUsageTabLabel}
                </button>
                <button
                  type="button"
                  class="pd-tab"
                  role="tab"
                  id="pd-tab-ingredients"
                  aria-controls="pd-panel-ingredients"
                  aria-selected="false"
                  data-pd-tab-target="pd-panel-ingredients"
                >
                  {t.productDetail.ingredientsLabel}
                </button>
              </div>
            )}

            <div class="pd-tab-panels">
              {hasDescriptionUsageTab && (
                <div class="pd-tab-panel" id="pd-panel-desc" role="tabpanel" aria-labelledby="pd-tab-desc">
                  {product.description && <p>{product.description}</p>}
                  {product.usage && <p>{product.usage}</p>}
                </div>
              )}
              {hasIngredientsTab && (
                <div
                  class="pd-tab-panel"
                  id="pd-panel-ingredients"
                  role="tabpanel"
                  aria-labelledby="pd-tab-ingredients"
                  hidden={hasDescriptionUsageTab}
                >
                  <p>{product.ingredients}</p>
                </div>
              )}
            </div>
          </div>
        )}

        {product.warnings.length > 0 && (
          <div class="pd-warnings mt-6" role="note">
            <p class="pd-warnings-label m-0">{t.productDetail.warningsLabel}</p>
            {product.warnings.map((warning) => (
              <p class="m-0 mt-2">{warning}</p>
            ))}
          </div>
        )}

        <div class="mt-9">
          <a href={backHref} data-astro-reload class="pd-back inline-flex items-center gap-2 no-underline text-sm">
            <span aria-hidden="true">←</span>
            <span>{t.productDetail.backToCollection}</span>
          </a>
        </div>
      </div>
    </div>

    {relatedProductsList.length > 0 && (
      <section class="pd-related mt-16 sm:mt-20" aria-labelledby="pd-related-heading">
        <p class="eyebrow m-0 mb-2">{t.relatedProducts.eyebrow}</p>
        <h2 id="pd-related-heading" class="text-heading-section font-serif m-0">{t.relatedProducts.heading}</h2>
        <ul class="pd-related-grid m-0 mt-6 grid list-none grid-cols-2 gap-4 p-0 sm:gap-5 lg:grid-cols-4" role="list">
          {relatedProductsList.map((p) => {
            const relatedHref = localePath(lang, `${t.naturalOils.collectionPath}/${p.slug}`);
            const isPlaceholder = !p.primaryImage;
            const relatedImage = p.primaryImage?.url ?? naturalOilsPlaceholderImage.src;
            const relatedAlt = p.primaryImage?.alt || p.name;
            return (
              <li class:list={['h-full', { 'no-placeholder': isPlaceholder }]}>
                <ProductCard
                  name={p.name}
                  category={catLabel}
                  href={relatedHref}
                  cta={t.product.ctaViewDetails}
                  image={relatedImage}
                  alt={relatedAlt}
                  price={p.formattedPrice}
                  originalPrice={p.formattedOriginalPrice}
                />
              </li>
            );
          })}
        </ul>
      </section>
    )}
  </div>
</section>

<style>
  .pd-gallery-stage {
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    overflow: hidden;
    padding: clamp(1.25rem, 5vw, 3.5rem);
    border: 1px solid color-mix(in oklab, var(--color-border) 62%, transparent);
    border-radius: var(--radius-card);
    background: var(--color-cream);
  }

  .pd-gallery-media {
    width: min(100%, 36rem);
    height: min(100%, 36rem);
  }

  /* Placeholder state only (no real product photo yet -- see primaryImage
     above): placeholder-bottle.svg already draws its own full-bleed
     border and centered icon as a finished tile, the same reasoning
     NaturalOils.astro's own .no-placeholder override already applies to
     its grid cards. .pd-gallery-stage's default padding (clamp(1.25rem,
     5vw, 3.5rem), see below) exists for a real product PHOTO that needs
     breathing room -- applied to the placeholder instead, it was shrinking
     the placeholder down into a small icon floating inside a mostly-empty
     box, doubled up with the SVG's own drawn border. Cut the padding way
     down so the SVG's border reads as the frame instead of a second one
     nested inside .pd-gallery-stage's, and match the same slight opacity
     used everywhere else this placeholder appears. */
  .pd-gallery-placeholder {
    padding: clamp(0.5rem, 2vw, 1rem);
  }
  .pd-gallery-placeholder .pd-gallery-media {
    opacity: 0.82;
  }

  .pd-info {
    min-width: 0;
    max-width: 35rem;
  }

  .pd-eyebrow {
    color: var(--color-brand);
    font-weight: 600;
    letter-spacing: 0.04em;
  }

  /* line-height 1.2, not 1.12 -- this is the largest heading on the site
     (up to 2.75rem) rendered in Playfair Display, whose own vertical
     metrics (hhea ascent+|descent| ~1.33em) need more room than 1.12 gives
     once a longer product name wraps to 2 lines; same reasoning as the
     storefront section headings (see BrandStory.astro's .bs-heading). */
  .pd-title {
    color: var(--color-heading);
    font-size: 2rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .pd-badge {
    display: inline-flex;
    align-items: center;
    min-height: 1.5rem;
    padding: 0.15rem 0.6rem;
    color: var(--color-brand);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: transparent;
    font-weight: 600;
  }

  .pd-price-row {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.9rem;
  }

  .pd-price {
    color: var(--color-brand);
    font-size: 1.875rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .pd-original-price {
    color: var(--color-muted);
    font-size: 0.95rem;
  }

  .pd-divider {
    width: 100%;
    height: 1px;
    background: var(--color-border);
  }

  .pd-summary {
    max-width: 52ch;
    color: var(--color-body);
    line-height: 1.75;
  }

  .pd-section-title,
  .pd-shipping-title {
    color: var(--color-heading);
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .pd-benefits {
    display: grid;
    gap: 0;
    color: var(--color-body);
    font-size: 0.925rem;
    line-height: 1.55;
  }

  .pd-benefits li {
    display: flex;
    align-items: flex-start;
    gap: 0.8rem;
    padding: 0.85rem 0;
  }

  .pd-benefits li + li {
    border-top: 1px solid color-mix(in oklab, var(--color-border) 68%, transparent);
  }

  .pd-check {
    color: var(--color-brand);
    font-size: 0.75rem;
    font-weight: 700;
    line-height: 1.9;
  }

  .pd-origin {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem 1.5rem;
    margin-bottom: 0;
    padding: 0;
  }

  .pd-origin div {
    min-width: 0;
  }

  .pd-origin dt {
    color: var(--color-body);
    font-size: 0.75rem;
    line-height: 1.4;
  }

  .pd-origin dd {
    margin: 0.35rem 0 0;
    color: var(--color-heading);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.45;
  }

  .pd-botanical-name {
    font-style: italic;
    font-weight: 500 !important;
  }

  .pd-certifications {
    display: grid;
    gap: 0;
    color: var(--color-body);
    font-size: 0.875rem;
    line-height: 1.55;
  }

  .pd-certifications li {
    padding: 0.6rem 0;
  }

  .pd-certifications li + li {
    border-top: 1px solid color-mix(in oklab, var(--color-border) 68%, transparent);
  }

  .pd-cert-type {
    color: var(--color-heading);
    font-weight: 600;
  }

  .pd-cert-issuer {
    color: var(--color-muted);
  }

  .pd-meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.5rem;
    margin-bottom: 0;
    padding: 0;
  }

  .pd-meta div {
    min-width: 0;
  }

  .pd-meta dt {
    color: var(--color-body);
    font-size: 0.75rem;
    line-height: 1.4;
  }

  .pd-meta dd {
    margin: 0.35rem 0 0;
    color: var(--color-heading);
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.45;
  }

  .pd-purchase {
    display: block;
  }

  .pd-quantity-label {
    display: block;
    margin-bottom: 0.6rem;
    color: var(--color-body);
    font-weight: 600;
  }

  .pd-purchase-row {
    display: grid;
    grid-template-columns: 6.25rem minmax(0, 1fr);
    gap: 0.7rem;
  }

  .pd-quantity-control {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr) 2rem;
    min-height: 3.375rem;
    overflow: hidden;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
  }

  .pd-quantity {
    min-width: 0;
    width: 100%;
    padding: 0;
    color: var(--color-heading);
    text-align: center;
    border: 0;
    background: transparent;
    appearance: textfield;
  }

  .pd-quantity::-webkit-inner-spin-button,
  .pd-quantity::-webkit-outer-spin-button {
    margin: 0;
    appearance: none;
  }

  .pd-quantity-button {
    padding: 0;
    color: var(--color-muted);
    border: 0;
    background: transparent;
    font: inherit;
    cursor: pointer;
    transition: color 180ms ease;
  }

  .pd-quantity-button:hover {
    color: var(--color-brand);
  }

  .pd-quantity-control:focus-within {
    outline: 2px solid var(--color-brand);
    outline-offset: 2px;
  }

  .pd-add-to-cart {
    width: 100%;
    min-height: 3.375rem;
    font-weight: 600;
  }

  .pd-shipping {
    display: flex;
    align-items: flex-start;
    gap: 0.8rem;
    padding: 1rem 0;
    color: var(--color-muted);
    border-top: 1px solid color-mix(in oklab, var(--color-border) 72%, transparent);
    border-bottom: 1px solid color-mix(in oklab, var(--color-border) 72%, transparent);
    font-size: 0.85rem;
    line-height: 1.55;
  }

  .pd-shipping > svg {
    flex: 0 0 auto;
    color: var(--color-muted);
  }

  /* Tabs: replaces the old <details> accordion. Two tabs max today
     ("Mo ta & Cach dung" combined, "Thanh phan") -- see the frontmatter
     comment on hasDescriptionUsageTab/hasIngredientsTab for why a third
     "Reviews" tab isn't here; there's no review data to show in one. */
  .pd-tab-list {
    display: flex;
    gap: 1.75rem;
    border-bottom: 1px solid var(--color-border);
  }

  .pd-tab {
    padding: 0 0 0.85rem;
    color: var(--color-muted);
    border: 0;
    border-bottom: 2px solid transparent;
    background: transparent;
    font: inherit;
    font-size: 0.925rem;
    font-weight: 700;
    cursor: pointer;
    transition: color 180ms ease, border-color 180ms ease;
  }

  .pd-tab:hover {
    color: var(--color-heading);
  }

  .pd-tab[aria-selected='true'] {
    color: var(--color-heading);
    border-bottom-color: var(--color-brand);
  }

  .pd-tab:focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: 2px;
  }

  .pd-tab-panels {
    padding-top: 1.25rem;
  }

  /* A lone panel (no tab list above it, tabCount === 1) still gets this
     same top padding rather than special-cased to zero -- it reads as a
     normal content block either way, and keeps the spacing identical to
     the two-tab case instead of jumping when a product later gains its
     missing field. */
  .pd-tab-panel p {
    margin: 0;
    color: var(--color-body);
    font-size: 0.875rem;
    line-height: 1.7;
  }

  .pd-tab-panel p + p {
    margin-top: 0.85rem;
  }

  /* Warnings: pulled out of the tabs entirely (unlike the old accordion,
     which buried them behind an extra click next to unrelated content) --
     always visible when they exist, styled as a quiet safety notice
     rather than another tab or collapsible. */
  .pd-warnings {
    padding: 1rem 1.15rem;
    border: 1px solid color-mix(in oklab, var(--color-border) 55%, transparent);
    border-left: 3px solid var(--color-brand);
    border-radius: var(--radius-badge, 6px);
    background: var(--color-cream);
  }

  .pd-warnings-label {
    color: var(--color-heading);
    font-size: 0.8rem;
    font-weight: 700;
  }

  .pd-warnings p {
    color: var(--color-body);
    font-size: 0.85rem;
    line-height: 1.6;
  }


  .pd-back {
    color: var(--color-body);
    transition: color 180ms ease;
  }

  .pd-back:hover {
    color: var(--color-brand);
  }

  .pd-back:focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: 4px;
    border-radius: var(--radius-badge);
  }

  .pd-zh .pd-eyebrow {
    letter-spacing: 0;
    text-transform: none;
  }

  .pd-zh .pd-summary,
  .pd-zh .pd-benefits,
  .pd-zh .pd-tab-panel p,
  .pd-zh .pd-warnings p {
    line-height: 1.8;
  }

  /* Related Products placeholder handling -- same reasoning as
     NaturalOils.astro's own .no-placeholder override (and
     .pd-gallery-placeholder above): ProductCard's default packshot
     padding (p-6 sm:p-8, see ProductCard.astro) is sized for a real
     photo, not the placeholder SVG that already draws its own border/
     icon. Unlike NaturalOils.astro this grid uses ProductCard's own
     unstyled look with no base .pc-image override, so there's no
     border-bottom to cancel here -- only the padding/opacity need it. */
  .pd-related .no-placeholder :global(.pc-img) {
    padding: 0;
    opacity: 0.82;
  }
  .pd-related .no-placeholder :global(.pc-card:hover .pc-img),
  .pd-related .no-placeholder :global(.pc-card:focus-visible .pc-img) {
    transform: none;
  }

  @media (min-width: 640px) {
    .pd-title { font-size: 2.5rem; }

    .pd-purchase-row {
      grid-template-columns: 8rem minmax(0, 1fr);
      gap: 0.85rem;
    }

    .pd-quantity-control {
      grid-template-columns: 2.5rem minmax(0, 1fr) 2.5rem;
    }
  }

  @media (min-width: 1024px) {
    .pd-title { font-size: 2.75rem; }
  }

  @media (max-width: 360px) {
    .pd-zh .pd-title { font-size: 1.75rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .pd-back,
    .pd-quantity-button,
    .pd-tab { transition: none; }
  }
</style>

<script>
  document.querySelectorAll('[data-quantity-control]').forEach((control) => {
    const input = control.querySelector('input[type="number"]');
    if (!(input instanceof HTMLInputElement)) return;

    control.querySelectorAll('[data-quantity-action]').forEach((button) => {
      button.addEventListener('click', () => {
        const action = button.getAttribute('data-quantity-action');
        action === 'increase' ? input.stepUp() : input.stepDown();
      });
    });
  });

  // Description/Ingredients tabs -- only wired up when a tab LIST exists
  // (tabCount > 1 in the frontmatter); a lone panel has no buttons here
  // to begin with, so this simply finds nothing and does nothing.
  document.querySelectorAll<HTMLElement>('[data-pd-tabs]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    if (tabs.length === 0) return;

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const targetId = tab.getAttribute('data-pd-tab-target');
        tabs.forEach((t) => t.setAttribute('aria-selected', String(t === tab)));
        root.querySelectorAll<HTMLElement>('[role="tabpanel"]').forEach((panel) => {
          panel.hidden = panel.id !== targetId;
        });
      });
    });
  });
</script>
