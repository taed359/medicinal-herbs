---
/**
 * Order confirmation page (/vi/checkout/confirmation,
 * /zh/checkout/confirmation) -- reached only via the redirect at the end
 * of CheckoutPage.astro's submit handler, which appends `?order=<orderNumber>
 * &email=<customerEmail>`. Both are required by GET /api/orders/:orderNumber
 * (see api/orders/[orderNumber].ts's doc comment) so an order number alone
 * -- guessable, short -- can never pull someone else's order.
 *
 * Fully client-rendered for the same reason as CartPage/CheckoutPage: this
 * is a prerendered static page, the order recap doesn't exist at build
 * time. Also triggers one fetchCart() on mount purely to refresh the
 * header badge/drawer -- placeOrder() clears the cart server-side, but
 * nothing client-side knows that until something re-fetches it.
 */
import Layout from '../layouts/Layout.astro';
import Breadcrumbs from './Breadcrumbs.astro';
import { defaultLocale, getTranslations, isLocale, localePath, type Locale, type RouteLocale } from '../i18n/utils';

interface Props {
  lang: RouteLocale;
  uiLang?: Locale;
}
const { lang, uiLang: requestedUiLang } = Astro.props;
const uiLang = requestedUiLang ?? (isLocale(lang) ? lang : defaultLocale);
const t = getTranslations(uiLang);
const homeHref = localePath(lang, '');
---
<Layout lang={lang} uiLang={uiLang} title={`${t.orderConfirmation.pageTitle} — ${t.common.siteName}`} noindex={true}>
  <section
    class="confirmation-page py-8 sm:py-10"
    aria-labelledby="confirmation-page-title"
    data-confirmation-page
    data-home-href={homeHref}
    data-status-pending-label={t.orderConfirmation.statusPendingLabel}
    data-cod-label={t.orderConfirmation.codLabel}
    data-bank-transfer-label={t.orderConfirmation.bankTransferLabel}
  >
    <div class="container-page">
      <Breadcrumbs
        lang={uiLang}
        class="mb-6"
        items={[
          { label: t.productDetail.breadcrumbHome, href: homeHref },
          { label: t.orderConfirmation.pageTitle, current: true },
        ]}
      />

      <div class="confirmation-loading" data-confirmation-loading aria-hidden="true">
        <div class="cart-skeleton-row"></div>
        <div class="cart-skeleton-row"></div>
      </div>

      <div class="confirmation-not-found" data-confirmation-not-found hidden>
        <p class="confirmation-not-found-heading font-serif">{t.orderConfirmation.notFoundHeading}</p>
        <p class="confirmation-not-found-body">{t.orderConfirmation.notFoundBody}</p>
        <a href={homeHref} data-astro-reload class="btn btn-primary mt-4">{t.orderConfirmation.continueShoppingButton}</a>
      </div>

      <div class="confirmation-content" data-confirmation-content hidden>
        <div class="confirmation-check" aria-hidden="true">
          <svg width="72" height="72" viewBox="0 0 24 24" fill="none">
            <circle cx="12" cy="12" r="11" fill="var(--color-brand)" />
            <path d="M7 12.5l3 3 7-7" stroke="var(--color-surface)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </div>
        <h1 id="confirmation-page-title" class="confirmation-heading font-serif">{t.orderConfirmation.heading}</h1>
        <p class="confirmation-thank-you" data-confirmation-thank-you data-template={t.orderConfirmation.thankYouBody}></p>

        <div class="confirmation-order-number-card">
          <span class="confirmation-order-number-label">{t.orderConfirmation.orderNumberLabel}</span>
          <div class="confirmation-order-number-row">
            <strong class="confirmation-order-number-value" data-confirmation-order-number></strong>
            <button
              type="button"
              class="confirmation-copy-btn"
              data-confirmation-copy-btn
              data-copy-label={t.orderConfirmation.copyOrderNumberLabel}
              data-copied-label={t.orderConfirmation.orderNumberCopiedLabel}
              aria-label={t.orderConfirmation.copyOrderNumberLabel}
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true" data-copy-icon>
                <rect x="9" y="9" width="12" height="12" rx="2" stroke="currentColor" stroke-width="2" />
                <path d="M6 15H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v1" stroke="currentColor" stroke-width="2" />
              </svg>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true" hidden data-copied-icon>
                <path d="M5 12.5l4.5 4.5L19 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <span class="confirmation-copy-btn-label-stack">
                <span data-copy-btn-label-copy>{t.orderConfirmation.copyOrderNumberLabel}</span>
                <span data-copy-btn-label-copied>{t.orderConfirmation.orderNumberCopiedLabel}</span>
              </span>
            </button>
          </div>
          <p class="confirmation-save-note">{t.orderConfirmation.saveOrderNumberNote}</p>
        </div>

        <div class="confirmation-layout">
          <div class="confirmation-main">
            <section class="confirmation-panel confirmation-panel--items" aria-labelledby="confirmation-items-heading">
              <div class="confirmation-items-heading-row">
                <div class="confirmation-panel-heading-group">
                  <span class="confirmation-panel-icon-badge" aria-hidden="true">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                      <path d="M6 8h12l-1 12H7L6 8Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                      <path d="M9 8V6a3 3 0 0 1 6 0v2" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                    </svg>
                  </span>
                  <h2 id="confirmation-items-heading" class="confirmation-panel-heading font-serif">{t.orderConfirmation.itemsHeading}</h2>
                </div>
                <span class="confirmation-items-count" data-confirmation-items-count aria-hidden="true"></span>
              </div>
              <ul class="confirmation-items" data-confirmation-items></ul>
              <div class="confirmation-totals">
                <div class="confirmation-panel-row">
                  <span>{t.orderConfirmation.subtotalLabel}</span>
                  <span data-confirmation-subtotal></span>
                </div>
                <div class="confirmation-panel-row">
                  <span>{t.orderConfirmation.shippingFeeLabel}</span>
                  <span data-confirmation-shipping-fee data-free-label={t.orderConfirmation.shippingFeeFreeLabel}></span>
                </div>
                <div class="confirmation-panel-row confirmation-total-row">
                  <span>{t.orderConfirmation.totalLabel}</span>
                  <span data-confirmation-total></span>
                </div>
              </div>
            </section>

            <section class="confirmation-panel confirmation-panel--compact" aria-labelledby="confirmation-order-heading">
              <div class="confirmation-panel-heading-group">
                <span class="confirmation-panel-icon-badge" aria-hidden="true">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                    <rect x="6" y="4" width="12" height="16" rx="2" stroke="currentColor" stroke-width="1.6" />
                    <path d="M9 4V3a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v1" stroke="currentColor" stroke-width="1.6" />
                    <path d="M9 11l2 2 4-4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
                <h2 id="confirmation-order-heading" class="confirmation-panel-heading font-serif">{t.orderConfirmation.orderStatusPanelHeading}</h2>
              </div>
              <div class="confirmation-panel-row">
                <span>{t.orderConfirmation.statusLabel}</span>
                <span class="confirmation-status-badge" data-confirmation-status></span>
              </div>
              <div class="confirmation-panel-row">
                <span>{t.orderConfirmation.paymentMethodLabel}</span>
                <strong data-confirmation-payment-method></strong>
              </div>
              <p class="confirmation-bank-note" data-confirmation-bank-note hidden>{t.orderConfirmation.bankTransferPlaceholderNote}</p>
            </section>
          </div>

          <aside class="confirmation-panel confirmation-shipping" aria-labelledby="confirmation-shipping-heading">
            <div class="confirmation-shipping-header">
              <div class="confirmation-shipping-icon" aria-hidden="true">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
                  <path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21Z" stroke="var(--color-brand)" stroke-width="1.6" stroke-linejoin="round" />
                  <circle cx="12" cy="9.5" r="2.4" stroke="var(--color-brand)" stroke-width="1.6" />
                </svg>
              </div>
              <h2 id="confirmation-shipping-heading" class="confirmation-panel-heading font-serif">{t.orderConfirmation.shippingToHeading}</h2>
            </div>

            <div class="confirmation-shipping-details">
              <div class="confirmation-shipping-row">
                <svg class="confirmation-shipping-row-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <circle cx="12" cy="8" r="3.2" stroke="currentColor" stroke-width="1.6" />
                  <path d="M5 20c0-3.6 3.1-6.5 7-6.5s7 2.9 7 6.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
                </svg>
                <span class="confirmation-shipping-name" data-confirmation-shipping-name></span>
              </div>
              <div class="confirmation-shipping-row">
                <svg class="confirmation-shipping-row-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M12 21s7-6.2 7-11.5A7 7 0 0 0 5 9.5C5 14.8 12 21 12 21Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                  <circle cx="12" cy="9.5" r="2.2" stroke="currentColor" stroke-width="1.6" />
                </svg>
                <span class="confirmation-shipping-line" data-confirmation-shipping-address></span>
              </div>
              <div class="confirmation-shipping-row">
                <svg class="confirmation-shipping-row-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="M4.5 5.5c0-.6.4-1 1-1H8c.5 0 .9.3 1 .8l.7 3a1 1 0 0 1-.3 1L8 10.7a12 12 0 0 0 5.3 5.3l1.4-1.4a1 1 0 0 1 1-.3l3 .7c.5.1.8.5.8 1v2.5c0 .6-.4 1-1 1C10.9 19.5 4.5 13.1 4.5 5.5Z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" />
                </svg>
                <a class="confirmation-shipping-line confirmation-shipping-phone" data-confirmation-shipping-phone></a>
              </div>
            </div>

            <button
              type="button"
              class="confirmation-copy-btn confirmation-shipping-copy-btn"
              data-confirmation-copy-address-btn
              data-copy-label={t.orderConfirmation.copyAddressLabel}
              data-copied-label={t.orderConfirmation.addressCopiedLabel}
              aria-label={t.orderConfirmation.copyAddressLabel}
            >
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true" data-copy-icon>
                <rect x="9" y="9" width="12" height="12" rx="2" stroke="currentColor" stroke-width="2" />
                <path d="M6 15H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v1" stroke="currentColor" stroke-width="2" />
              </svg>
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true" hidden data-copied-icon>
                <path d="M5 12.5l4.5 4.5L19 7" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <span class="confirmation-copy-btn-label-stack">
                <span data-copy-btn-label-copy>{t.orderConfirmation.copyAddressLabel}</span>
                <span data-copy-btn-label-copied>{t.orderConfirmation.addressCopiedLabel}</span>
              </span>
            </button>
          </aside>
        </div>

        <section class="confirmation-next-steps" aria-labelledby="confirmation-next-steps-heading">
          <h2 id="confirmation-next-steps-heading" class="confirmation-panel-heading font-serif">{t.orderConfirmation.nextStepsHeading}</h2>
          <ol class="confirmation-steps m-0 p-0">
            <li class="confirmation-step">
              <span class="confirmation-step-marker" aria-hidden="true">1</span>
              <span>
                <p class="confirmation-step-title">{t.orderConfirmation.nextStepProcessingTitle}</p>
                <p class="confirmation-step-body">{t.orderConfirmation.nextStepProcessingBody}</p>
              </span>
            </li>
            <li class="confirmation-step">
              <span class="confirmation-step-marker" aria-hidden="true">2</span>
              <span>
                <p class="confirmation-step-title">{t.orderConfirmation.nextStepDeliveryTitle}</p>
                <p class="confirmation-step-body">{t.orderConfirmation.nextStepDeliveryBody}</p>
              </span>
            </li>
          </ol>
        </section>

        <a href={homeHref} data-astro-reload class="btn btn-secondary confirmation-continue-btn">{t.orderConfirmation.continueShoppingButton}</a>
      </div>
    </div>
  </section>

  <template id="confirmation-item-template">
    <li class="confirmation-item">
      <div class="confirmation-item-image" data-item-image-wrap>
        <img data-item-image alt="" loading="lazy" decoding="async" />
      </div>
      <div class="confirmation-item-info">
        <p class="confirmation-item-name" data-item-name></p>
        <p class="confirmation-item-variant" data-item-variant></p>
        <p class="confirmation-item-qty" data-item-qty></p>
      </div>
      <div class="confirmation-item-total" data-item-total></div>
    </li>
  </template>
</Layout>

<script>
  import { fetchCart, formatMoney } from '../lib/cart-client';
  import type { OrderView } from '../domain/types';

  function initConfirmationPage() {
    const root = document.querySelector('[data-confirmation-page]');
    if (!(root instanceof HTMLElement) || root.dataset.initialized === 'true') return;
    root.dataset.initialized = 'true';

    const loadingState = root.querySelector('[data-confirmation-loading]');
    const notFoundState = root.querySelector('[data-confirmation-not-found]');
    const content = root.querySelector('[data-confirmation-content]');
    const thankYouEl = root.querySelector('[data-confirmation-thank-you]');
    const orderNumberEl = root.querySelector('[data-confirmation-order-number]');
    const statusEl = root.querySelector('[data-confirmation-status]');
    const paymentMethodEl = root.querySelector('[data-confirmation-payment-method]');
    const bankNoteEl = root.querySelector('[data-confirmation-bank-note]');
    const itemsList = root.querySelector('[data-confirmation-items]');
    const itemsCountEl = root.querySelector('[data-confirmation-items-count]');
    const subtotalEl = root.querySelector('[data-confirmation-subtotal]');
    const shippingFeeEl = root.querySelector('[data-confirmation-shipping-fee]');
    const totalEl = root.querySelector('[data-confirmation-total]');
    const shippingNameEl = root.querySelector('[data-confirmation-shipping-name]');
    const shippingAddressEl = root.querySelector('[data-confirmation-shipping-address]');
    const shippingPhoneEl = root.querySelector('[data-confirmation-shipping-phone]');
    const itemTemplate = document.getElementById('confirmation-item-template');
    const copyButton = root.querySelector('[data-confirmation-copy-btn]');
    const copyAddressButton = root.querySelector('[data-confirmation-copy-address-btn]');

    const statusPendingLabel = root.dataset.statusPendingLabel ?? '';
    const codLabel = root.dataset.codLabel ?? '';
    const bankTransferLabel = root.dataset.bankTransferLabel ?? '';

    function showNotFound() {
      if (loadingState instanceof HTMLElement) loadingState.hidden = true;
      if (notFoundState instanceof HTMLElement) notFoundState.hidden = false;
    }

    function renderItem(item: OrderView['items'][number], currency: string): Node | null {
      if (!(itemTemplate instanceof HTMLTemplateElement)) return null;
      const fragment = itemTemplate.content.cloneNode(true) as DocumentFragment;

      // Older orders placed before this snapshot existed (or whose
      // product had no primary image at purchase time) have `image: null`
      // -- remove the slot entirely rather than show a broken/empty img.
      const itemRoot = fragment.querySelector('.confirmation-item');
      const imageWrap = fragment.querySelector('[data-item-image-wrap]');
      const img = fragment.querySelector('[data-item-image]');
      if (img instanceof HTMLImageElement && item.image) {
        img.src = item.image.url;
        img.alt = item.image.alt || item.productName;
        img.width = item.image.width;
        img.height = item.image.height;
      } else {
        // No image slot for this row: drop the reserved image column too,
        // so the name/qty text gets the full row width instead of being
        // squeezed into a 3rem-wide grid track.
        if (imageWrap instanceof HTMLElement) imageWrap.remove();
        if (itemRoot instanceof HTMLElement) itemRoot.classList.add('confirmation-item--no-image');
      }

      const nameEl = fragment.querySelector('[data-item-name]');
      if (nameEl) nameEl.textContent = item.productName;
      const variantEl = fragment.querySelector('[data-item-variant]');
      if (variantEl instanceof HTMLElement) {
        if (item.variantLabel) variantEl.textContent = item.variantLabel;
        else variantEl.remove();
      }
      const qtyEl = fragment.querySelector('[data-item-qty]');
      if (qtyEl) qtyEl.textContent = `× ${item.quantity}`;
      const totalEl2 = fragment.querySelector('[data-item-total]');
      if (totalEl2) totalEl2.textContent = formatMoney(item.lineTotalMinor, currency);
      return fragment;
    }

    function render(o: OrderView) {
      if (
        !(loadingState instanceof HTMLElement) ||
        !(content instanceof HTMLElement) ||
        !(thankYouEl instanceof HTMLElement) ||
        !(orderNumberEl instanceof HTMLElement) ||
        !(statusEl instanceof HTMLElement) ||
        !(paymentMethodEl instanceof HTMLElement) ||
        !(itemsList instanceof HTMLElement) ||
        !(subtotalEl instanceof HTMLElement) ||
        !(shippingFeeEl instanceof HTMLElement) ||
        !(totalEl instanceof HTMLElement) ||
        !(shippingNameEl instanceof HTMLElement) ||
        !(shippingAddressEl instanceof HTMLElement) ||
        !(shippingPhoneEl instanceof HTMLAnchorElement)
      ) {
        return;
      }

      loadingState.hidden = true;
      content.hidden = false;

      thankYouEl.textContent = (thankYouEl.dataset.template ?? '').replace('{orderNumber}', o.orderNumber);
      orderNumberEl.textContent = o.orderNumber;
      statusEl.textContent = o.status === 'pending' ? statusPendingLabel : o.status;
      paymentMethodEl.textContent = o.paymentMethod === 'cod' ? codLabel : bankTransferLabel;
      if (bankNoteEl instanceof HTMLElement) bankNoteEl.hidden = o.paymentMethod !== 'bank_transfer';

      itemsList.innerHTML = '';
      for (const item of o.items) {
        const node = renderItem(item, o.currency);
        if (node) itemsList.appendChild(node);
      }
      if (itemsCountEl instanceof HTMLElement) {
        // Sum of quantities, not number of distinct product lines -- same
        // convention as the header cart badge (see cart-service.ts's
        // itemCount: items.reduce((sum, i) => sum + i.quantity, 0)), so a
        // single product bought x5 reads as "5" here too, not "1".
        const totalQuantity = o.items.reduce((sum, item) => sum + item.quantity, 0);
        itemsCountEl.textContent = String(totalQuantity);
      }

      subtotalEl.textContent = formatMoney(o.subtotalMinor, o.currency);
      shippingFeeEl.textContent = o.shippingFeeMinor > 0 ? formatMoney(o.shippingFeeMinor, o.currency) : (shippingFeeEl.dataset.freeLabel ?? '');
      totalEl.textContent = formatMoney(o.totalMinor, o.currency);

      const addressParts = [o.shippingAddressLine1, o.shippingWard, o.shippingDistrict, o.shippingProvince].filter(Boolean);
      shippingNameEl.textContent = o.customerName;
      shippingAddressEl.textContent = addressParts.join(', ');
      shippingPhoneEl.textContent = o.customerPhone;
      // Tap-to-call on mobile -- strip everything but digits and a leading
      // "+" so a phone number typed with spaces ("0901 234 567") still
      // produces a valid tel: URI.
      const dialablePhone = o.customerPhone.replace(/(?!^\+)[^\d]/g, '');
      shippingPhoneEl.href = dialablePhone ? `tel:${dialablePhone}` : '';
    }

    // Shared copy-to-clipboard wiring for both copy buttons on this page
    // (order number, shipping info) -- label text swap ("Sao chep" ->
    // "Da sao chep!") is CSS-driven via the .is-copied class (see
    // .confirmation-copy-btn-label-stack rules): both label strings stay
    // in the DOM at all times so each button's width is fixed to the
    // wider of the two from first paint, and clicking never changes the
    // button's width -- so the row it sits in never reflows/wraps the
    // moment the label changes.
    function wireCopyButton(button: Element | null, getValue: () => string) {
      if (!(button instanceof HTMLButtonElement)) return;
      const copyIcon = button.querySelector('[data-copy-icon]');
      const copiedIcon = button.querySelector('[data-copied-icon]');
      const copyLabel = button.dataset.copyLabel ?? '';
      const copiedLabel = button.dataset.copiedLabel ?? '';
      let resetTimer: ReturnType<typeof setTimeout> | null = null;

      button.addEventListener('click', async () => {
        const value = getValue();
        if (!value || !navigator.clipboard) return;
        try {
          await navigator.clipboard.writeText(value);
        } catch {
          return; // Clipboard permission denied/unavailable -- fail silently, never claim success.
        }
        button.classList.add('is-copied');
        button.setAttribute('aria-label', copiedLabel);
        if (copyIcon instanceof HTMLElement) copyIcon.hidden = true;
        if (copiedIcon instanceof HTMLElement) copiedIcon.hidden = false;
        if (resetTimer) clearTimeout(resetTimer);
        resetTimer = setTimeout(() => {
          button.classList.remove('is-copied');
          button.setAttribute('aria-label', copyLabel);
          if (copyIcon instanceof HTMLElement) copyIcon.hidden = false;
          if (copiedIcon instanceof HTMLElement) copiedIcon.hidden = true;
        }, 2000);
      });
    }

    // This project sends no confirmation EMAIL (see
    // src/server/email/customer-email.ts, which is auth-only), so this
    // page is the one place the customer can grab their order number
    // and shipping details from -- one-tap copy (mobile especially)
    // beats asking them to carefully select/retype text by hand.
    wireCopyButton(copyButton, () => (orderNumberEl instanceof HTMLElement ? orderNumberEl.textContent ?? '' : ''));
    wireCopyButton(copyAddressButton, () => {
      const name = shippingNameEl instanceof HTMLElement ? shippingNameEl.textContent ?? '' : '';
      const address = shippingAddressEl instanceof HTMLElement ? shippingAddressEl.textContent ?? '' : '';
      const phone = shippingPhoneEl instanceof HTMLElement ? shippingPhoneEl.textContent ?? '' : '';
      return [name, address, phone].filter(Boolean).join('\n');
    });

    const params = new URLSearchParams(window.location.search);
    const orderNumber = params.get('order');
    const email = params.get('email');

    if (!orderNumber || !email) {
      showNotFound();
    } else {
      fetch(`/api/orders/${encodeURIComponent(orderNumber)}?email=${encodeURIComponent(email)}`, { credentials: 'same-origin' })
        .then(async (res) => {
          if (!res.ok) {
            showNotFound();
            return;
          }
          const data = (await res.json()) as OrderView;
          render(data);
        })
        .catch(showNotFound);
    }

    // Cart was cleared server-side by placeOrder() -- refresh the header
    // badge/drawer so they reflect that without needing a full reload.
    fetchCart().catch(() => {});
  }

  initConfirmationPage();
  document.addEventListener('astro:page-load', initConfirmationPage);
</script>

<style>
  .confirmation-check {
    display: flex;
    justify-content: center;
    margin-bottom: 1rem;
    animation: confirmation-check-in 480ms cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }
  @keyframes confirmation-check-in {
    from { opacity: 0; transform: scale(0.6); }
    to { opacity: 1; transform: scale(1); }
  }

  .confirmation-heading {
    text-align: center;
    color: var(--color-heading);
    font-size: clamp(1.75rem, 4vw, 2.5rem);
    font-weight: 700;
    line-height: 1.2;
    margin: 0;
  }
  .confirmation-thank-you {
    text-align: center;
    color: var(--color-body);
    max-width: 46ch;
    margin: 0.75rem auto 0;
  }

  .confirmation-order-number-card {
    max-width: 26rem;
    margin: 1.75rem auto 0;
    padding: 1.25rem 1.5rem;
    border-radius: var(--radius-card);
    background: var(--color-cream);
    text-align: center;
  }
  .confirmation-order-number-label {
    display: block;
    font-size: 0.8125rem;
    color: var(--color-muted);
    font-weight: 600;
  }
  .confirmation-order-number-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 0.35rem;
