---

interface Goal { label: string; image?: string }
interface Props {
  title?: string;
  goals?: Goal[];
}
const { title = 'Shop by Health Goal', goals = [
  { label: 'Immunity' },
  { label: 'Energy & Vitality' },
  { label: 'Beauty' },
  { label: 'Sleep & Stress' },
] } = Astro.props;
---
<section class="container-page py-12 sm:py-16">
  <div class="mb-6 sm:mb-8">
    <h2 class="m-0">{title}</h2>
  </div>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6">
    {goals.map((g) => (
      <div class="group relative border border-gold/20 bg-cream hover:bg-cream/80 transition-colors" style="aspect-ratio: 4 / 3;">
        <img src={g.image ?? '/favicon.svg'} alt="" class="absolute inset-0 h-full w-full object-cover opacity-10 pointer-events-none select-none" aria-hidden="true" />
        <div class="absolute inset-0 flex items-end">
          <div class="p-4 sm:p-5">
            <span class="inline-block bg-white/70 text-body px-3 py-1 text-sm sm:text-base shadow-[0_1px_0_rgba(0,0,0,0.05)]">{g.label}</span>
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
