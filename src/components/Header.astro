---
import AnnouncementBar from './AnnouncementBar.astro';
import { getTranslations, localeHomePath, localePath, type Locale } from '../i18n/utils';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;

const t = getTranslations(lang);
const homeHref = localeHomePath(lang);

// Customer session state, read the same way every other part of this app
// reads it -- middleware already resolved it once and exposed it here.
// Every page that renders this Header today is fully static/prerendered
// (no `export const prerender = false`), so middleware never runs for it
// and this is always `undefined` in practice -- see the account-widget
// script below for why and how that's handled without forcing the
// storefront into on-demand rendering. This read stays correct (and free)
// on the day any page using this Header ever does become server-rendered.
const customerUser = Astro.locals.customerUser;
// `lang` here is already the site's fully-resolved storefront locale (see
// Layout.astro: uiLang falls back to defaultLocale='vi' for unprefixed/
// English pages, since Header's own Props type only ever accepts a real
// Locale, never 'en') -- so it's also exactly the value the customer auth
// pages' `?lang=` expects (see src/i18n/auth.ts's resolveAuthLocale,
// vi/zh only, defaulting to 'vi'). No separate path-based parsing needed.
const loginHref = `/customer/login?lang=${lang}&redirect=${encodeURIComponent(Astro.url.pathname)}`;
const accountHref = `/customer/account?lang=${lang}`;
---
<AnnouncementBar lang={lang} messages={t.header.announcement} />

<header class="sticky top-0 z-40 bg-surface">
  <!-- Main navbar -->
  <div class="bg-surface border-b border-border">
    <div class="container-page relative h-[80px] flex items-center justify-between gap-4">
      <button
        type="button"
        data-mobile-menu-open
        class="md:hidden inline-flex items-center justify-center w-9 h-9 cursor-pointer text-heading hover:text-brand transition-colors"
        aria-label={t.header.menuLabel}
        aria-expanded="false"
        aria-controls="mobile-navigation-drawer"
      >
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M4 6h16M4 12h16M4 18h16" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
        </svg>
      </button>

      <!-- Logo -->
      <a href={homeHref} data-astro-reload class="absolute left-1/2 -translate-x-1/2 flex flex-col leading-tight no-underline shrink-0 md:static md:translate-x-0">
        <span class="font-sans text-2xl text-heading">{t.common.siteName}</span>
        <span class="header-meta-text text-caption hidden sm:block">{t.common.tagline}</span>
      </a>

      <!-- Center nav (desktop) -->
      <nav aria-label="primary" class="hidden md:flex items-center gap-8">
        <a href="#" class="relative flex items-center gap-1.5 font-sans text-sm text-heading hover:text-brand transition-colors no-underline after:content-[''] after:absolute after:left-0 after:-bottom-1 after:h-px after:w-full after:origin-left after:scale-x-0 after:bg-brand after:transition-transform after:duration-300 after:ease-out hover:after:scale-x-100">
          {t.header.navSale}
          <span class="inline-flex items-center rounded-badge bg-sale text-white text-[10px] leading-none px-1.5 py-1">%</span>
        </a>
        <a href="#" class="relative flex items-center gap-1 font-sans text-sm text-heading hover:text-brand transition-colors no-underline after:content-[''] after:absolute after:left-0 after:-bottom-1 after:h-px after:w-full after:origin-left after:scale-x-0 after:bg-brand after:transition-transform after:duration-300 after:ease-out hover:after:scale-x-100">
          {t.header.navShopBy}
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </a>
        <a href="#" class="relative font-sans text-sm text-heading hover:text-brand transition-colors no-underline after:content-[''] after:absolute after:left-0 after:-bottom-1 after:h-px after:w-full after:origin-left after:scale-x-0 after:bg-brand after:transition-transform after:duration-300 after:ease-out hover:after:scale-x-100">{t.header.navOurStory}</a>
        <a href="#" class="relative font-sans text-sm text-heading hover:text-brand transition-colors no-underline after:content-[''] after:absolute after:left-0 after:-bottom-1 after:h-px after:w-full after:origin-left after:scale-x-0 after:bg-brand after:transition-transform after:duration-300 after:ease-out hover:after:scale-x-100">{t.header.navHealthReads}</a>
      </nav>

      <!-- Search + icons -->
      <div class="flex items-center gap-4">
        <div class="hidden lg:block">
          <form action={localePath(lang, 'search')} method="get" role="search" class="relative" onsubmit="return false">
            <label for="header-search" class="sr-only">{t.header.searchLabel}</label>
            <input
              id="header-search"
              name="q"
              type="search"
              placeholder={t.header.searchPlaceholder}
              class="w-56 xl:w-64 rounded-pill border border-border bg-surface pl-4 pr-9 py-2 text-sm text-body placeholder:text-muted focus:outline-none focus:ring-2 focus:ring-gold/50"
            />
            <svg class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 text-muted" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.75" />
              <path d="M21 21l-4.3-4.3" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
            </svg>
          </form>
        </div>

        <div
          class="hidden md:flex items-center gap-3"
          data-account-widget
          data-resolved={customerUser ? 'true' : 'false'}
        >
          <a
            href={loginHref}
            data-astro-reload
            data-account-guest
            hidden={Boolean(customerUser)}
            class="inline-flex items-center gap-1.5 text-heading hover:text-brand transition-colors"
          >
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle cx="12" cy="8" r="3.5" stroke="currentColor" stroke-width="1.5" />
              <path d="M4.5 20c1.5-3.5 5-5 7.5-5s6 1.5 7.5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            </svg>
            <span class="font-sans text-sm">{t.header.accountLabel}</span>
          </a>
          <div class="relative" data-account-menu>
            <button
              type="button"
              data-account-user
              data-account-menu-trigger
              hidden={!customerUser}
              aria-haspopup="menu"
              aria-expanded="false"
              aria-controls="account-menu"
              class="inline-flex items-center gap-1.5 text-heading hover:text-brand transition-colors cursor-pointer"
            >
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <circle cx="12" cy="8" r="3.5" stroke="currentColor" stroke-width="1.5" />
                <path d="M4.5 20c1.5-3.5 5-5 7.5-5s6 1.5 7.5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
              </svg>
              <span class="font-sans text-sm" data-account-name>{customerUser?.name || customerUser?.email || ''}</span>
              <svg class="account-menu-caret" width="10" height="10" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>

            <ul
              id="account-menu"
              role="menu"
              aria-label={t.header.accountMenuLabel}
              class="account-menu"
              data-account-menu-list
              hidden
            >
              <li role="none"><a role="menuitem" href={accountHref} data-astro-reload class="account-menu-item">{t.header.myAccountLabel}</a></li>
              <li role="none"><a role="menuitem" href="#" class="account-menu-item">{t.header.profileLabel}</a></li>
              <li role="none"><a role="menuitem" href="#" class="account-menu-item">{t.header.ordersLabel}</a></li>
              <li role="none"><a role="menuitem" href="#" class="account-menu-item">{t.header.addressesLabel}</a></li>
              <li role="none"><a role="menuitem" href="#" class="account-menu-item">{t.header.wishlistLabel}</a></li>
              <li role="none"><a role="menuitem" href="#" class="account-menu-item">{t.header.settingsLabel}</a></li>
              <li role="none" class="account-menu-divider" aria-hidden="true"></li>
              <li role="none">
                <button type="button" role="menuitem" data-account-logout class="account-menu-item account-menu-item-muted">{t.header.logoutLabel}</button>
              </li>
            </ul>
          </div>
        </div>

        <!-- Mobile search toggle -->
        <button
          type="button"
          class="mobile-search-trigger md:hidden inline-flex items-center justify-center w-9 h-9 cursor-pointer text-heading hover:text-brand transition-colors"
          aria-label={t.header.searchLabel}
          aria-expanded="false"
          aria-controls="mobile-search-popup"
          data-mobile-search-trigger
        >
          <svg data-search-open-icon width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.75" />
            <path d="M21 21l-4.3-4.3" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
          </svg>
          <svg data-search-close-icon width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          </svg>
        </button>

        <a href="#" aria-label={t.header.cartLabel} class="relative text-heading hover:text-brand transition-colors">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M4 7h16l-1.5 10.5a2 2 0 0 1-2 1.5H7.5a2 2 0 0 1-2-1.5L4 7Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round" />
            <path d="M8 7V6a4 4 0 0 1 8 0v1" stroke="currentColor" stroke-width="1.5" />
          </svg>
          <span class="absolute -top-1.5 -right-1.5 flex items-center justify-center w-4 h-4 rounded-full bg-sale text-white text-[10px] leading-none">0</span>
        </a>
      </div>
    </div>
  </div>

  <!-- Mobile floating search popup -->
  <div
    id="mobile-search-popup"
    class="mobile-search-popup md:hidden"
    data-mobile-search-popup
    data-state="closed"
    aria-hidden="true"
  >
    <form action={localePath(lang, 'search')} method="get" role="search" class="mobile-search-form" onsubmit="return false">
      <label for="mobile-search-popup-input" class="sr-only">{t.header.searchLabel}</label>
      <input
        id="mobile-search-popup-input"
        name="q"
        type="search"
        placeholder={t.header.searchPlaceholder}
        class="mobile-search-input"
      />
      <svg class="mobile-search-field-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.75" />
        <path d="M21 21l-4.3-4.3" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" />
      </svg>
    </form>
  </div>

  <!-- Mobile navigation drawer -->
  <div
    id="mobile-navigation-drawer"
    class="mobile-drawer md:hidden"
    data-mobile-drawer
    data-state="closed"
    aria-hidden="true"
  >
    <div class="mobile-drawer-backdrop" data-mobile-menu-backdrop aria-hidden="true"></div>

    <aside
      class="mobile-drawer-panel"
      role="dialog"
      aria-modal="true"
      aria-label={t.header.menuLabel}
      tabindex="-1"
      data-mobile-menu-panel
    >
      <div class="mobile-drawer-topbar">
        <a href={homeHref} data-astro-reload class="font-sans text-lg text-heading no-underline">{t.common.siteName}</a>
        <button
          type="button"
          class="mobile-drawer-icon-button"
          aria-label={t.header.menuLabel}
          data-mobile-menu-close
        >
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M6 6l12 12M18 6 6 18" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
          </svg>
        </button>
      </div>

      <div data-account-widget data-resolved={customerUser ? 'true' : 'false'}>
        <a
          href={loginHref}
          data-astro-reload
          data-account-guest
          hidden={Boolean(customerUser)}
          class="mobile-profile-row"
        >
          <span class="mobile-profile-icon" aria-hidden="true">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
              <circle cx="12" cy="8" r="3.5" stroke="currentColor" stroke-width="1.5" />
              <path d="M4.5 20c1.5-3.5 5-5 7.5-5s6 1.5 7.5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
            </svg>
          </span>
          <span class="font-sans text-sm font-semibold text-heading">{t.header.accountLabel}</span>
        </a>

        <div data-account-user hidden={!customerUser}>
          <button
            type="button"
            class="mobile-profile-row"
            data-mobile-account-toggle
            aria-controls="mobile-account-panel"
            aria-expanded="false"
          >
            <span class="mobile-profile-icon" aria-hidden="true">
              <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
                <circle cx="12" cy="8" r="3.5" stroke="currentColor" stroke-width="1.5" />
                <path d="M4.5 20c1.5-3.5 5-5 7.5-5s6 1.5 7.5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
              </svg>
            </span>
            <span class="font-sans text-sm font-semibold text-heading flex-1" data-account-name>{customerUser?.name || customerUser?.email || ''}</span>
            <svg class="mobile-accordion-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="m9 6 6 6-6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <div id="mobile-account-panel" class="mobile-accordion-panel-customer" data-mobile-account-panel hidden>
            <nav class="mobile-menu-list" aria-label={t.header.accountMenuLabel}>
              <a href={accountHref} data-astro-reload class="mobile-menu-row">{t.header.myAccountLabel}</a>
              <a href="#" class="mobile-menu-row">{t.header.profileLabel}</a>
              <a href="#" class="mobile-menu-row">{t.header.ordersLabel}</a>
              <a href="#" class="mobile-menu-row">{t.header.addressesLabel}</a>
              <a href="#" class="mobile-menu-row">{t.header.wishlistLabel}</a>
              <a href="#" class="mobile-menu-row">{t.header.settingsLabel}</a>
              <button type="button" data-account-logout class="mobile-menu-row mobile-menu-row-muted">{t.header.logoutLabel}</button>
            </nav>
          </div>
        </div>
      </div>

      <div class="mobile-menu-viewport">
        <nav class="mobile-menu-list" aria-label={t.header.menuLabel}>
          <a href="#" class="mobile-menu-row">
            <span class="inline-flex items-center gap-2">
              {t.header.navSale}
              <span class="inline-flex items-center rounded-badge bg-sale text-white text-[10px] leading-none px-1.5 py-1">%</span>
            </span>
          </a>
          <button type="button" class="mobile-menu-row" data-mobile-shop-toggle aria-controls="mobile-shop-panel" aria-expanded="false">
            <span>{t.header.navShopBy}</span>
            <svg class="mobile-accordion-chevron" width="16" height="16" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="m9 6 6 6-6 6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </button>
          <div id="mobile-shop-panel" class="mobile-accordion-panel" data-mobile-shop-panel hidden>
            <a href={localePath(lang, t.naturalOils.collectionPath)} data-astro-reload class="mobile-menu-row mobile-menu-row-sub">
              {t.naturalOils.eyebrow}
            </a>
          </div>
          <a href="#" class="mobile-menu-row">{t.header.navOurStory}</a>
          <a href="#" class="mobile-menu-row">{t.header.navHealthReads}</a>
        </nav>
      </div>
    </aside>
  </div>
</header>

<style>
  .header-meta-text { color: var(--color-body); }

  /* Desktop authenticated-account dropdown -- same visual language as
     AnnouncementBar.astro's locale switcher (rounded card, border,
     hover-tint items) so the two dropdown patterns already in this app
     read as one system. */
  .account-menu-caret { transition: transform 0.15s ease-out; }
  [data-account-menu-trigger][aria-expanded='true'] .account-menu-caret { transform: rotate(180deg); }

  .account-menu {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    z-index: 60;
    min-width: 12rem;
    margin: 0;
    padding: 0.375rem;
    list-style: none;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    box-shadow: var(--shadow-card-hover);
  }

  .account-menu-item {
    display: block;
    width: 100%;
    padding: 0.6rem 0.75rem;
    border: 0;
    border-radius: 0.4rem;
    background: transparent;
    font: inherit;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    color: var(--color-heading);
    text-align: left;
    text-decoration: none;
    cursor: pointer;
    transition: background-color 0.15s ease-out, color 0.15s ease-out;
  }
  .account-menu-item:hover,
  .account-menu-item:focus-visible {
    background: color-mix(in oklab, var(--color-brand) 10%, transparent);
    outline: none;
  }

  /* Sign out -- muted, not the same brand-heading color as a real
     navigation destination (matches .mobile-menu-row-muted below). */
  .account-menu-item-muted { color: var(--color-muted); }
  .account-menu-item-muted:hover,
  .account-menu-item-muted:focus-visible { color: var(--color-heading); }

  .account-menu-divider {
    height: 1px;
    margin: 0.375rem 0.25rem;
    background: var(--color-border);
  }

  @media (prefers-reduced-motion: reduce) {
    .account-menu-caret { transition: none; }
  }

  .mobile-search-trigger [data-search-close-icon] { display: none; }
  .mobile-search-trigger[aria-expanded='true'] [data-search-open-icon] { display: none; }
  .mobile-search-trigger[aria-expanded='true'] [data-search-close-icon] { display: block; }

  .mobile-search-popup {
    position: absolute;
    top: calc(100% + 0.5rem);
    right: 0.75rem;
    left: 0.75rem;
    z-index: 60;
    visibility: hidden;
    pointer-events: none;
    opacity: 0;
    transform: translateY(-0.4rem);
    transition:
      opacity 180ms ease,
      transform 180ms ease,
      visibility 0s linear 180ms;
  }

  .mobile-search-popup[data-state='open'] {
    visibility: visible;
    pointer-events: auto;
    opacity: 1;
    transform: translateY(0);
    transition-delay: 0s;
  }

  .mobile-search-form {
    position: relative;
    max-width: 34rem;
    margin-left: auto;
    padding: 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-card);
    background: var(--color-surface);
    box-shadow: var(--shadow-card-hover);
  }

  .mobile-search-input {
    width: 100%;
    min-height: 3rem;
    padding: 0.7rem 2.75rem 0.7rem 1rem;
    color: var(--color-body);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    font: inherit;
    font-size: 0.875rem;
  }

  .mobile-search-input::placeholder { color: var(--color-muted); }

  .mobile-search-input:focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: 2px;
  }

  .mobile-search-field-icon {
    position: absolute;
    top: 50%;
    right: 1.4rem;
    color: var(--color-muted);
    pointer-events: none;
    transform: translateY(-50%);
  }

  .mobile-drawer {
    position: fixed;
    inset: 0;
    z-index: 70;
    pointer-events: none;
    visibility: hidden;
    transition: visibility 0s linear 280ms;
  }

  .mobile-drawer[data-state='open'] {
    pointer-events: auto;
    visibility: visible;
    transition-delay: 0s;
  }

  .mobile-drawer-backdrop {
    position: absolute;
    inset: 0;
    background: color-mix(in oklab, var(--color-heading) 42%, transparent);
    opacity: 0;
    transition: opacity 240ms ease;
  }

  .mobile-drawer-panel {
    position: relative;
    display: flex;
    flex-direction: column;
    width: min(90vw, 24rem);
    height: 100%;
    overflow: hidden;
    color: var(--color-body);
    background: var(--color-surface);
    transform: translateX(-100%);
    transition: transform 280ms ease;
  }

  .mobile-drawer[data-state='open'] .mobile-drawer-backdrop { opacity: 1; }
  .mobile-drawer[data-state='open'] .mobile-drawer-panel { transform: translateX(0); }

  .mobile-drawer-topbar {
    display: flex;
    min-height: 4.5rem;
    align-items: center;
    justify-content: space-between;
    padding: 0 1.25rem;
    border-bottom: 1px solid var(--color-border);
  }

  .mobile-drawer-icon-button {
    display: inline-flex;
    width: 2.75rem;
    height: 2.75rem;
    align-items: center;
    justify-content: center;
    padding: 0;
    color: var(--color-heading);
    border: 0;
    background: transparent;
    cursor: pointer;
  }

  /* Shared by the guest link (<a>) and the authenticated disclosure
     trigger (<button>, opens the account view below) -- the extra
     reset properties (border/width/font/cursor/text-align) are no-ops for
     the <a> and only matter for the <button> so it renders identically. */
  .mobile-profile-row {
    display: flex;
    align-items: center;
    width: 100%;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    border: 0;
    border-bottom: 1px solid var(--color-border);
    background: var(--color-cream);
    font: inherit;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
  }

  /* Sign out row within the authenticated mobile account list (reuses
     .mobile-menu-row otherwise) -- muted, not the brand heading color, so
     it doesn't read as just another navigation destination. */
  .mobile-menu-row-muted { color: var(--color-muted); }
  .mobile-menu-row-muted:hover { color: var(--color-heading); }

  .mobile-profile-icon {
    display: inline-flex;
    width: 2.5rem;
    height: 2.5rem;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    color: var(--color-brand);
    border: 1px solid var(--color-border);
    border-radius: 50%;
    background: var(--color-surface);
  }

  .mobile-menu-viewport {
    min-height: 0;
    flex: 1;
    overflow: hidden auto;
    padding: 0.75rem 1.25rem 1.5rem;
  }

  .mobile-menu-list { display: grid; }

  .mobile-menu-row {
    display: flex;
    width: 100%;
    min-height: 3.25rem;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.75rem 0;
    color: var(--color-heading);
    border: 0;
    border-bottom: 1px solid color-mix(in oklab, var(--color-border) 72%, transparent);
    background: transparent;
    font: inherit;
    font-size: 0.95rem;
    text-align: left;
    text-decoration: none;
    cursor: pointer;
    transition: color 180ms ease;
  }

  .mobile-menu-row:hover { color: var(--color-brand); }

  /* Accordion chevron rotates to reflect its trigger's own aria-expanded
     -- same idiom as the desktop account dropdown's caret. Toggling
     [hidden] on the panel below is the entire show/hide mechanism (no
     slide/translate, no separate "view" state -- see the script). */
  .mobile-accordion-chevron { transition: transform 0.15s ease-out; }
  [aria-expanded='true'] > .mobile-accordion-chevron { transform: rotate(90deg); }

  /* Shared by the Shop By panel (a single indented sub-link) and the
     account panel (a full .mobile-menu-list of primary actions) -- same
     horizontal inset .mobile-menu-viewport already gives top-level rows,
     applied here directly since accordion panels sit at different nesting
     depths (the account one lives outside .mobile-menu-viewport
     entirely, next to the profile row it belongs to). */
  .mobile-accordion-panel-customer {
    padding: 0 1.25rem;
    background: var(--color-cream);
  }

  .mobile-accordion-panel {
    padding: 0 1.25rem;
  }

  .mobile-menu-row-sub { padding-left: 1rem; }

  .mobile-drawer button:focus-visible,
  .mobile-drawer a:focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-search-popup,
    .mobile-drawer-backdrop,
    .mobile-drawer,
    .mobile-drawer-panel,
    .mobile-menu-row,
    .mobile-accordion-chevron { transition: none; }
  }
</style>

<script>
  function initMobileSearchPopup() {
    const trigger = document.querySelector('[data-mobile-search-trigger]');
    const popup = document.querySelector('[data-mobile-search-popup]');
    if (!(trigger instanceof HTMLButtonElement) || !(popup instanceof HTMLElement)) return;
    if (popup.dataset.initialized === 'true') return;
    popup.dataset.initialized = 'true';

    const input = popup.querySelector('input[type="search"]');

    const closeSearch = (restoreFocus = false) => {
      popup.dataset.state = 'closed';
      popup.setAttribute('aria-hidden', 'true');
      trigger.setAttribute('aria-expanded', 'false');
      if (restoreFocus) trigger.focus();
    };

    const openSearch = () => {
      popup.dataset.state = 'open';
      popup.setAttribute('aria-hidden', 'false');
      trigger.setAttribute('aria-expanded', 'true');
      requestAnimationFrame(() => {
        if (input instanceof HTMLInputElement) input.focus();
      });
    };

    trigger.addEventListener('click', () => {
      popup.dataset.state === 'open' ? closeSearch(true) : openSearch();
    });

    document.addEventListener('pointerdown', (event) => {
      if (popup.dataset.state !== 'open') return;
      if (!(event.target instanceof Node)) return;
      if (!popup.contains(event.target) && !trigger.contains(event.target)) closeSearch();
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && popup.dataset.state === 'open') {
        event.preventDefault();
        closeSearch(true);
      }
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth >= 768 && popup.dataset.state === 'open') closeSearch();
    });
  }

  initMobileSearchPopup();
  document.addEventListener('astro:page-load', initMobileSearchPopup);
</script>

<script>
  function initMobileDrawer() {
    const drawer = document.querySelector('[data-mobile-drawer]');
    const openButton = document.querySelector('[data-mobile-menu-open]');
    if (!(drawer instanceof HTMLElement) || !(openButton instanceof HTMLButtonElement)) return;
    if (drawer.dataset.initialized === 'true') return;
    drawer.dataset.initialized = 'true';

    const panel = drawer.querySelector('[data-mobile-menu-panel]');
    const closeButton = drawer.querySelector('[data-mobile-menu-close]');
    const backdrop = drawer.querySelector('[data-mobile-menu-backdrop]');
    const shopToggle = drawer.querySelector('[data-mobile-shop-toggle]');
    const shopPanel = drawer.querySelector('[data-mobile-shop-panel]');
    const accountToggle = drawer.querySelector('[data-mobile-account-toggle]');
    const accountPanel = drawer.querySelector('[data-mobile-account-panel]');
    let previousFocus: Element | null = null;

    const focusableSelector = 'a[href], button:not([disabled]), input:not([disabled]), [tabindex]:not([tabindex="-1"])';

    // Simple accordion: at most one of 'shop' | 'account' is open at a
    // time, tracked in this one variable. setOpenSection is the ONLY
    // place that ever writes it or touches either trigger's aria-expanded
    // or either panel's [hidden] -- both toggle buttons call the exact
    // same function (just with their own section name), so neither can
    // touch the other's state directly and there is nothing to get out of
    // sync. No slide/translate/track -- opening a section just reveals
    // its panel in place; closing the drawer always resets this to null.
    type MobileSection = 'shop' | 'account' | null;
    let openSection: MobileSection = null;

    const setOpenSection = (section: MobileSection) => {
      openSection = section;
      if (shopToggle instanceof HTMLButtonElement) shopToggle.setAttribute('aria-expanded', section === 'shop' ? 'true' : 'false');
      if (shopPanel instanceof HTMLElement) shopPanel.hidden = section !== 'shop';
      if (accountToggle instanceof HTMLButtonElement) accountToggle.setAttribute('aria-expanded', section === 'account' ? 'true' : 'false');
      if (accountPanel instanceof HTMLElement) accountPanel.hidden = section !== 'account';
    };

    const toggleSection = (section: 'shop' | 'account') => {
      setOpenSection(openSection === section ? null : section);
    };

    const closeDrawer = () => {
      drawer.dataset.state = 'closed';
      drawer.setAttribute('aria-hidden', 'true');
      openButton.setAttribute('aria-expanded', 'false');
      document.body.style.overflow = '';
      setOpenSection(null);
      if (previousFocus instanceof HTMLElement) previousFocus.focus();
    };

    const openDrawer = () => {
      previousFocus = document.activeElement;
      drawer.dataset.state = 'open';
      drawer.setAttribute('aria-hidden', 'false');
      openButton.setAttribute('aria-expanded', 'true');
      document.body.style.overflow = 'hidden';
      requestAnimationFrame(() => {
        if (panel instanceof HTMLElement) panel.focus();
      });
    };

    openButton.addEventListener('click', openDrawer);
    closeButton?.addEventListener('click', closeDrawer);
    backdrop?.addEventListener('click', closeDrawer);
    shopToggle?.addEventListener('click', () => toggleSection('shop'));
    accountToggle?.addEventListener('click', () => toggleSection('account'));

    drawer.querySelectorAll('a[href]').forEach((link) => link.addEventListener('click', closeDrawer));

    document.addEventListener('keydown', (event) => {
      if (drawer.dataset.state !== 'open') return;
      if (event.key === 'Escape') {
        event.preventDefault();
        closeDrawer();
        return;
      }
      if (event.key !== 'Tab') return;

      const focusable = Array.from(drawer.querySelectorAll(focusableSelector)).filter(
        (element) => element instanceof HTMLElement && element.offsetParent !== null,
      );
      const first = focusable[0];
      const last = focusable[focusable.length - 1];
      if (!(first instanceof HTMLElement) || !(last instanceof HTMLElement)) return;

      if (event.shiftKey && document.activeElement === first) {
        event.preventDefault();
        last.focus();
      } else if (!event.shiftKey && document.activeElement === last) {
        event.preventDefault();
        first.focus();
      }
    });

    window.addEventListener('resize', () => {
      if (window.innerWidth >= 768 && drawer.dataset.state === 'open') closeDrawer();
    });
  }

  initMobileDrawer();
  document.addEventListener('astro:page-load', initMobileDrawer);
</script>

<script>
  // Every page rendering this Header is fully static/prerendered, so
  // Astro.locals.customerUser (populated by src/middleware.ts) is never
  // available server-side here -- see the frontmatter comment above. The
  // baked HTML always defaults to the guest markup; this is the one place
  // that resolves the real, per-visitor session, using the SAME Better
  // Auth endpoint every other customer-auth page already calls (no new
  // route, no duplicated session logic). Re-runs on `astro:page-load` --
  // fired on first load AND every ClientRouter soft-navigation in this
  // project (see the search-popup/drawer scripts above for the same
  // pattern) -- so a soft-navigated page's freshly-swapped-in guest
  // markup gets checked again rather than staying stale.
  async function initAccountWidgets() {
    const widgets = Array.from(document.querySelectorAll('[data-account-widget]')).filter(
      (el): el is HTMLElement => el instanceof HTMLElement,
    );

    function applyState(widget: HTMLElement, user: { name?: string; email?: string } | null) {
      const guest = widget.querySelector('[data-account-guest]');
      const authed = widget.querySelector('[data-account-user]');
      const logout = widget.querySelector('[data-account-logout]');
      const nameEl = widget.querySelector('[data-account-name]');
      if (user) {
        if (nameEl instanceof HTMLElement) nameEl.textContent = user.name || user.email || '';
        if (guest instanceof HTMLElement) guest.hidden = true;
        if (authed instanceof HTMLElement) authed.hidden = false;
        if (logout instanceof HTMLElement) logout.hidden = false;
      } else {
        if (guest instanceof HTMLElement) guest.hidden = false;
        if (authed instanceof HTMLElement) authed.hidden = true;
        if (logout instanceof HTMLElement) logout.hidden = true;
      }
    }

    // Skip the fetch entirely for a widget that was already resolved
    // server-side (a real, non-default value baked into `data-resolved`) --
    // this only ever happens if this Header is one day rendered on an
    // on-demand page, but the guard costs nothing and avoids a genuinely
    // unnecessary request when the server already knows the answer.
    const unresolved = widgets.filter((widget) => widget.dataset.resolved !== 'true');
    if (unresolved.length > 0) {
      try {
        const res = await fetch('/api/customer-auth/get-session', {
          credentials: 'same-origin',
          cache: 'no-store',
        });
        const data = res.ok ? await res.json().catch(() => null) : null;
        const user = data?.user ?? null;
        unresolved.forEach((widget) => applyState(widget, user));
      } catch {
        // Network error -- leave the already-rendered guest markup as-is.
        // Never assume authenticated on failure.
      }
    }

    document.querySelectorAll('[data-account-logout]').forEach((button) => {
      if (!(button instanceof HTMLButtonElement) || button.dataset.wired === 'true') return;
      button.dataset.wired = 'true';
      button.addEventListener('click', async () => {
        button.disabled = true;
        try {
          // The existing Better Auth customer-auth sign-out endpoint is
          // the only source of truth for logout -- same call already
          // proven correct in src/layouts/AdminLayout.astro's logout
          // script. A plain <form method="post"> would NOT work here:
          // Better Auth 1.7.2's router requires `content-type:
          // application/json` on every request (confirmed against the
          // installed source), which a native form submission never sends.
          await fetch('/api/customer-auth/sign-out', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: '{}',
            credentials: 'same-origin',
            cache: 'no-store',
          });
        } catch {
          // Fall through to the reload regardless -- worst case the header
          // still shows the stale authenticated name until the next real
          // check, which is safe (this widget never gates access to
          // anything; middleware/get-session remain the actual gate).
        } finally {
          window.location.reload();
        }
      });
    });
  }

  initAccountWidgets();
  document.addEventListener('astro:page-load', initAccountWidgets);
</script>

<script>
  // Desktop authenticated-account dropdown -- same interaction pattern as
  // AnnouncementBar.astro's locale switcher (open/close, arrow-key nav,
  // outside click, Escape), scoped to [data-account-menu] instead. The
  // trigger button itself is the existing account icon + name
  // (data-account-user, toggled by initAccountWidgets above); this script
  // only owns opening/closing the menu, never the guest/authed state.
  function initAccountMenus() {
    const roots = document.querySelectorAll<HTMLElement>('[data-account-menu]');

    roots.forEach((root) => {
      if ((root as HTMLElement & { __accountMenuInit?: boolean }).__accountMenuInit) return;
      (root as HTMLElement & { __accountMenuInit?: boolean }).__accountMenuInit = true;

      const trigger = root.querySelector<HTMLButtonElement>('[data-account-menu-trigger]');
      const menu = root.querySelector<HTMLElement>('[data-account-menu-list]');
      if (!trigger || !menu) return;

      const isOpen = () => !menu.hidden;

      const open = () => {
        menu.hidden = false;
        trigger.setAttribute('aria-expanded', 'true');
      };

      const close = (opts: { focusTrigger?: boolean } = {}) => {
        if (!isOpen()) return;
        menu.hidden = true;
        trigger.setAttribute('aria-expanded', 'false');
        if (opts.focusTrigger) trigger.focus();
      };

      trigger.addEventListener('click', (event) => {
        event.stopPropagation();
        if (isOpen()) {
          close();
        } else {
          open();
        }
      });

      trigger.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowDown' && !isOpen()) {
          event.preventDefault();
          open();
          const first = menu.querySelector<HTMLElement>('[role="menuitem"]');
          first?.focus();
        }
      });

      menu.addEventListener('keydown', (event) => {
        const items = Array.from(menu.querySelectorAll<HTMLElement>('[role="menuitem"]'));
        const currentIndex = items.indexOf(document.activeElement as HTMLElement);

        if (event.key === 'ArrowDown') {
          event.preventDefault();
          const next = items[(currentIndex + 1 + items.length) % items.length];
          next?.focus();
        } else if (event.key === 'ArrowUp') {
          event.preventDefault();
          const prev = items[(currentIndex - 1 + items.length) % items.length];
          prev?.focus();
        }
      });

      // Any menu item activation (a real link, a "#" placeholder, or the
      // Sign out button) dismisses the menu -- same pattern the mobile
      // drawer already uses for its own nav links.
      menu.querySelectorAll('[role="menuitem"]').forEach((item) => {
        item.addEventListener('click', () => close());
      });

      document.addEventListener('click', (event) => {
        if (!isOpen()) return;
        if (!(event.target instanceof Node)) return;
        if (!root.contains(event.target)) close();
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && isOpen()) {
          event.preventDefault();
          close({ focusTrigger: true });
        }
      });
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAccountMenus);
  } else {
    initAccountMenus();
  }
  document.addEventListener('astro:page-load', initAccountMenus);
</script>
