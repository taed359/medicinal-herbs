---
import { getImage } from 'astro:assets';
import heroDesktop from '../assets/images/hero/anniversary-desktop.webp';
import heroMobile from '../assets/images/hero/anniversary-mobile.webp';
import { getTranslations, localeHomePath, type Locale } from '../i18n/utils';

interface Props {
  lang: Locale;
}
const { lang } = Astro.props;

const t = getTranslations(lang);
const homeHref = localeHomePath(lang);

// Slide data is kept separate from the markup below so this can grow into a
// real array (Swiper-driven, multiple slides) later without a structural
// rewrite. Only one slide is used for now.
const slides = [
  {
    desktopImage: heroDesktop,
    mobileImage: heroMobile,
    eyebrow: t.hero.eyebrow,
    title: t.hero.title,
    description: t.hero.description,
    ctaLabel: t.hero.ctaLabel,
    // No dedicated catalogue/checkout route exists yet, so this points at the
    // homepage's existing "Featured products" section. Swap for a real
    // catalogue/collection URL once Content Collections ship product pages.
    ctaHref: `${homeHref}#products`,
    imageAlt: t.hero.imageAlt,
  },
];
const slide = slides[0];

// Pre-process both art-directed variants once at build time. A hand-rolled
// <picture> below ensures the browser only downloads whichever one matches
// the active breakpoint, never both.
const desktopOptimized = await getImage({ src: slide.desktopImage, format: 'webp', quality: 82 });
const mobileOptimized = await getImage({ src: slide.mobileImage, format: 'webp', quality: 82 });
---

<section class="relative w-full overflow-hidden bg-cream" aria-labelledby="hero-heading">
  <div class="relative flex min-h-[460px] items-center sm:min-h-[540px] md:min-h-[640px] lg:min-h-[680px]">
    <!-- Background layer (z-0): visual only — no promotional text baked into the image -->
    <div class="absolute inset-0 z-0 overflow-hidden">
      <picture class="block h-full w-full">
        <source media="(min-width: 768px)" srcset={desktopOptimized.src} />
        <img
          src={mobileOptimized.src}
          alt={slide.imageAlt}
          class="h-full w-full object-cover"
          loading="eager"
          decoding="async"
          fetchpriority="high"
        />
      </picture>
    </div>

    <!-- Overlay layer (z-10): readability scrim — bottom-up on mobile (text sits low), left-to-right on desktop (text sits left) -->
    <div
      class="absolute inset-0 z-10 bg-[linear-gradient(to_top,var(--color-cream)_18%,transparent_62%)] md:bg-[linear-gradient(to_right,var(--color-cream)_0%,var(--color-cream)_22%,transparent_60%)]"
      aria-hidden="true"
    >
    </div>

    <!-- Content layer (z-20) -->
    <div class="container-page relative z-20 flex flex-1 items-end py-8 sm:items-center sm:py-12 md:py-0">
      <div class="hero-fade-in max-w-full sm:max-w-md md:max-w-[45%]">
        <p class="eyebrow">{slide.eyebrow}</p>
        <h1 id="hero-heading" class="mt-3 font-serif text-3xl leading-tight text-heading sm:text-4xl md:text-5xl">
          {slide.title}
        </h1>
        <p class="mt-4 max-w-prose text-sm text-body/85 sm:text-base">
          {slide.description}
        </p>
        <a
          href={slide.ctaHref}
          data-astro-reload
          class="mt-7 inline-flex min-h-12 items-center justify-center rounded-pill border border-brand bg-surface/70 px-8 py-3 text-sm font-semibold tracking-wide text-brand no-underline transition-colors duration-300 hover:bg-brand hover:text-surface hover:no-underline"
        >
          {slide.ctaLabel}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Minimal entrance animation; fully inert unless the user allows motion */
  .hero-fade-in {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-fade-in {
      opacity: 0;
      transform: translateY(14px);
      animation: hero-fade-in 700ms ease-out 120ms forwards;
    }
  }
  @keyframes hero-fade-in {
    to {
      opacity: 1;
      transform: none;
    }
  }
</style>
