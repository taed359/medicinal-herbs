---
import { getTranslations, localePath, type Locale, type RouteLocale } from '../i18n/utils';

interface Props {
  lang: RouteLocale;
  uiLang: Locale;
}
const { lang, uiLang } = Astro.props;
const t = getTranslations(uiLang);
const contactHref = localePath(lang, 'contact');
const privacyHref = lang === 'en' ? '/privacy-policy/' : localePath(lang, 'policies/privacy-policy');
const backToTopLabel = lang === 'en' ? 'Back to top' : uiLang === 'zh' ? '返回顶部' : 'Về đầu trang';
const year = new Date().getFullYear();
---
<!--
  Editorial convergence pass: same 4 real columns (About/Support/Shop-by-
  Goal/Newsletter), same links, hrefs, i18n keys, and newsletter form as
  before -- nothing added or removed functionally. What changed is purely
  visual: pine-dark background (matching Process/ExpertConsultation's
  established inverted treatment, replacing the older --color-brand
  green), .container-editorial instead of .container-page (aligning the
  footer's edges with the rest of the homepage), and a real brand intro
  (site name + existing tagline, the same text already used in Header's
  own logo) folded into the first column so it carries the extra visual
  weight the mockup's brand column has, without inventing a 5th column
  or removing the "About" links that column already had.
-->
<footer class="site-footer bg-pine-dark text-paper-2 mt-10">
  <div class="container-editorial footer-top">
    <div class="footer-grid">
      <!-- Column 1: Brand intro + About -->
      <div>
        <p class="footer-brand-name font-serif m-0">{t.common.siteName}</p>
        <p class="footer-brand-tag m-0">{t.common.tagline}</p>
        <h3 class="footer-heading">{t.footer.aboutHeadingPrefix} {t.common.siteName}</h3>
        <ul class="footer-list m-0 p-0 list-none">
          <li><a class="footer-link" href="#">{t.footer.aboutLinks.story}</a></li>
          <li><a class="footer-link" href="#">{t.footer.aboutLinks.reads}</a></li>
          <li><a class="footer-link" href="#">{t.footer.aboutLinks.sustainability}</a></li>
        </ul>
      </div>

      <!-- Column 2: Support -->
      <div>
        <h3 class="footer-heading">{t.footer.supportHeading}</h3>
        <ul class="footer-list m-0 p-0 list-none">
          <li><a class="footer-link" href={contactHref} data-astro-reload>{t.footer.supportLinks.contact}</a></li>
          <li><a class="footer-link" href="#">{t.footer.supportLinks.faqs}</a></li>
          <li><a class="footer-link" href="#">{t.footer.supportLinks.wholesale}</a></li>
        </ul>
      </div>

      <!-- Column 3: Shop by Health Goal -->
      <div>
        <h3 class="footer-heading">{t.footer.shopHeading}</h3>
        <ul class="footer-list m-0 p-0 list-none">
          <li><a class="footer-link" href="#">{t.footer.goals.immunity}</a></li>
          <li><a class="footer-link" href="#">{t.footer.goals.energy}</a></li>
          <li><a class="footer-link" href="#">{t.footer.goals.beauty}</a></li>
          <li><a class="footer-link" href="#">{t.footer.goals.sleep}</a></li>
        </ul>
      </div>

      <!-- Column 4: Newsletter -->
      <div>
        <h3 class="footer-heading">{t.footer.newsletter.heading}</h3>
        <p class="footer-desc">{t.footer.newsletter.subtext}</p>
        <form action="#" method="post" onsubmit="return false" class="nl-form">
          <label for="footer-email" class="sr-only">{t.footer.newsletter.emailPlaceholder}</label>
          <input id="footer-email" type="email" required placeholder={t.footer.newsletter.emailPlaceholder} class="nl-input" />
          <button type="submit" class="nl-button">{t.footer.newsletter.subscribeButton}</button>
        </form>
        <p class="footer-privacy">{t.footer.newsletter.privacyNote}</p>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="footer-bottom-band">
    <div class="container-editorial footer-bottom-inner">
      <!-- Social icons -->
      <div class="flex items-center gap-4">
        <a href="#" aria-label="Facebook" class="text-paper-2 hover:text-amber-light" rel="nofollow noopener">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M14 9h3V6h-3a4 4 0 0 0-4 4v3H7v3h3v6h3v-6h3l1-3h-4v-3a1 1 0 0 1 1-1Z" stroke="currentColor" stroke-width="1.5"/></svg>
        </a>
        <a href="#" aria-label="Instagram" class="text-paper-2 hover:text-amber-light" rel="nofollow noopener">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="4" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
        </a>
        <a href="#" aria-label="TikTok" class="text-paper-2 hover:text-amber-light" rel="nofollow noopener">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 3v4a5 5 0 0 0 5 5h1v3a8 8 0 1 1-8-8V3Z" stroke="currentColor" stroke-width="1.5" fill="none"/></svg>
        </a>
        <a href="#" aria-label="YouTube" class="text-paper-2 hover:text-amber-light" rel="nofollow noopener">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="7" width="18" height="10" rx="3" stroke="currentColor" stroke-width="1.5"/><path d="M10 10l5 2-5 2v-4Z" fill="currentColor"/></svg>
        </a>
      </div>

      <!-- Legal -->
      <div class="footer-legal">
        <span>© {year} — {t.common.siteName}. {t.footer.rights}</span>
        <span class="footer-legal-sep">•</span>
        <a href="#" class="footer-legal-link">{t.footer.terms}</a>
        <span class="footer-legal-sep">|</span>
        <a href={privacyHref} data-astro-reload class="footer-legal-link">{t.footer.privacy}</a>
      </div>
    </div>
  </div>

  <button
    type="button"
    class="back-to-top"
    aria-label={backToTopLabel}
    data-back-to-top
  >
    <span class="back-to-top-progress" aria-hidden="true"></span>
    <svg class="back-to-top-icon" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
      <path d="M4.5 11.5 10 6l5.5 5.5M10 6v9" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
</footer>

<style>
  footer a {
    position: relative;
  }
  footer a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -0.25rem;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 300ms ease-out;
  }
  footer a:hover::after,
  footer a:focus-visible::after {
    transform: scaleX(1);
  }

  /* Top padding only -- grows with viewport (matching the mockup's 72px
     at desktop, tapering down responsibly for mobile per this project's
     own established rem-scale convention rather than copying the flat
     pixel value verbatim). The grid's own margin-bottom below handles
     the space before the bottom bar, so there's no bottom padding here
     to double up with that. */
  .footer-top {
    padding-top: 2.5rem;
  }
  @media (min-width: 640px) {
    .footer-top { padding-top: 3rem; }
  }
  @media (min-width: 1024px) {
    .footer-top { padding-top: 4.5rem; }
  }

  .footer-grid {
    display: grid;
    gap: 2.5rem;
    margin-bottom: 2.5rem;
  }
  /* Grid items default to `min-width: auto` (their content's min-content
   * size), not 0 -- the classic Grid/Flexbox overflow gotcha. Confirmed
   * live on a real iPhone (Web Inspector): the zh footer's Column 1
   * forced document.body.scrollWidth to 516px against a 320px viewport
   * (a 500px-wide column, all four locale-shared columns share this same
   * grid so any of them could trip it) -- the `ch`-based max-widths in
   * this file (.footer-brand-tag: 26ch, .footer-desc: 30ch) resolve to a
   * much larger pixel value under the zh Noto Sans SC font's wider glyph
   * metrics than under vi's font, pushing a column's min-content past
   * the viewport and forcing the whole grid (and body) to overflow
   * horizontally on narrow phones. Forcing min-width:0 confirmed
   * scrollWidth drops back to exactly the viewport width. */
  .footer-grid > * {
    min-width: 0;
  }
  @media (min-width: 768px) {
    .footer-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1024px) {
    /* 1.3fr first column, matching the mockup's own heavier brand
       column (1.4fr repeat(3,1fr)) -- the brand intro + About links
       column carries more real content than the other three, so this
       gives it room to breathe rather than fighting an equal-width
       grid, without a 5th column. */
    .footer-grid {
      grid-template-columns: 1.3fr repeat(3, minmax(0, 1fr));
      margin-bottom: 3.5rem;
    }
  }

  .footer-brand-name {
    font-size: 1.375rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--color-cream);
  }

  .footer-brand-tag {
    margin-top: 0.375rem;
    margin-bottom: 1.75rem;
    max-width: 26ch;
    font-size: 0.8125rem;
    line-height: 1.6;
    color: color-mix(in srgb, var(--color-paper-2) 78%, var(--color-pine-dark));
  }

  /* Small-caps eyebrow treatment, matching the mockup's footer h4 (and
     the same --color-amber-light already used for Process's own eyebrow
     on its pine-dark section) rather than the previous larger white
     sans-serif heading. */
  .footer-heading {
    margin: 0 0 1.125rem;
    font-family: var(--font-sans);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--color-amber-light);
    text-wrap: balance;
  }

  .footer-list {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .footer-link {
    display: inline-block;
    color: color-mix(in srgb, var(--color-paper-2) 82%, var(--color-pine-dark));
    text-decoration: none;
    font-size: 0.875rem;
    line-height: 1.5;
    transition: color 0.2s ease;
  }
  .footer-link:hover,
  .footer-link:focus-visible { color: var(--color-amber-light); }

  .footer-desc {
    margin: 0 0 0.875rem;
    max-width: 30ch;
    font-size: 0.8125rem;
    line-height: 1.6;
    color: color-mix(in srgb, var(--color-paper-2) 80%, var(--color-pine-dark));
  }

  .nl-form {
    display: flex;
    width: 100%;
    min-width: 0;
    height: 48px;
    align-items: stretch;
    border: 1px solid color-mix(in srgb, var(--color-amber-light) 35%, transparent);
    border-radius: var(--radius-pill);
    overflow: hidden;
    background: var(--color-cream);
  }
  .nl-form:focus-within { outline: 2px solid color-mix(in srgb, var(--color-amber-light) 55%, transparent); outline-offset: 2px; }

  .nl-input {
    flex: 1 1 auto;
    min-width: 0;
    border: 0;
    background: transparent;
    color: var(--color-body);
    padding: 0 14px 0 16px;
    font-size: 0.9375rem;
  }
  .nl-input::placeholder { color: color-mix(in oklab, var(--color-body) 60%, white); }
  .nl-input:focus { outline: none; }

  .nl-button {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 18px;
    min-width: 122px;
    background: var(--color-pine);
    color: var(--color-cream);
    font-weight: 600;
    font-size: 0.875rem;
    border: 0;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .nl-button:hover { background: var(--color-pine-dark); }
  .nl-button:focus-visible { outline: 2px solid color-mix(in srgb, var(--color-amber-light) 60%, transparent); outline-offset: 2px; }

  .footer-privacy {
    margin: 8px 0 0 0;
    font-size: 0.75rem;
    line-height: 1.5;
    color: color-mix(in srgb, var(--color-paper-2) 65%, var(--color-pine-dark));
  }

  .footer-bottom-band {
    border-top: 1px solid color-mix(in srgb, var(--color-paper-2) 15%, transparent);
  }

  .footer-bottom-inner {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-block: 1.25rem;
  }
  @media (min-width: 640px) {
    .footer-bottom-inner {
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      padding-block: 1.375rem;
    }
  }

  .footer-legal {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: color-mix(in srgb, var(--color-paper-2) 80%, var(--color-pine-dark));
  }
  @media (min-width: 640px) {
    .footer-legal { flex-direction: row; align-items: center; gap: 0.75rem; }
  }

  .footer-legal-link {
    color: inherit;
    text-decoration: none;
    width: fit-content;
  }
  .footer-legal-link:hover,
  .footer-legal-link:focus-visible { color: var(--color-amber-light); }

  .footer-legal-sep {
    display: none;
    opacity: 0.6;
  }
  @media (min-width: 640px) {
    .footer-legal-sep { display: inline; }
  }

  .back-to-top {
    --scroll-progress: 0%;
    position: fixed;
    right: clamp(1rem, 3vw, 2rem);
    bottom: clamp(1rem, 3vw, 2rem);
    z-index: 40;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    padding: 0;
    overflow: hidden;
    color: var(--color-brand);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    box-shadow: 0 4px 14px rgba(42, 22, 22, 0.14);
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: scale(0.82);
    transition: opacity 220ms ease, transform 220ms ease, visibility 220ms;
  }

  .back-to-top.is-visible {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: scale(1);
  }

  .back-to-top:hover {
    color: var(--color-brand-hover);
    box-shadow: 0 6px 18px rgba(42, 22, 22, 0.2);
  }

  .back-to-top:focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: 3px;
  }

  .back-to-top-progress {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: var(--scroll-progress);
    background: var(--color-border-dark);
    opacity: 0.16;
    pointer-events: none;
  }

  .back-to-top-icon {
    position: relative;
    z-index: 1;
    pointer-events: none;
  }

  html[lang="zh"] .footer-heading,
  html[lang="zh"] .footer-brand-name { letter-spacing: 0; }

  @media (prefers-reduced-motion: reduce) {
    .footer-link, .nl-button, .footer-legal-link { transition: none; }
    footer a::after { transition: none; }
    .back-to-top { transition: none; }
  }
</style>

<script>
  let cleanupBackToTop: (() => void) | undefined;

  function initBackToTop() {
    cleanupBackToTop?.();

    const button = document.querySelector<HTMLButtonElement>('[data-back-to-top]');
    if (!button) return;

    let frameId = 0;

    const update = () => {
      frameId = 0;
      const scrollableHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = scrollableHeight > 0
        ? Math.min(100, Math.max(0, (window.scrollY / scrollableHeight) * 100))
        : 0;

      button.style.setProperty('--scroll-progress', `${progress}%`);
      button.classList.toggle('is-visible', window.scrollY > 200);
    };

    const requestUpdate = () => {
      if (frameId) return;
      frameId = window.requestAnimationFrame(update);
    };

    const scrollToTop = () => {
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
    };

    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate, { passive: true });
    button.addEventListener('click', scrollToTop);
    update();

    cleanupBackToTop = () => {
      window.removeEventListener('scroll', requestUpdate);
      window.removeEventListener('resize', requestUpdate);
      button.removeEventListener('click', scrollToTop);
      if (frameId) window.cancelAnimationFrame(frameId);
      cleanupBackToTop = undefined;
    };
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBackToTop, { once: true });
  } else {
    initBackToTop();
  }
  document.addEventListener('astro:page-load', initBackToTop);
</script>
