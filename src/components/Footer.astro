---
import { getTranslations, localePath, type Locale, type RouteLocale } from '../i18n/utils';

interface Props {
  lang: RouteLocale;
  uiLang: Locale;
}
const { lang, uiLang } = Astro.props;
const t = getTranslations(uiLang);
const contactHref = localePath(lang, 'contact');
const privacyHref = lang === 'en' ? '/privacy-policy/' : localePath(lang, 'policies/privacy-policy');
const backToTopLabel = lang === 'en' ? 'Back to top' : uiLang === 'zh' ? '返回顶部' : 'Về đầu trang';
const year = new Date().getFullYear();
---
<footer class="bg-brand text-cream mt-10">
  <div class="container-page py-10">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-10">
      <!-- Column 1: About -->
      <div>
        <h3 class="footer-heading">{t.footer.aboutHeadingPrefix} {t.common.siteName}</h3>
        <ul class="m-0 p-0 list-none space-y-2">
          <li><a class="footer-link" href="#">{t.footer.aboutLinks.story}</a></li>
          <li><a class="footer-link" href="#">{t.footer.aboutLinks.reads}</a></li>
          <li><a class="footer-link" href="#">{t.footer.aboutLinks.sustainability}</a></li>
        </ul>
      </div>

      <!-- Column 2: Support -->
      <div>
        <h3 class="footer-heading">{t.footer.supportHeading}</h3>
        <ul class="m-0 p-0 list-none space-y-2">
          <li><a class="footer-link" href={contactHref}>{t.footer.supportLinks.contact}</a></li>
          <li><a class="footer-link" href="#">{t.footer.supportLinks.faqs}</a></li>
          <li><a class="footer-link" href="#">{t.footer.supportLinks.wholesale}</a></li>
        </ul>
      </div>

      <!-- Column 3: Shop by Health Goal -->
      <div>
        <h3 class="footer-heading">{t.footer.shopHeading}</h3>
        <ul class="m-0 p-0 list-none space-y-2">
          <li><a class="footer-link" href="#">{t.footer.goals.immunity}</a></li>
          <li><a class="footer-link" href="#">{t.footer.goals.energy}</a></li>
          <li><a class="footer-link" href="#">{t.footer.goals.beauty}</a></li>
          <li><a class="footer-link" href="#">{t.footer.goals.sleep}</a></li>
        </ul>
      </div>

      <!-- Column 4: Newsletter -->
      <div>
        <h3 class="footer-heading">{t.footer.newsletter.heading}</h3>
        <p class="footer-desc">{t.footer.newsletter.subtext}</p>
        <form action="#" method="post" onsubmit="return false" class="nl-form">
          <label for="footer-email" class="sr-only">{t.footer.newsletter.emailPlaceholder}</label>
          <input id="footer-email" type="email" required placeholder={t.footer.newsletter.emailPlaceholder} class="nl-input" />
          <button type="submit" class="nl-button">{t.footer.newsletter.subscribeButton}</button>
        </form>
        <p class="footer-privacy">{t.footer.newsletter.privacyNote}</p>
      </div>
    </div>
  </div>

  <!-- Bottom bar -->
  <div class="border-t border-white/15">
    <div class="container-page py-5 flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
      <!-- Social icons -->
      <div class="flex items-center gap-4">
        <a href="#" aria-label="Facebook" class="text-cream hover:text-gold" rel="nofollow noopener">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M14 9h3V6h-3a4 4 0 0 0-4 4v3H7v3h3v6h3v-6h3l1-3h-4v-3a1 1 0 0 1 1-1Z" stroke="currentColor" stroke-width="1.5"/></svg>
        </a>
        <a href="#" aria-label="Instagram" class="text-cream hover:text-gold" rel="nofollow noopener">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="4" y="4" width="16" height="16" rx="4" stroke="currentColor" stroke-width="1.5"/><circle cx="12" cy="12" r="4" stroke="currentColor" stroke-width="1.5"/><circle cx="17.5" cy="6.5" r="1" fill="currentColor"/></svg>
        </a>
        <a href="#" aria-label="TikTok" class="text-cream hover:text-gold" rel="nofollow noopener">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 3v4a5 5 0 0 0 5 5h1v3a8 8 0 1 1-8-8V3Z" stroke="currentColor" stroke-width="1.5" fill="none"/></svg>
        </a>
        <a href="#" aria-label="YouTube" class="text-cream hover:text-gold" rel="nofollow noopener">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true"><rect x="3" y="7" width="18" height="10" rx="3" stroke="currentColor" stroke-width="1.5"/><path d="M10 10l5 2-5 2v-4Z" fill="currentColor"/></svg>
        </a>
      </div>

      <!-- Legal -->
      <div class="text-sm text-cream/90 flex flex-col sm:flex-row sm:items-center gap-2 sm:gap-4">
        <span>© {year} — {t.common.siteName}. {t.footer.rights}</span>
        <span class="hidden sm:inline">•</span>
        <a href="#" class="text-cream hover:text-gold no-underline w-fit">{t.footer.terms}</a>
        <span class="hidden sm:inline">|</span>
        <a href={privacyHref} class="text-cream hover:text-gold no-underline w-fit">{t.footer.privacy}</a>
      </div>
    </div>
  </div>

  <button
    type="button"
    class="back-to-top"
    aria-label={backToTopLabel}
    data-back-to-top
  >
    <span class="back-to-top-progress" aria-hidden="true"></span>
    <svg class="back-to-top-icon" width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
      <path d="M4.5 11.5 10 6l5.5 5.5M10 6v9" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
</footer>

<style>
  footer a {
    position: relative;
  }
  footer a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: -0.25rem;
    width: 100%;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 300ms ease-out;
  }
  footer a:hover::after,
  footer a:focus-visible::after {
    transform: scaleX(1);
  }

  .footer-heading {
    margin: 0 0 16px 0;
    font-family: var(--font-sans);
    font-weight: 600;
    line-height: 1.25;
    font-size: 1.125rem; /* ~18px */
    color: rgba(255, 255, 255, 0.96);
    letter-spacing: 0.012em;
  }

  .footer-link {
    display: inline-block;
    color: rgba(255,255,255,0.9);
    text-decoration: none;
    font-size: 0.9375rem; /* 15px */
    line-height: 1.55;
    transition: color 0.2s ease;
  }
  .footer-link:hover { color: var(--color-gold); }

  .footer-desc {
    margin: 0 0 14px 0;
    max-width: 34ch;
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgba(255,255,255,0.88);
  }

  .nl-form {
    display: flex;
    width: 100%;
    min-width: 0;
    height: 48px;
    align-items: stretch;
    border: 1px solid color-mix(in oklab, var(--color-gold) 30%, transparent);
    border-radius: var(--radius-pill);
    overflow: hidden;
    background: var(--color-cream);
  }
  .nl-form:focus-within { outline: 2px solid color-mix(in oklab, var(--color-gold) 55%, transparent); outline-offset: 2px; }

  .nl-input {
    flex: 1 1 auto;
    min-width: 0;
    border: 0;
    background: transparent;
    color: var(--color-body);
    padding: 0 14px 0 16px;
    font-size: 0.9375rem;
  }
  .nl-input::placeholder { color: color-mix(in oklab, var(--color-body) 60%, white); }
  .nl-input:focus { outline: none; }

  .nl-button {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 18px;
    min-width: 122px;
    background: var(--color-brand);
    color: #fff;
    font-weight: 600;
    border: 0;
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease;
  }
  .nl-button:hover { background: var(--color-brand-hover); }
  .nl-button:focus-visible { outline: 2px solid color-mix(in oklab, var(--color-gold) 60%, transparent); outline-offset: 2px; }

  .footer-privacy {
    margin: 8px 0 0 0;
    font-size: 0.75rem; /* 12px */
    line-height: 1.5;
    color: rgba(255,255,255,0.78);
  }

  .back-to-top {
    --scroll-progress: 0%;
    position: fixed;
    right: clamp(1rem, 3vw, 2rem);
    bottom: clamp(1rem, 3vw, 2rem);
    z-index: 40;
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    padding: 0;
    overflow: hidden;
    color: var(--color-brand);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-pill);
    box-shadow: 0 4px 14px rgba(42, 22, 22, 0.14);
    cursor: pointer;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transform: scale(0.82);
    transition: opacity 220ms ease, transform 220ms ease, visibility 220ms;
  }

  .back-to-top.is-visible {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: scale(1);
  }

  .back-to-top:hover {
    color: var(--color-brand-hover);
    box-shadow: 0 6px 18px rgba(42, 22, 22, 0.2);
  }

  .back-to-top:focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: 3px;
  }

  .back-to-top-progress {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 100%;
    height: var(--scroll-progress);
    background: var(--color-border-dark);
    opacity: 0.16;
    pointer-events: none;
  }

  .back-to-top-icon {
    position: relative;
    z-index: 1;
    pointer-events: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .footer-link, .nl-button { transition: none; }
    footer a::after { transition: none; }
    .back-to-top { transition: none; }
  }
</style>

<script>
  let cleanupBackToTop: (() => void) | undefined;

  function initBackToTop() {
    cleanupBackToTop?.();

    const button = document.querySelector<HTMLButtonElement>('[data-back-to-top]');
    if (!button) return;

    let frameId = 0;

    const update = () => {
      frameId = 0;
      const scrollableHeight = document.documentElement.scrollHeight - window.innerHeight;
      const progress = scrollableHeight > 0
        ? Math.min(100, Math.max(0, (window.scrollY / scrollableHeight) * 100))
        : 0;

      button.style.setProperty('--scroll-progress', `${progress}%`);
      button.classList.toggle('is-visible', window.scrollY > 200);
    };

    const requestUpdate = () => {
      if (frameId) return;
      frameId = window.requestAnimationFrame(update);
    };

    const scrollToTop = () => {
      const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      window.scrollTo({ top: 0, behavior: reduceMotion ? 'auto' : 'smooth' });
    };

    window.addEventListener('scroll', requestUpdate, { passive: true });
    window.addEventListener('resize', requestUpdate, { passive: true });
    button.addEventListener('click', scrollToTop);
    update();

    cleanupBackToTop = () => {
      window.removeEventListener('scroll', requestUpdate);
      window.removeEventListener('resize', requestUpdate);
      button.removeEventListener('click', scrollToTop);
      if (frameId) window.cancelAnimationFrame(frameId);
      cleanupBackToTop = undefined;
    };
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initBackToTop, { once: true });
  } else {
    initBackToTop();
  }
  document.addEventListener('astro:page-load', initBackToTop);
</script>
