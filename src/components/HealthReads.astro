---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Locale } from '../i18n/utils';
import { getTranslations, localePath } from '../i18n/utils';

import imgChild from '../assets/images/health-reads/childrens-health.svg';
import imgChronic from '../assets/images/health-reads/chronic-illness.svg';
import imgWomen from '../assets/images/health-reads/women-health.svg';
import imgTcm from '../assets/images/health-reads/tcm-basics.svg';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = getTranslations(lang);

type HRKey = 'childrensHealth' | 'chronicIllness' | 'womensHealth' | 'tcmBasics';
const items: ReadonlyArray<{ key: HRKey; image: ImageMetadata }> = [
  { key: 'childrensHealth', image: imgChild },
  { key: 'chronicIllness', image: imgChronic },
  { key: 'womensHealth', image: imgWomen },
  { key: 'tcmBasics', image: imgTcm },
];
---
<section class="py-8 sm:py-10" aria-labelledby="health-reads-heading">
  <div class="container-page">
    <!-- Header -->
    <div class="text-center mb-7 sm:mb-9">
      <p class="hr-eyebrow m-0 mb-1">{t.healthReads.eyebrow}</p>
      <h2 id="health-reads-heading" class="hr-heading font-serif m-0">{t.healthReads.heading}</h2>
    </div>

    <!-- Responsive list: horizontal scroll on mobile, grid from sm+ -->
    <ul
      class="hr-scroll m-0 flex list-none gap-4 overflow-x-auto p-0 sm:grid sm:grid-cols-2 sm:gap-5 sm:overflow-visible lg:grid-cols-4 lg:gap-6"
      role="list"
    >
      {items.map((it) => {
        const d = t.healthReads.items[it.key];
        const href = localePath(lang, `health-reads/${d.slug}`);
        return (
          <li class="hr-card h-full">
            <article class="group h-full">
              <a href={href} data-astro-reload class="block h-full rounded-card overflow-hidden bg-surface border border-border focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold/60">
                <div class="relative aspect-square overflow-hidden">
                  <Image src={it.image} alt="" width={640} height={640} loading="lazy" decoding="async" class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-105" />
                </div>
                <div class="p-4">
                  <h3 class="m-0 font-serif text-[18px] sm:text-[19px] leading-snug text-heading truncate">{d.title}</h3>
                  <p class="hr-description m-0 mt-2">{d.description}</p>
                </div>
              </a>
            </article>
          </li>
        );
      })}
    </ul>

    <!-- CTA -->
    <div class="mt-7 sm:mt-8 text-center">
      <a href={localePath(lang, 'health-reads')} data-astro-reload class="btn btn-secondary no-underline transition-colors duration-300 hover:no-underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-gold/70">
        {t.healthReads.ctaViewAll}
      </a>
    </div>
  </div>
</section>

<style>
  .hr-eyebrow {
    color: var(--color-brand);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  @media (min-width: 640px) {
    .hr-eyebrow { font-size: 1.375rem; }
  }

  /* 1.25, not the usual 1.15 -- see BrandStory.astro's .bs-heading comment
     for why (Playfair Display's vertical metrics need more room than 1.15
     gives if this heading wraps to 2 lines on narrow viewports). */
  .hr-heading {
    color: var(--color-heading);
    font-size: 1.75rem;
    font-weight: 700;
    line-height: 1.25;
  }
  @media (min-width: 640px) {
    .hr-heading { font-size: 2.25rem; }
  }

  /* Horizontal scroll behavior on small screens */
  .hr-scroll {
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
  }
  .hr-scroll::-webkit-scrollbar { display: none; }
  .hr-card {
    flex: 0 0 82%;
    scroll-snap-align: start;
  }
  @media (min-width: 480px) {
    .hr-card { flex-basis: 68%; }
  }
  @media (min-width: 640px) {
    .hr-card { flex: unset; scroll-snap-align: unset; }
  }

  /* Slight downscale for ultra-narrow devices for better balance */
  @media (max-width: 360px) {
    .hr-heading { font-size: 1.625rem; }
  }

  .hr-description {
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--color-body);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    /* `height`, not `min-height`: on a `-webkit-box` (the box model
       `-webkit-line-clamp` requires), `min-height` is not reliably honored
       by the browser -- a 1-line-worth description just renders at its
       natural 1-line content height regardless of min-height, so shorter
       cards end up shorter than their siblings. An explicit `height`
       forces the box itself, so a shorter description simply leaves blank
       space below it instead of shrinking the box.

       The title above (`<h3>`) doesn't need this same treatment: it's
       clamped to exactly 1 line via the `truncate` utility class in the
       markup instead of a 2-line reservation here, so its box is always
       naturally the same height on every card -- no dead gap between a
       short title and the description that follows it. */
    height: calc(0.875rem * 1.6 * 2);
  }
</style>
