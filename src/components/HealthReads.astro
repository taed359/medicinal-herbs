---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import type { Locale } from '../i18n/utils';
import { getTranslations, localePath } from '../i18n/utils';

import imgChild from '../assets/images/health-reads/childrens-health.svg';
import imgChronic from '../assets/images/health-reads/chronic-illness.svg';
import imgWomen from '../assets/images/health-reads/women-health.svg';
import imgTcm from '../assets/images/health-reads/tcm-basics.svg';

interface Props { lang: Locale }
const { lang } = Astro.props;
const t = getTranslations(lang);

type HRKey = 'childrensHealth' | 'chronicIllness' | 'womensHealth' | 'tcmBasics';
const items: ReadonlyArray<{ key: HRKey; image: ImageMetadata }> = [
  { key: 'childrensHealth', image: imgChild },
  { key: 'chronicIllness', image: imgChronic },
  { key: 'womensHealth', image: imgWomen },
  { key: 'tcmBasics', image: imgTcm },
];

// Stage: "featured + list" redesign (was a single, uniform divided list --
// see the git history/claude/project-status.md for why: this section
// deliberately avoided a 3rd card grid on a homepage that already has two
// -- HealthGoals' discovery grid and NaturalOils' commerce grid). That
// reasoning still holds for the REST of the items below, which stay a
// plain divided list, not a grid. The first item now gets a distinct,
// larger "lead story" treatment instead -- an asymmetric hero+list
// pattern (the same one health/editorial sites use for an article index)
// gives the section a clear focal point and visual hierarchy without
// reintroducing a uniform grid: there is still only ONE card-like element
// here, not a repeated tile pattern.
const [featured, ...rest] = items;

// ROUTE STATUS, re-verified fresh for this stage: no route exists under
// `health-reads/{slug}` OR under `blogs/{slug}` anywhere in src/pages.
// Worth noting separately: the i18n schema itself declares
// `t.healthReads.basePath === 'blogs'` (see src/i18n/utils.ts,
// vi.ts/zh.ts) but this component has never actually used that field --
// it hardcodes `health-reads` instead, a real, pre-existing discrepancy
// between the declared intended path and the one actually linked.
// Neither `health-reads/*` nor `blogs/*` exists today either way, so
// this pass does not resolve which one is "correct" -- that's a content/
// routing decision, not a visual one. Each article's existing (still
// unresolved) destination is preserved unchanged rather than guessed at
// or swapped to "#".
//
// The section-level "view all" CTA: still UI-only for the same
// missing-route reason above (confirmed with the user previously, same
// treatment already used for AnnouncementBar's store-locator button). So
// `t.healthReads.ctaViewAll` renders below as a real, unwired `<button>`
// -- never an `<a href="#">`, which would silently jump to the top of
// the page -- so nothing here claims a working destination that doesn't
// exist yet. Wire it to a real href once an actual index route exists
// under either `health-reads/` or `blogs/` (see the basePath discrepancy
// noted above -- worth resolving at the same time, since the individual
// article links need the same fix).
const featuredData = t.healthReads.items[featured.key];
const featuredHref = localePath(lang, `health-reads/${featuredData.slug}`);
---
<section class="hr-section" aria-labelledby="health-reads-heading">
  <div class="container-editorial">
    <div class="hr-header text-center mb-7 sm:mb-9">
      <p class="eyebrow m-0 mb-1">{t.healthReads.eyebrow}</p>
      <h2 id="health-reads-heading" class="text-heading-section font-serif m-0">{t.healthReads.heading}</h2>
    </div>

    <div class="hr-layout">
      <!--
        Lead story -- one link, same aria-label-on-the-anchor pattern the
        list rows below (and ProductCard elsewhere) already use, so a
        screen reader announces just the title, not the full paragraph,
        as the link's accessible name.
      -->
      <a href={featuredHref} data-astro-reload aria-label={featuredData.title} class="hr-feature group">
        <span class="hr-feature-media">
          <Image src={featured.image} alt="" width={480} height={480} loading="lazy" decoding="async" class="h-full w-full object-cover" />
        </span>
        <span class="hr-feature-text">
          <span class="hr-feature-kicker">
            <span class="hr-feature-index" aria-hidden="true">01</span>
            <span class="hr-feature-label">{t.healthReads.featuredLabel}</span>
          </span>
          <h3 class="hr-feature-title font-serif m-0">
            {featuredData.title}
          </h3>
          <p class="hr-feature-description m-0 mt-2">{featuredData.description}</p>
          <span class="hr-feature-cta" aria-hidden="true">
            {t.healthReads.readMore}
            <span class="hr-row-arrow" aria-hidden="true"> →</span>
          </span>
        </span>
      </a>

      <!-- Remaining articles: a plain divided list, deliberately not a
           second card treatment -- see the frontmatter comment above. -->
      <ul class="hr-list m-0 p-0 list-none" role="list">
        {rest.map((it, i) => {
          const d = t.healthReads.items[it.key];
          const href = localePath(lang, `health-reads/${d.slug}`);
          return (
            <li class="hr-row">
              <a href={href} data-astro-reload aria-label={d.title} class="hr-row-link group">
                <span class="hr-row-index" aria-hidden="true">{String(i + 2).padStart(2, '0')}</span>
                <span class="hr-row-thumb">
                  <Image src={it.image} alt="" width={220} height={220} loading="lazy" decoding="async" class="h-full w-full object-cover" />
                </span>
                <span class="hr-row-text">
                  <h3 class="text-heading-card font-serif m-0">
                    {d.title}
                    <span class="hr-row-arrow" aria-hidden="true"> →</span>
                  </h3>
                  <p class="hr-row-description m-0 mt-1">{d.description}</p>
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>

    <div class="hr-view-all-wrap">
      <button type="button" class="hr-view-all btn-tertiary">
        {t.healthReads.ctaViewAll}
        <span class="btn-tertiary-arrow" aria-hidden="true">→</span>
      </button>
    </div>
  </div>
</section>

<style>
  /* Quiet editorial section, now with one clear focal point (the lead
     story) instead of a flat, uniform list -- still restrained relative
     to BrandStory/TrustCertifications' fuller rhythm, same reasoning as
     ExpertConsultation's own spacing decision. */
  .hr-section {
    padding-block: 2rem;
    background: var(--color-cream);
  }
  @media (min-width: 640px) {
    .hr-section { padding-block: 2.75rem; }
  }
  @media (min-width: 1024px) {
    .hr-section { padding-block: 3.5rem; }
  }

  .hr-header .eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  .hr-header .text-heading-section {
    font-size: 2.125rem;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  .hr-layout {
    display: flex;
    flex-direction: column;
    gap: 2.5rem;
  }

  /* ---------- Lead story ---------- */
  .hr-feature {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    text-decoration: none;
    color: inherit;
    background: var(--color-paper-2);
    border: 1px solid color-mix(in srgb, var(--color-pine-dark) 11%, var(--color-paper-2));
    border-radius: var(--radius-editorial);
    overflow: hidden;
    box-shadow: 0 6px 20px -16px color-mix(in srgb, var(--color-pine-dark) 30%, transparent);
    transition: border-color 0.2s ease, box-shadow 0.2s ease, transform 0.2s ease;
  }
  .hr-feature:hover,
  .hr-feature:focus-visible {
    border-color: color-mix(in srgb, var(--color-amber-decorative) 55%, var(--color-paper-2));
    box-shadow: 0 16px 36px -18px color-mix(in srgb, var(--color-pine-dark) 42%, transparent);
    transform: translateY(-2px);
  }
  .hr-feature:focus-visible {
    outline: 2px solid var(--color-pine);
    outline-offset: 3px;
  }

  @media (min-width: 768px) {
    .hr-feature { flex-direction: row; align-items: stretch; gap: 0; }
  }

  .hr-feature-media {
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--color-paper-2);
  }
  .hr-feature-media :global(img) {
    transition: transform 0.4s ease;
  }
  .hr-feature:hover .hr-feature-media :global(img),
  .hr-feature:focus-visible .hr-feature-media :global(img) {
    transform: scale(1.05);
  }
  @media (min-width: 768px) {
    .hr-feature-media { flex: 0 0 42%; aspect-ratio: auto; }
  }

  .hr-feature-text {
    display: flex;
    flex-direction: column;
    padding: 0 1.5rem 1.75rem;
  }
  @media (min-width: 768px) {
    .hr-feature-text {
      flex: 1;
      justify-content: center;
      padding: 2rem 2.5rem;
      max-width: 34rem;
    }
  }

  .hr-feature-kicker {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: 0.75rem;
  }
  .hr-feature-index {
    font-family: var(--font-serif);
    font-size: 0.8125rem;
    font-weight: 600;
    color: var(--color-amber-decorative);
  }
  .hr-feature-label {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-amber);
  }
  html[lang="zh"] .hr-feature-label { letter-spacing: 0; }

  .hr-feature-title {
    font-size: 1.5rem;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.005em;
    color: var(--color-pine-dark);
  }
  @media (min-width: 1024px) {
    .hr-feature-title { font-size: 1.75rem; }
  }
  html[lang="zh"] .hr-feature-title { letter-spacing: 0; line-height: 1.5; }

  .hr-feature-description {
    max-width: 42rem;
    font-size: 1rem;
    line-height: 1.65;
    color: var(--color-body);
  }

  /* Explicit "read more" affordance for the lead card only -- decorative
     (aria-hidden, see the markup comment) since the whole card is already
     one link with its own accessible name. The larger footprint of the
     lead card benefits from a stated next action instead of relying on
     the reader to notice a small trailing arrow the way the compact list
     rows below it do. */
  .hr-feature-cta {
    display: inline-flex;
    align-items: center;
    margin-top: 1.125rem;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-pine-dark);
    padding-bottom: 0.1875rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-pine-dark) 35%, transparent);
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .group:hover .hr-feature-cta,
  .group:focus-visible .hr-feature-cta {
    border-color: var(--color-amber-decorative);
  }
  .hr-feature-cta .hr-row-arrow {
    opacity: 1;
    margin-left: 0.375rem;
  }

  /* ---------- Remaining articles: plain divided list ---------- */
  .hr-list {
    width: 100%;
    border-top: 1px solid color-mix(in srgb, var(--color-pine-dark) 11%, var(--color-surface));
  }

  .hr-row {
    border-bottom: 1px solid color-mix(in srgb, var(--color-pine-dark) 11%, var(--color-surface));
  }

  .hr-row-link {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding-block: 1.25rem;
    /* Negative inline margin cancels the added inline padding below, so
       the row's TEXT still lines up at the same left edge as before --
       only the hover fill (next rule) gets the extra breathing room. */
    padding-inline: 0.75rem;
    margin-inline: -0.75rem;
    border-radius: var(--radius-editorial);
    transition: background-color 0.2s ease;
  }
  @media (min-width: 640px) {
    .hr-row-link { align-items: center; gap: 1.375rem; padding-block: 1.375rem; }
  }

  /* Row hover feedback -- a faint amber wash (7% mix, well below anything
     that would fight the row text's own contrast) plus a matching thumb-
     border tint reuses the same amber-decorative accent the arrow already
     uses on hover, instead of introducing a new color. */
  .hr-row-link:hover,
  .hr-row-link:focus-visible {
    background-color: color-mix(in oklab, var(--color-amber-decorative) 7%, transparent);
  }
  .hr-row-link:hover .hr-row-thumb,
  .hr-row-link:focus-visible .hr-row-thumb {
    border-color: color-mix(in srgb, var(--color-amber-decorative) 45%, var(--color-surface));
  }
  .hr-row-link:hover .hr-row-thumb :global(img),
  .hr-row-link:focus-visible .hr-row-thumb :global(img) {
    transform: scale(1.06);
  }

  /* Small serif numeral, hidden on the narrowest screens where every bit
     of horizontal room goes to the thumbnail + text instead. */
  .hr-row-index {
    display: none;
    flex-shrink: 0;
    align-self: center;
    font-family: var(--font-serif);
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-amber-decorative);
    min-width: 1.25rem;
  }
  @media (min-width: 640px) {
    .hr-row-index { display: block; }
  }

  .hr-row-thumb {
    display: block;
    flex-shrink: 0;
    width: 4.5rem;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-pine-dark) 10%, var(--color-surface));
    border-radius: var(--radius-editorial);
    transition: border-color 0.2s ease;
  }
  .hr-row-thumb :global(img) {
    transition: transform 0.3s ease;
  }
  @media (min-width: 640px) {
    .hr-row-thumb { width: 5.25rem; }
  }

  .hr-row-text { min-width: 0; }

  /* Desktop only: caps the row's actual readable content (title +
     description) to an editorial measure -- .hr-list itself stays full
     width, this only stops the row's TEXT from stretching to fill the
     full container once the description's own 2-line clamp and the
     title's short length leave far more room than either needs. */
  @media (min-width: 1024px) {
    .hr-row-text { max-width: 34rem; }
  }

  /* Scoped bump, not a change to the shared .text-heading-card class:
     that class is also ProductCard's title size on the actual product
     listing/detail pages, so it stays untouched -- this overrides it
     for HealthReads' own article titles only, via the extra .hr-row-text
     ancestor class (higher specificity than the shared 0,1,0 rule). */
  .hr-row-text .text-heading-card {
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.4;
  }

  .hr-row-arrow {
    display: inline-block;
    color: var(--color-amber);
    opacity: 0.7;
    transition: opacity 0.2s ease, color 0.2s ease, transform 0.2s ease;
  }
  .group:hover .hr-row-arrow,
  .group:focus-visible .hr-row-arrow {
    color: var(--color-pine);
    opacity: 1;
    transform: translateX(2px);
  }
  .group:focus-visible {
    outline: 2px solid var(--color-pine);
    outline-offset: 3px;
    border-radius: var(--radius-editorial);
  }

  .hr-row-description {
    max-width: 70ch;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--color-body);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }

  html[lang="zh"] .hr-row-text h3 { letter-spacing: 0; }
  html[lang="zh"] .hr-header .text-heading-section { letter-spacing: 0; }

  /* Section-level "view all" -- centered below the layout rather than
     NaturalOils' left-heading/right-CTA header row (.no-header): that
     split-header treatment is a commerce-grid convention, and adopting
     it here would restructure this section's own established "quiet
     editorial" identity just to fit a CTA. A centered link keeps that
     intact. Reuses the sitewide .btn-tertiary/.btn-tertiary-arrow base
     (see global.css) with the same editorial-token color override
     NaturalOils' own .no-view-all already applies (pine-dark, not the
     generic --color-brand), since this section uses that same token
     family throughout. */
  .hr-view-all-wrap {
    margin-top: 2.25rem;
    text-align: center;
  }

  .hr-view-all {
    /* .btn-tertiary (global.css) was authored for <a> elements -- this is
       a <button> instead (see the frontmatter comment: no real href to
       point it at yet), so unlike NaturalOils' anchor-based .no-view-all
       this also needs the UA button reset .btn-tertiary doesn't provide:
       buttons don't inherit font-family/size from the page by default,
       and need an explicit cursor. */
    font: inherit;
    cursor: pointer;
    padding: 0 0 0.125rem;
    border-bottom: 1px solid var(--color-pine-dark);
    color: var(--color-pine-dark);
    font-size: 0.875rem;
  }
  .hr-view-all:hover,
  .hr-view-all:focus-visible {
    color: var(--color-amber);
    border-color: var(--color-amber);
  }

  @media (prefers-reduced-motion: reduce) {
    .hr-row-arrow,
    .hr-row-link,
    .hr-row-thumb,
    .hr-row-thumb :global(img),
    .hr-feature,
    .hr-feature-media :global(img) {
      transition: none;
    }
    .hr-feature:hover,
    .hr-feature:focus-visible {
      transform: none;
    }
  }
</style>
