---
import { getImage } from 'astro:assets';
import { getTranslations, localePath, type Locale } from '../i18n/utils';
import { HEALTH_GOALS } from '../lib/health-goals';

interface Props {
  lang?: Locale;
}

const { lang = 'vi' } = Astro.props;

// format: 'svg' passes each file through unchanged (still hashed and
// emitted via the normal asset pipeline) instead of trying to rasterize
// it -- astro:assets' <Image> component would try to raster-process these
// (and throw, since Astro's default sharp service can't rasterize SVG
// without image.dangerouslyProcessSVG), same pass-through pattern as
// Hero.astro / BrandStory.astro.
const GOALS = await Promise.all(
  HEALTH_GOALS.map(async (goal) => ({
    ...goal,
    imageSrc: (await getImage({ src: goal.image, format: 'svg' })).src,
  }))
);

const t = getTranslations(lang);

// Every href below (mobile carousel AND the desktop grid) links to
// src/pages/{vi,zh}/health-goals/[slug].astro -- a real, built page for
// each of the 9 goals (see src/lib/health-goals.ts, the shared list both
// this component and those routes read from).
---

<!-- HealthGoals shares the homepage's warm paper field. Its spacing is
     controlled locally so the image-led discovery rhythm can remain
     distinct from both Process above and NaturalOils below. -->
<section class="hg-section" aria-label={t.healthGoals.sectionLabel}>
  <div class="container-editorial">
    <div class="hg-header">
      <p class="eyebrow m-0 mb-1">{t.healthGoals.eyebrow}</p>
      <h2 class="text-heading-section font-serif m-0">{t.healthGoals.heading}</h2>
    </div>
  </div>

  <!--
    Below `lg` (1024px): the existing Swiper carousel -- same data,
    breakpoints (1.5/3 slides), navigation, pagination, and behavior.
    Only the presentation changes from an overlay card to an image-first
    editorial rail with its label beneath the image.
  -->
  <div class="lg:hidden">
    <div class="container-editorial" data-health-goals-root>
      <div class="hg-carousel">
        <div class="swiper health-goals-swiper" data-health-goals-swiper>
          <div class="swiper-wrapper">
            {GOALS.map((goal) => {
              const label = t.healthGoals.items[goal.key];
              return (
                <div class="swiper-slide">
                  <a
                    href={localePath(lang, `health-goals/${goal.slug}`)}
                    data-astro-reload
                    class="hg-card group block"
                  >
                    <div class="hg-card-image">
                      <img
                        src={goal.imageSrc}
                        alt=""
                        loading="lazy"
                        decoding="async"
                        class="h-full w-full object-cover"
                      />
                    </div>
                    <span class="hg-card-label">
                      <span class="hg-card-label-text">{label}</span>
                      <span class="hg-card-arrow" aria-hidden="true">→</span>
                    </span>
                  </a>
                </div>
              );
            })}
          </div>
        </div>

        <button type="button" class="hg-nav hg-nav-prev swiper-button-prev" aria-label={t.healthGoals.prev}></button>
        <button type="button" class="hg-nav hg-nav-next swiper-button-next" aria-label={t.healthGoals.next}></button>
      </div>

      <div class="hg-pagination-row">
        <div class="hg-pagination"></div>
      </div>
    </div>
  </div>

  <!--
    `lg` and up: a uniform 3x3 editorial grid of all 9 goals -- the same
    photo-then-label tile for every goal (image ratio, label size, hover
    behavior all identical, see .hg-tile-image / .hg-tile-label below).
    Earlier versions of this section singled out the first goal as a
    larger "featured" tile (first a stretched-height photo, then a fixed
    4:3 ratio, then a full-bleed hero overlay) -- all three read as
    either oversized or as leaving dead space next to the smaller grid.
    A uniform grid sidesteps that whole class of problem: no column ever
    needs to match another column's height, because every tile already
    has the same fixed aspect ratio and the same label footprint. It also
    matches reality better -- no goal is being editorially "featured" for
    health-priority reasons, so treating all nine the same is the more
    honest layout, not just the simpler one.
  -->
  <div class="hidden lg:block">
    <div class="container-editorial">
      <ul class="hg-grid m-0 p-0 list-none" role="list">
        {GOALS.map((goal) => {
          const label = t.healthGoals.items[goal.key];
          return (
            <li class="hg-tile">
              <a href={localePath(lang, `health-goals/${goal.slug}`)} data-astro-reload class="group block">
                <div class="hg-tile-image relative overflow-hidden">
                  <img
                    src={goal.imageSrc}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover"
                  />
                </div>
                <h3 class="hg-tile-label font-serif m-0">
                  <span class="hg-tile-label-text">{label}</span>
                  <span class="hg-tile-arrow" aria-hidden="true">→</span>
                </h3>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </div>
</section>

<style>
  .hg-section {
    padding-block: 1.25rem;
    background: var(--color-cream);
  }

  .hg-header {
    margin-bottom: 2.5rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid color-mix(in srgb, var(--color-pine-dark) 11%, var(--color-cream));
    text-align: left;
  }

  .hg-header .eyebrow {
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.16em;
  }

  .hg-header .text-heading-section {
    font-size: 2.125rem;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }

  @media (min-width: 640px) {
    .hg-section { padding-block: 1.5rem; }
  }

  @media (min-width: 1024px) {
    .hg-section { padding-block: 1.75rem; }
    .hg-header {
      margin-bottom: 3rem;
      padding-bottom: 2.25rem;
    }
  }

  /* Mobile/tablet carousel (below lg). */
  .hg-carousel {
    position: relative;
    --swiper-navigation-size: 42px;
    --swiper-navigation-sides-offset: 0.75rem;
    --swiper-navigation-color: var(--color-brand);
  }

  .health-goals-swiper {
    overflow: hidden;
  }
  .health-goals-swiper .swiper-wrapper {
    display: flex;
    gap: 15px;
  }
  .health-goals-swiper:not(.swiper-initialized) .swiper-slide {
    flex: 0 0 calc((100% - 7.5px) / 1.5);
  }
  @media (min-width: 640px) {
    .health-goals-swiper .swiper-wrapper {
      gap: 20px;
    }
    .health-goals-swiper:not(.swiper-initialized) .swiper-slide {
      flex-basis: calc((100% - 40px) / 3);
    }
  }
  .health-goals-swiper.swiper-initialized .swiper-wrapper {
    gap: 0;
  }

  .hg-card {
    color: var(--color-pine-dark);
    text-decoration: none;
  }

  .hg-card-image {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--color-pine-dark) 11%, var(--color-cream));
    border-radius: var(--radius-editorial);
    background: var(--color-cream);
    transition: border-color 250ms ease;
  }

  .hg-card-image img,
  .hg-tile-image img {
    transition: transform 450ms ease;
  }

  /* Label geometry (mobile card) -- a proper 2-column grid rather than
     inline text + inline arrow, so the arrow always sits in its own fixed
     column at the tile's right edge instead of trailing immediately after
     however long the title happens to be. `minmax(0, 1fr)` on the text
     column is what lets it actually wrap instead of overflowing: a plain
     flex/grid item defaults to a content-based minimum width and won't
     shrink below it, which is exactly what let long titles push the arrow
     out of alignment before this fix.
     min-height reserves space for 2 lines using the LARGER of the two
     locales' line-heights (zh: 1.6) so a 2-line zh title never exceeds the
     block a 2-line vi title (1.4) was sized for -- sizing to the smaller
     value would let zh overflow and reintroduce the same misalignment this
     is fixing. */
  .hg-card-label {
    display: flex;
    align-items: flex-start;
    column-gap: 0.625rem;
    margin-top: 0.875rem;
    min-height: 3.4rem; /* 2 lines at 1.0625rem font-size / 1.6 line-height (zh) -- same constants as the desktop .hg-tile-label */
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    font-weight: 500;
    line-height: 1.4;
  }
  html[lang="zh"] .hg-card-label { letter-spacing: 0; line-height: 1.6; }
  .hg-card-label-text { min-width: 0; flex: 0 1 auto; text-wrap: balance; }

  .hg-card-arrow,
  .hg-tile-arrow {
    flex: 0 0 auto;
    color: var(--color-amber);
    font-family: var(--font-sans);
    font-weight: 400;
    font-size: 0.875em;
    line-height: 1.4;
    transition: color 250ms ease, transform 250ms ease;
  }

  .hg-card:hover .hg-card-image img,
  .hg-card:focus-visible .hg-card-image img,
  .group:hover .hg-tile-image img,
  .group:focus-visible .hg-tile-image img {
    transform: scale(1.035);
  }

  .hg-card:hover .hg-card-image,
  .hg-card:focus-visible .hg-card-image,
  .group:hover .hg-tile-image,
  .group:focus-visible .hg-tile-image {
    border-color: color-mix(in srgb, var(--color-amber-decorative) 45%, var(--color-border));
  }

  .hg-card:hover .hg-card-arrow,
  .hg-card:focus-visible .hg-card-arrow,
  .group:hover .hg-tile-arrow,
  .group:focus-visible .hg-tile-arrow {
    color: var(--color-pine);
    transform: translateX(2px);
  }


  .hg-card:focus-visible {
    outline: 2px solid var(--color-pine);
    outline-offset: 3px;
  }

  .hg-pagination-row {
    margin-top: 1.25rem;
    display: flex;
    justify-content: center;
  }

  .hg-pagination {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
    width: 100%;
    max-width: 20rem;
    min-height: 28px;
  }

  .hg-pagination :global(.swiper-pagination-bullet) {
    position: relative;
    flex: 0 0 28px;
    width: 28px;
    height: 28px;
    border-radius: var(--radius-pill);
    background: transparent;
    opacity: 1;
    margin: 0 !important;
  }

  .hg-pagination :global(.swiper-pagination-bullet)::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-border-dark);
    opacity: 0.45;
    transform: translate(-50%, -50%);
    transition: background-color 0.3s ease, opacity 0.3s ease;
  }

  .hg-pagination :global(.swiper-pagination-bullet-active)::after {
    background: var(--color-pine);
    opacity: 1;
  }

  .hg-pagination :global(.swiper-pagination-bullet):focus-visible {
    outline: 2px solid var(--color-pine);
    outline-offset: -3px;
  }

  .hg-nav {
    display: none;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    padding: 0;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 9999px;
    box-shadow: none;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }
  .hg-nav:hover {
    border-color: var(--color-pine);
  }
  .hg-nav:focus-visible {
    outline: 2px solid var(--color-brand);
    outline-offset: 2px;
  }
  .hg-nav :global(.swiper-navigation-icon) {
    width: 13px;
    height: 13px;
  }
  /* Nav arrows only ever mattered at >=1024px in the old single-layout
     version; kept here (inert) purely because this whole block now lives
     inside `lg:hidden`, so it can never actually reach that width. */
  @media (min-width: 1024px) {
    .hg-nav {
      display: flex;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hg-card img { transition: none !important; }
    .hg-card-arrow { transition: none !important; }
    .hg-nav { transition: none !important; }
    .hg-pagination :global(.swiper-pagination-bullet)::after { transition: none !important; }
  }

  /* Desktop editorial grid (lg and up): a uniform grid, not an
     asymmetric one. Every tile shares the exact same fixed-ratio image
     (.hg-tile-image, 1:1) and the exact same label footprint
     (.hg-tile-label) -- there is no "featured" tile anymore (see the
     template comment above for why three different attempts at treating
     the first goal specially didn't work out: a derived stretched
     height read as oversized, a fixed 4:3 ratio left dead space next to
     the taller supporting grid, and a full-bleed hero overlay still read
     as visually heavier/worse than just keeping every tile the same).
     Three columns x three rows exactly fits the fixed list of 9 goals
     with no leftover cells; if that list ever grows or shrinks,
     `grid-template-columns` may need revisiting, but nothing else in
     this rule depends on the count. */
  .hg-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem 1.75rem;
  }

  .hg-tile {
    min-width: 0;
  }

  .hg-tile-image {
    aspect-ratio: 1 / 1;
    border-radius: var(--radius-editorial);
    background: var(--color-cream);
    border: 1px solid color-mix(in srgb, var(--color-pine-dark) 11%, var(--color-cream));
    transition: border-color 250ms ease;
  }

  /* Label geometry (desktop grid) -- same reasoning as .hg-card-label
     above: a flex row that hugs its own content, so the arrow trails
     immediately after the title instead of being pinned to the tile's
     far right edge. The text item still shrinks/wraps via `flex: 0 1
     auto` + `min-width: 0` for the longest titles (zh) without forcing
     the row past the tile.

     min-height reserves 2 lines using zh's line-height (1.6, taller than
     vi's 1.4) as the universal value, so a 1-line title and a 2-line
     title -- in EITHER locale -- occupy an identical structural block,
     and every tile's image starts from the same baseline regardless of
     which goal happens to render longer. Every tile in the grid now
     shares this one class (there is no separate featured-tile label
     anymore), which is what keeps the whole 3x3 grid's rows aligned. */
  .hg-tile-label {
    display: flex;
    align-items: flex-start;
    column-gap: 0.75rem;
    margin-top: 0.75rem;
    min-height: 3.4rem; /* 2 lines at 1.0625rem font-size / 1.6 line-height (zh) */
    font-size: 1.0625rem;
    font-weight: 500;
    line-height: 1.4;
    color: var(--color-pine-dark);
  }
  html[lang="zh"] .hg-tile-label { letter-spacing: 0; line-height: 1.6; }
  .hg-tile-label-text { min-width: 0; flex: 0 1 auto; text-wrap: balance; }

  .group:focus-visible {
    outline: 2px solid var(--color-pine);
    outline-offset: 3px;
    border-radius: var(--radius-editorial);
  }

  @media (prefers-reduced-motion: reduce) {
    .hg-tile-image img { transition: none !important; }
    .hg-tile-arrow { transition: none !important; }
    .hg-card-image,
    .hg-tile-image { transition: none !important; }
  }

  html[lang="zh"] .hg-header .text-heading-section { letter-spacing: 0; }
</style>

<script>
  import { Swiper } from 'swiper';
  import { Pagination, Navigation, Keyboard, A11y } from 'swiper/modules';
  import 'swiper/css';
  import 'swiper/css/pagination';
  import 'swiper/css/navigation';

  // Below `lg` (1024px) only -- above that width the carousel's own
  // container is `display:none` (see the `lg:hidden` wrapper in the
  // markup) and the static desktop grid takes over instead. Initializing
  // Swiper inside a hidden, zero-dimension container would measure
  // garbage slide widths, so this is skipped entirely above the
  // breakpoint rather than initialized-then-hidden. Re-checked on resize
  // (same pattern Header.astro already uses for its mobile drawer) so a
  // desktop browser window shrunk below 1024px still gets a working
  // carousel without a full page reload; each root's own
  // `(el as any).swiper` guard below prevents ever double-initializing
  // once created.
  // Bug fixed here (same root cause and fix as NaturalOils.astro's
  // identical carousel script -- see that file's comment for the full
  // writeup): Astro's ClientRouter caches the outgoing page's live,
  // already-Swiper-mutated DOM for Back/Forward restores, then still
  // fires `astro:page-load` on it. The restored element is a new DOM
  // node, so the `(el as any).swiper` guard below doesn't catch it, and
  // a fresh Swiper instance ends up initializing on top of Swiper's own
  // prior output (loop-cloned slides, inline widths, transforms) instead
  // of clean markup -- producing the exact same collapsed/garbled slide
  // NaturalOils.astro showed after pressing Back. Tearing every instance
  // down on `astro:before-swap` (fired on the outgoing page right before
  // Astro swaps/caches it) restores clean markup before that snapshot is
  // taken, so the next init always starts fresh.
  let activeSwipers: InstanceType<typeof Swiper>[] = [];

  function initHealthGoalsSwipers() {
    if (window.matchMedia('(min-width: 1024px)').matches) return;

    const roots = document.querySelectorAll<HTMLElement>('[data-health-goals-root]');
    roots.forEach((root) => {
      const el = root.querySelector<HTMLElement>('[data-health-goals-swiper]');
      if (!el || (el as any).swiper) return;

      const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      const swiper = new Swiper(el, {
        modules: [Pagination, Navigation, Keyboard, A11y],
        loop: true,
        slidesPerView: 1.5,
        spaceBetween: 15,
        speed: prefersReducedMotion ? 0 : 450,
        grabCursor: true,
        touchEventsTarget: 'container',
        keyboard: { enabled: true, onlyInViewport: true },
        a11y: { enabled: true },
        pagination: {
          el: root.querySelector('.hg-pagination'),
          clickable: true,
        },
        navigation: {
          nextEl: root.querySelector('.hg-nav-next'),
          prevEl: root.querySelector('.hg-nav-prev'),
        },
        breakpoints: {
          640: { slidesPerView: 3, spaceBetween: 20 },
        },
      });
      activeSwipers.push(swiper);
    });
  }

  function destroyHealthGoalsSwipers() {
    activeSwipers.forEach((swiper) => {
      if (!swiper.destroyed) swiper.destroy(true, true);
    });
    activeSwipers = [];
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initHealthGoalsSwipers);
  } else {
    initHealthGoalsSwipers();
  }
  document.addEventListener('astro:page-load', initHealthGoalsSwipers);
  document.addEventListener('astro:before-swap', destroyHealthGoalsSwipers);
  window.addEventListener('resize', initHealthGoalsSwipers);
</script>
